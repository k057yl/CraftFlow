<Page x:Class="CraftFlow.Wpf.Pages.Sales.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_SALES}">

    <Border Style="{StaticResource PageRootBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <TextBlock Grid.Row="0"
                       Text="{loc:Loc Key=SALES_HEADER}"
                       Style="{StaticResource PageTitleTextStyle}"/>

            <TabControl Grid.Row="1" x:Name="SalesTabControl">
                <!-- Вкладка 1: Оформление заказа и Накладной -->
                <TabItem Header="{loc:Loc Key=TAB_SALES_SHIPMENT}">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Шапка заказа: Покупатель и Склад -->
                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="{StaticResource ColumnGap}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_SELECT_CUSTOMER}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <ComboBox x:Name="OrderCustomerComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Loc Key=LABEL_FINISHED_WAREHOUSE}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <ComboBox x:Name="OrderWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="OrderWarehouse_SelectionChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Основное тело: Партии склада vs Формируемая накладная -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="{StaticResource ColumnGap}"/>
                                <ColumnDefinition Width="1.35*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Слева: Доступные партии на складе -->
                            <GroupBox Grid.Column="0" Header="Выбор готовой продукции / партии на складе">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid Grid.Row="0"
                                              x:Name="AvailableLotsDataGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              SelectionMode="Single"
                                              RowDetailsVisibilityMode="VisibleWhenSelected"
                                              MouseDoubleClick="AvailableLotsDataGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:Loc Key=UI_COL_BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="*"/>
                                            <DataGridTextColumn Header="{loc:Loc Key=UI_COL_PRODUCT_NAME}" Binding="{Binding ProductName}" Width="*"/>
                                            <DataGridTextColumn Header="Мест / Ед." Binding="{Binding UnitsCount}" Width="75"/>
                                            <DataGridTextColumn Header="Остаток (кг/л)" Binding="{Binding Quantity, StringFormat={}{0:F2}}" Width="95"/>
                                            <DataGridTextColumn Header="Себест./ед." Binding="{Binding UnitPrice, StringFormat={}${0:F2}}" Width="80"/>
                                            <DataGridTemplateColumn Width="44">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="+"
                                                                ToolTip="Добавить всю партию целиком"
                                                                Click="AddLotButton_Click"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Height="22"
                                                                Width="26"
                                                                Padding="0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>

                                        <!-- Детализация поштучных SKU (головы сыра, банки/вёдра, кеги) -->
                                        <DataGrid.RowDetailsTemplate>
                                            <DataTemplate>
                                                <Border Margin="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource SubCardBorderStyle}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <StackPanel>
                                                        <TextBlock Text="Состав партии (выберите конкретные единицы / тару для отгрузки):"
                                                                   Style="{StaticResource FieldLabelTextStyle}"
                                                                   FontSize="11"
                                                                   Margin="0,0,0,6"/>
                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding ItemNumber}" FontWeight="SemiBold" Width="170" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding CurrentWeight, StringFormat={}{0:F2} кг}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Button Content="Добавить выбранные единицы"
                                                                Click="AddSelectedUnitsToInvoice_Click"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Height="{StaticResource ControlHeight}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,8,0,0"
                                                                Padding="12,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGrid.RowDetailsTemplate>
                                    </DataGrid>

                                    <TextBlock Grid.Row="1"
                                               Text="* Нажмите «+» или дважды кликните по строке, чтобы добавить всю партию целиком, либо раскройте строку для поштучного выбора."
                                               FontSize="11"
                                               Foreground="{DynamicResource AppForegroundBrush}"
                                               Opacity="0.65"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </Grid>
                            </GroupBox>

                            <!-- Справа: Позиции Накладной -->
                            <GroupBox Grid.Column="2" Header="{loc:Loc Key=GROUP_SALES_ORDER}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <DataGrid x:Name="InvoiceItemsDataGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="True"
                                                  CellEditEnding="InvoiceItemsDataGrid_CellEditEnding">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc Key=UI_COL_BATCH_NUMBER}" Binding="{Binding BatchNumber}" IsReadOnly="True" Width="*"/>
                                                <DataGridTextColumn Header="Отгрузить (кг)" Binding="{Binding Quantity, StringFormat={}{0:F2}}" IsReadOnly="True" Width="95"/>
                                                <DataGridTextColumn Header="Цена/ед. ($)" Binding="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                                <DataGridTextColumn Header="{loc:Loc Key=UI_COL_TOTAL_SUM}" Binding="{Binding TotalSum, StringFormat={}${0:F2}}" IsReadOnly="True" Width="95"/>
                                                <DataGridTemplateColumn Width="42">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="✕"
                                                                    ToolTip="Убрать из накладной"
                                                                    Click="RemoveInvoiceItem_Click"
                                                                    Tag="{Binding}"
                                                                    Style="{StaticResource DangerButtonStyle}"
                                                                    Width="22"
                                                                    Height="22"
                                                                    Padding="0"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Text="Накладная пуста — выберите партии со склада слева, чтобы сформировать отгрузку"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="16,24,16,0"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=InvoiceItemsDataGrid}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Итоговая сумма -->
                                    <Border Grid.Row="1" Style="{StaticResource SubCardBorderStyle}" Margin="0,12,0,12">
                                        <Grid>
                                            <TextBlock Text="{loc:Loc Key=LABEL_TOTAL_ORDER_SUM}"
                                                       Style="{StaticResource FieldLabelTextStyle}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TotalOrderSumTextBlock"
                                                       Text="$0.00"
                                                       FontWeight="Bold"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Кнопки действий -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="Очистить"
                                                Click="ClearInvoice_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="{StaticResource ButtonHeight}"
                                                Padding="14,0"/>

                                        <Button Grid.Column="2"
                                                x:Name="ShipOrderButton"
                                                Content="{loc:Loc Key=BTN_SHIP_ORDER}"
                                                Click="ShipOrder_Click"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="{StaticResource ButtonHeight}"
                                                IsEnabled="False"/>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Вкладка 2: Клиенты и Покупатели (в едином 2-колоночном стиле с Поставщиками) -->
                <TabItem Header="{loc:Loc Key=TAB_CUSTOMERS}">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="{StaticResource ColumnGap}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Слева: Форма нового покупателя -->
                        <GroupBox Grid.Column="0" Header="{loc:Loc Key=GROUP_REGISTER_CUSTOMER}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=LABEL_CUSTOMER_NAME}" Style="{StaticResource InputCaptionTextStyle}"/>
                                <TextBox x:Name="CustomerNameTextBox" Margin="{StaticResource FieldRowMargin}"/>

                                <TextBlock Text="{loc:Loc Key=LABEL_CUSTOMER_PHONE}" Style="{StaticResource InputCaptionTextStyle}"/>
                                <TextBox x:Name="CustomerPhoneTextBox" Margin="0,0,0,14"/>

                                <Button Content="{loc:Loc Key=BTN_CREATE_CUSTOMER}"
                                        Click="CreateCustomer_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="{StaticResource ButtonHeight}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Справа: Реестр покупателей -->
                        <GroupBox Grid.Column="2" Header="{loc:Loc Key=GROUP_ACTIVE_CUSTOMERS}">
                            <DataGrid x:Name="CustomersDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_CUSTOMER_NAME}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_CUSTOMER_PHONE}" Binding="{Binding Code}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="2"
                       Text="{loc:Loc Key=UI_STATUS_READY}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold"
                       Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Page>