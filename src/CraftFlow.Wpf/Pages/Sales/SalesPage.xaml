<Page x:Class="CraftFlow.Wpf.Pages.Sales.SalesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:auth="clr-namespace:CraftFlow.Wpf.MarkupExtensions"
      Title="{loc:Loc Key=TITLE_SALES}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=SALES_HEADER}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1" x:Name="SalesTabControl">
            <!-- Вкладка 1: Оформление заказа и Накладной -->
            <TabItem Header="{loc:Loc Key=TAB_SALES_SHIPMENT}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Шапка заказа: Покупатель и Склад -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Key=LABEL_SELECT_CUSTOMER}" Margin="0,0,0,3" FontSize="11" Foreground="#475569" FontWeight="Bold"/>
                                <ComboBox x:Name="OrderCustomerComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Key=LABEL_FINISHED_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569" FontWeight="Bold"/>
                                <ComboBox x:Name="OrderWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4" SelectionChanged="OrderWarehouse_SelectionChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Основное тело: Партии склада vs Формируемая накладная -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Слева: Доступные партии на складе -->
                        <GroupBox Grid.Column="0" Header="Выбор готовой продукции / партии на складе">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" x:Name="AvailableLotsDataGrid" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True" 
                                          SelectionMode="Single"
                                          RowDetailsVisibilityMode="VisibleWhenSelected"
                                          MouseDoubleClick="AvailableLotsDataGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_PRODUCT_NAME}" Binding="{Binding ProductName}" Width="*"/>
                                        <DataGridTextColumn Header="Мест / Ед." Binding="{Binding UnitsCount}" Width="70"/>
                                        <DataGridTextColumn Header="Остаток (кг/л)" Binding="{Binding Quantity, StringFormat={}{0:F2}}" Width="90"/>
                                        <DataGridTextColumn Header="Себест./ед." Binding="{Binding UnitPrice, StringFormat={}${0:F2}}" Width="75"/>
                                        <DataGridTemplateColumn Width="42">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="+"
                                                            ToolTip="Добавить всю партию целиком"
                                                            Click="AddLotButton_Click"
                                                            Tag="{Binding}"
                                                            Height="22"
                                                            FontWeight="Bold"
                                                            Background="#0284C7"
                                                            Foreground="White"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>

                                    <!-- Детализация поштучных SKU (головы сыра, банки/вёдра, кеги) -->
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8" Margin="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel>
                                                    <TextBlock Text="Состав партии (выберите конкретные единицы / тару для отгрузки):" FontWeight="Bold" FontSize="11" Margin="0,0,0,5" Foreground="#334155"/>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding ItemNumber}" FontWeight="SemiBold" Width="170" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding CurrentWeight, StringFormat={}{0:F2} кг}" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="Добавить выбранные единицы" 
                                                            Click="AddSelectedUnitsToInvoice_Click" 
                                                            Tag="{Binding}" 
                                                            Margin="0,8,0,0" 
                                                            Height="25" 
                                                            FontSize="11" 
                                                            Background="#0284C7" 
                                                            Foreground="White"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                </DataGrid>

                                <TextBlock Grid.Row="1" 
                                           Text="* Нажмите «+» для добавления всей партии целиком, либо кликните по строке и отметьте нужные единицы." 
                                           FontSize="10" 
                                           Foreground="#64748B" 
                                           Margin="0,5,0,0" 
                                           FontStyle="Italic"/>
                            </Grid>
                        </GroupBox>

                        <!-- Справа: Позиции Накладной -->
                        <GroupBox Grid.Column="2" Header="{loc:Loc Key=GROUP_SALES_ORDER}">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" x:Name="InvoiceItemsDataGrid" 
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="True"
                                          CellEditEnding="InvoiceItemsDataGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_BATCH_NUMBER}" Binding="{Binding BatchNumber}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Отгрузить (кг)" Binding="{Binding Quantity, StringFormat={}{0:F2}}" IsReadOnly="True" Width="90"/>
                                        <DataGridTextColumn Header="Цена/ед. ($)" Binding="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_TOTAL_SUM}" Binding="{Binding TotalSum, StringFormat={}{0:F2}}" IsReadOnly="True" Width="85"/>
                                        <DataGridTemplateColumn Width="34">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕"
                                                            ToolTip="Убрать из накладной"
                                                            Click="RemoveInvoiceItem_Click"
                                                            Tag="{Binding}"
                                                            Height="22"
                                                            FontSize="11"
                                                            Background="#EF4444"
                                                            Foreground="White"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Итоговая сумма -->
                                <Border Grid.Row="1" Background="#F1F5F9" Padding="10" Margin="0,10,0,10" CornerRadius="4">
                                    <Grid>
                                        <TextBlock Text="{loc:Loc Key=LABEL_TOTAL_ORDER_SUM}" Foreground="#475569" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TotalOrderSumTextBlock" Text="$0.00" FontWeight="Bold" FontSize="18" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Button Grid.Row="2" Content="{loc:Loc Key=BTN_SHIP_ORDER}" 
                                        Click="ShipOrder_Click" 
                                        Height="38" 
                                        FontWeight="Bold" 
                                        Background="#0284C7" 
                                        Foreground="White"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Клиенты и Покупатели -->
            <TabItem Header="{loc:Loc Key=TAB_CUSTOMERS}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel MaxWidth="920" HorizontalAlignment="Left" Width="920">
                        <GroupBox Header="{loc:Loc Key=GROUP_REGISTER_CUSTOMER}" Padding="12" Margin="0,0,0,15" MaxWidth="600" HorizontalAlignment="Left" Width="600">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:Loc Key=LABEL_CUSTOMER_NAME}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="CustomerNameTextBox" Text="Ресторан Густо" Padding="5,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc Key=LABEL_CUSTOMER_PHONE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="CustomerPhoneTextBox" Text="+380991112233" Padding="5,4"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="{loc:Loc Key=BTN_CREATE_CUSTOMER}" 
                                        Click="CreateCustomer_Click" 
                                        Height="32" 
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:Loc Key=GROUP_ACTIVE_CUSTOMERS}" Padding="10">
                            <ListBox x:Name="CustomersListBox" DisplayMemberPath="Name" BorderThickness="0" MinHeight="150" MaxHeight="300"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=UI_STATUS_READY}" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>