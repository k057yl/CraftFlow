<UserControl x:Class="CraftFlow.Wpf.Pages.CheeseMaking.Controls.AgingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization">
    <Border Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ВЕРХНЯЯ ЧАСТЬ: 40% / 60% -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Перемещение на созревание -->
                <GroupBox Grid.Column="0" Header="{loc:Loc Key=UI_AGING_GROUP_TRANSFER}" Margin="0,0,6,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_COMPLETED_BATCH}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <ComboBox x:Name="CompletedBatchesComboBox" 
                                  DisplayMemberPath="Name" 
                                  SelectedValuePath="Id" 
                                  Height="26" 
                                  Margin="0,0,0,8"
                                  SelectionChanged="CompletedBatchesComboBox_SelectionChanged"/>

                        <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_CHAMBER}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <ComboBox x:Name="AgingChambersComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" Margin="0,0,0,8"/>

                        <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_LOT_NAME}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <TextBox x:Name="AgingLotNameTextBox" Padding="4,2" Height="26" Margin="0,0,0,8"/>

                        <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_MIN_DAYS}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <TextBox x:Name="MinAgingDaysTextBox" Text="30" Padding="4,2" Height="26" Margin="0,0,0,12"/>

                        <Button Content="{loc:Loc Key=UI_AGING_BTN_TRANSFER}" 
                                Click="TransferToAging_Click" 
                                Height="28" 
                                HorizontalAlignment="Left"
                                Padding="16,0"
                                Style="{StaticResource SuccessButtonStyle}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Текущие партии в камерах созревания -->
                <GroupBox Grid.Column="1" Header="{loc:Loc Key=UI_AGING_GROUP_ACTIVE_LOTS}" Margin="6,0,0,0" Padding="8">
                    <DataGrid x:Name="AgingLotsDataGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionChanged="AgingLotsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=UI_AGING_COL_LOT_BATCH}" Binding="{Binding BatchNumber}" Width="1.5*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=UI_AGING_COL_CHAMBER}" Binding="{Binding ChamberName}" Width="1*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=UI_AGING_COL_CURRENT_STOCK}" Binding="{Binding InitialQuantity, StringFormat={}{0:N2}}" Width="1*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=UI_AGING_COL_UNITS_COUNT}" Binding="{Binding UnitsCount}" Width="0.8*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=UI_AGING_COL_DAYS_IN_CHAMBER}" Binding="{Binding DaysInChamber}" Width="0.8*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=UI_AGING_COL_TARGET_DAYS}" Binding="{Binding TargetDays}" Width="0.8*"/>
                            <DataGridCheckBoxColumn Header="{loc:Loc Key=UI_AGING_COL_IS_READY}" Binding="{Binding IsReadyForRelease}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- 3. НИЖНЯЯ ЧАСТЬ: Извлечение из камеры созревания -->
            <GroupBox Grid.Row="1" Header="{loc:Loc Key=UI_AGING_GROUP_RELEASE}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Выбор лота, маркировки и склада -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_ACTIVE_LOT}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="ActiveAgingLotsComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" SelectionChanged="ActiveAgingLotsComboBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_TARGET_WAREHOUSE}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="TargetWarehousesComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" SelectionChanged="TargetWarehousesComboBox_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_RELEASE_LOT_NAME}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <TextBox x:Name="ReleaseLotNameTextBox" Padding="4,2" Height="26"/>
                    </StackPanel>

                    <!-- Ячейки хранения -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_TARGET_LOCATIONS}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,2"/>
                        <ListBox x:Name="TargetStorageLocationsListBox" Height="74" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SelectionMode="Multiple">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_FREE_CAPACITY_PREFIX}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBlock Text="{Binding FreeCapacityDisplay}" Foreground="#16A34A" FontWeight="Bold"/>
                                        <TextBlock Text="{loc:Loc Key=UI_AGING_LABEL_FREE_CAPACITY_SUFFIX}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Кнопка открытия окна взвешивания -->
                    <Button Grid.Column="4"
                            Content="{loc:Loc Key=UI_AGING_BTN_RELEASE}" 
                            Click="ReleaseFromAging_Click" 
                            Height="34" 
                            VerticalAlignment="Bottom"
                            Padding="18,0"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>