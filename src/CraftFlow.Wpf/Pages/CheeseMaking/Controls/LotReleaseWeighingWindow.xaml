<Window x:Class="CraftFlow.Wpf.Pages.CheeseMaking.Controls.LotReleaseWeighingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
        Title="{loc:Loc Key=UI_WEIGH_WIN_TITLE}"
        Height="660" Width="1040"
        MinHeight="600" MinWidth="940"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Border Style="{StaticResource PageRootBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. ШАПКА -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource PillBadgeBorderStyle}" Background="#16A34A" Margin="0,0,8,0">
                                <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_BADGE}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                            <Border Style="{StaticResource SubCardBorderStyle}" Padding="8,2">
                                <TextBlock x:Name="ChamberInfoTextBlock"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="LotNameTextBlock"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource SubCardBorderStyle}" Padding="10,8" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_HINT_TITLE}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_HINT_LINE1}" FontSize="11" Opacity="0.75"/>
                            <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_HINT_LINE2}" FontSize="11" Opacity="0.75"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. ОСНОВНАЯ ЧАСТЬ: ТАБЛИЦА + СВОДКА -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="{StaticResource HalfColumnGap}"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Левая карточка: Таблица поштучного взвешивания -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderLastStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_GRID_TITLE}"
                                       Style="{StaticResource CardTitleTextStyle}"
                                       Margin="0"/>
                            <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_GRID_SUBTITLE}"
                                       FontSize="11"
                                       Opacity="0.7"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  x:Name="ItemsDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  RowHeight="34"
                                  CellEditEnding="ItemsDataGrid_CellEditEnding">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiscarded}" Value="True">
                                            <Setter Property="Background" Value="#25DC2626"/>
                                            <Setter Property="Opacity" Value="0.65"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=UI_WEIGH_WIN_COL_ITEM_CODE}"
                                                    Binding="{Binding ItemCode}"
                                                    IsReadOnly="True"
                                                    Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding ItemCode}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="{loc:Loc Key=UI_WEIGH_WIN_COL_INITIAL_WEIGHT}"
                                                    Binding="{Binding InitialWeight, StringFormat={}{0:N3}}"
                                                    IsReadOnly="True"
                                                    Width="105">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Opacity" Value="0.75"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="{loc:Loc Key=UI_WEIGH_WIN_COL_FINAL_WEIGHT}"
                                                    Binding="{Binding Weight, StringFormat={}{0:N3}, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="135">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Height" Value="24"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="{loc:Loc Key=UI_WEIGH_WIN_COL_SHRINKAGE}"
                                                    Binding="{Binding ShrinkagePercentText}"
                                                    IsReadOnly="True"
                                                    Width="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#D97706"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridCheckBoxColumn Header="{loc:Loc Key=UI_WEIGH_WIN_COL_DISCARDED}"
                                                        Binding="{Binding IsDiscarded, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="68">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <EventSetter Event="Click" Handler="CheckBox_Click"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Правая колонка: Сводка прихода и цена -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_SUMMARY_TITLE}" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,10"/>

                            <Border Style="{StaticResource SubCardBorderStyle}" BorderBrush="#16A34A" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_LABEL_VALID_WEIGHT}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <TextBlock x:Name="TotalWeightTextBlock" Text="0.000" FontSize="22" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="TotalShrinkageTextBlock" FontSize="11" FontWeight="SemiBold" Foreground="#D97706"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_LABEL_VALID_UNITS}" FontSize="12" Opacity="0.75"/>
                                <TextBlock x:Name="TotalUnitsTextBlock" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_LABEL_INITIAL_TOTAL}" FontSize="12" Opacity="0.75"/>
                                <TextBlock x:Name="InitialTotalWeightTextBlock" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,6,0,8"/>

                            <Grid>
                                <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_LABEL_UNIT_COST}" FontSize="12" Opacity="0.75" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CalculatedCostTextBlock" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Карточка параметров выпуска -->
                    <Border Style="{StaticResource CardBorderLastStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_RELEASE_PARAMS_TITLE}" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,10"/>

                            <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_LABEL_SELLING_PRICE}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <TextBox x:Name="UnitPriceTextBox" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="{loc:Loc Key=UI_COMMON_LABEL_EXPIRATION_DATE}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <DatePicker x:Name="ExpirationDatePicker" Height="{StaticResource ControlHeight}" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="{loc:Loc Key=UI_COMMON_BTN_ADD_14_DAYS}" Click="AddDays_Click" Tag="14" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0" FontSize="11"/>
                                <Button Content="{loc:Loc Key=UI_COMMON_BTN_ADD_30_DAYS}" Click="AddDays_Click" Tag="30" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0" FontSize="11"/>
                                <Button Content="{loc:Loc Key=UI_COMMON_BTN_ADD_90_DAYS}" Click="AddDays_Click" Tag="90" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0" FontSize="11"/>
                                <Button Content="{loc:Loc Key=UI_COMMON_BTN_CLEAR}" Click="ClearDate_Click" Style="{StaticResource DangerButtonStyle}" Padding="6,2" FontSize="11"/>
                            </StackPanel>

                            <CheckBox x:Name="AutoPrintCheckBox"
                                      Content="{loc:Loc Key=UI_WEIGH_WIN_CHECK_PRINT_LABELS}"
                                      IsChecked="True"
                                      FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 3. ПОДВАЛ -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderLastStyle}" Margin="0,14,0,0" Padding="12">
                <DockPanel>
                    <TextBlock Text="{loc:Loc Key=UI_WEIGH_WIN_FOOTER_NOTE}"
                               FontSize="12"
                               Opacity="0.75"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc Key=UI_BTN_CANCEL}"
                                Click="Cancel_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Height="{StaticResource ButtonHeight}"
                                Margin="0,0,10,0"/>

                        <Button Content="{loc:Loc Key=UI_WEIGH_WIN_BTN_CONFIRM}"
                                Click="Confirm_Click"
                                Style="{StaticResource SuccessButtonStyle}"
                                Width="220"
                                Height="{StaticResource ButtonHeight}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>