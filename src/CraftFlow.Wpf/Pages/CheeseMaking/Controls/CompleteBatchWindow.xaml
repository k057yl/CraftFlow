<Window x:Class="CraftFlow.Wpf.Pages.CheeseMaking.Controls.CompleteBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
        Title="{loc:Loc Key=UI_COMPLETE_WIN_TITLE}"
        Height="640" Width="960"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">

    <Border Style="{StaticResource PageRootBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. ШАПКА -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource PillBadgeBorderStyle}" Margin="0,0,8,0">
                                <TextBlock Text="{loc:Loc Key=UI_COMPLETE_WIN_BADGE}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                            <Border Style="{StaticResource SubCardBorderStyle}" Padding="8,2">
                                <TextBlock x:Name="PlannedInfoTextBlock"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="RecipeTitleTextBlock"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppForegroundBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key=UI_BREWHOUSE_LABEL_COMPLETE_BATCH_NAME}" Style="{StaticResource InputCaptionTextStyle}" FontWeight="SemiBold"/>
                        <TextBox x:Name="BatchNumberTextBox" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. ОСНОВНАЯ ЧАСТЬ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="{StaticResource HalfColumnGap}"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Левая карточка: Поштучное взвешивание -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderLastStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{loc:Loc Key=UI_COMPLETE_WIN_GRID_TITLE}"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   Margin="0,0,0,10"/>

                        <!-- Быстрое управление количеством и общим весом -->
                        <Border Grid.Row="1" Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,10" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="{StaticResource HalfColumnGap}"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="{StaticResource HalfColumnGap}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc Key=UI_COMPLETE_WIN_LABEL_UNITS_COUNT}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <TextBox x:Name="UnitsCountTextBox"
                                             Text="1"
                                             FontWeight="SemiBold"
                                             TextChanged="UnitsCountTextBox_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Loc Key=UI_COMPLETE_WIN_LABEL_TOTAL_WEIGHT}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <TextBox x:Name="TotalWeightInputTextBox" FontWeight="SemiBold"/>
                                </StackPanel>

                                <Button Grid.Column="4"
                                        Content="{loc:Loc Key=UI_COMPLETE_WIN_BTN_DISTRIBUTE_EVENLY}"
                                        Click="DistributeEvenly_Click"
                                        Height="{StaticResource ControlHeight}"
                                        VerticalAlignment="Bottom"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  x:Name="HeadsDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  CellEditEnding="HeadsDataGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=UI_COMPLETE_WIN_COL_UNIT_CODE}"
                                                    Binding="{Binding ItemCode}"
                                                    IsReadOnly="True"
                                                    Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="{loc:Loc Key=UI_COMPLETE_WIN_COL_WEIGHT}"
                                                    Binding="{Binding Weight, StringFormat={}{0:N3}, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Height" Value="24"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Правая колонка: Себестоимость и срок годности -->
                <StackPanel Grid.Column="2">
                    <!-- Карточка себестоимости -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=UI_COMPLETE_WIN_COST_TITLE}" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,10"/>

                            <Border Style="{StaticResource SubCardBorderStyle}" BorderBrush="#16A34A" Margin="0,0,0,10" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=UI_COMPLETE_WIN_LABEL_FINAL_TOTAL_WEIGHT}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <TextBlock x:Name="TotalWeightTextBlock" Text="0.000" FontSize="22" FontWeight="Bold" Foreground="#16A34A"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="UseOverheadCheckBox"
                                          Grid.Column="0"
                                          Content="{loc:Loc Key=UI_BREWHOUSE_CHECKBOX_OVERHEAD}"
                                          VerticalAlignment="Center"
                                          Click="CostInputs_Changed"/>
                                <TextBox x:Name="OverheadPercentageTextBox"
                                         Grid.Column="1"
                                         Text="15"
                                         Height="24"
                                         HorizontalContentAlignment="Right"
                                         IsEnabled="{Binding IsChecked, ElementName=UseOverheadCheckBox}"
                                         TextChanged="CostInputs_Changed"/>
                                <TextBlock Grid.Column="2" Text="%" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{loc:Loc Key=UI_BREWHOUSE_LABEL_RAW_COST}" FontSize="12" Opacity="0.75"/>
                                <TextBlock x:Name="RawCostTextBlock" Text="$ 0.00" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc Key=UI_BREWHOUSE_LABEL_OVERHEAD_COST}" FontSize="12" Opacity="0.75"/>
                                <TextBlock x:Name="OverheadCostTextBlock" Text="+$ 0.00" FontSize="12" FontWeight="SemiBold" Foreground="#D97706" HorizontalAlignment="Right"/>
                            </Grid>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,4,0,8"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{loc:Loc Key=UI_BREWHOUSE_LABEL_TOTAL_COST}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="TotalCostTextBlock" Text="$ 0.00" FontSize="13" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid>
                                <TextBlock Text="{loc:Loc Key=UI_BREWHOUSE_LABEL_UNIT_COST}" FontSize="12" Opacity="0.75"/>
                                <TextBlock x:Name="UnitCostTextBlock" Text="$ 0.00" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Карточка срока годности -->
                    <Border Style="{StaticResource CardBorderLastStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=UI_COMPLETE_WIN_EXPIRATION_TITLE}" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Key=UI_COMPLETE_WIN_EXPIRATION_SUBTITLE}"
                                       Style="{StaticResource CardSubtitleTextStyle}"
                                       Margin="0,0,0,8"/>

                            <DatePicker x:Name="ExpirationDatePicker"
                                        Height="{StaticResource ControlHeight}"
                                        Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Loc Key=UI_COMMON_BTN_ADD_7_DAYS}" Click="AddDays_Click" Tag="7" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0" FontSize="11"/>
                                <Button Content="{loc:Loc Key=UI_COMMON_BTN_ADD_14_DAYS}" Click="AddDays_Click" Tag="14" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0" FontSize="11"/>
                                <Button Content="{loc:Loc Key=UI_COMMON_BTN_ADD_30_DAYS}" Click="AddDays_Click" Tag="30" Style="{StaticResource SecondaryButtonStyle}" Padding="8,2" Margin="0,0,4,0" FontSize="11"/>
                                <Button Content="{loc:Loc Key=UI_COMMON_BTN_CLEAR}" Click="ClearDate_Click" Style="{StaticResource DangerButtonStyle}" Padding="6,2" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 3. ПОДВАЛ -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderLastStyle}" Margin="0,14,0,0" Padding="12">
                <DockPanel>
                    <TextBlock Text="{loc:Loc Key=UI_COMPLETE_WIN_FOOTER_NOTE}"
                               FontSize="12"
                               Opacity="0.75"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc Key=UI_BTN_CANCEL}"
                                Click="Cancel_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Height="{StaticResource ButtonHeight}"
                                Margin="0,0,10,0"/>

                        <Button Content="{loc:Loc Key=UI_COMPLETE_WIN_BTN_CONFIRM}"
                                Click="Confirm_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="190"
                                Height="{StaticResource ButtonHeight}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>