<Page x:Class="CraftFlow.Wpf.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="ProfilePage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="30">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                <TextBlock Text="Управление аккаунтом и организацией" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,20"/>

                <!-- Карточка текущего пользователя -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Данные профиля" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Имя:" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" x:Name="NameTextBlock" Text="-" Foreground="{DynamicResource AppForegroundBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Email:" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" x:Name="EmailTextBlock" Text="-" Foreground="{DynamicResource AppForegroundBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Роль в системе:" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" x:Name="RoleTextBlock" Text="-" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Блок управления API-ключами устройства/терминалов -->
                <Border x:Name="TenantKeysBorder" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="API Ключи терминалов (Тенант)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OtpInputTextBox" Height="32" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="Активировать ключ" Click="ActivateOtp_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="15,0"/>
                        </Grid>

                        <DataGrid x:Name="MyKeysDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID Ключа" Binding="{Binding Id}" Width="200"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAtUtc}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Опасная зона (Danger Zone) -->
                <Border x:Name="DangerZoneBorder" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Опасная зона / Управление подпиской и аккаунтом" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,12"/>

                        <TextBlock Text="Вам доступны 2 варианта прекращения работы с сервисом:" 
                                   Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <StackPanel Margin="10,0,0,15">
                            <TextBlock Text="• Заморозка (Деактивация): Остановка доступа к системе. Данные сохраняются. Раз в 6 месяцев приходит предупреждение, а полный снос происходит автоматически через 2 года неуведомленной неактивности." 
                                       Foreground="{DynamicResource AppForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12"/>

                            <TextBlock Text="• Полное удаление: Моментальное физическое уничтожение всех складов, рецептов, историй партий и данных сыроварни из базы данных без возможности восстановления." 
                                       Foreground="#DC2626" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>

                        <Button Content="Управление выходом из системы" 
                                Click="DeleteAccount_Click" 
                                Background="#DC2626" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                Height="36" 
                                HorizontalAlignment="Left" 
                                Padding="20,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusTextBlock" Margin="0,15,0,0" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>