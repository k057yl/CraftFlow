<Page x:Class="CraftFlow.Wpf.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:auth="clr-namespace:CraftFlow.Wpf.MarkupExtensions"
      Title="{loc:Loc Key=UI_TITLE_PROFILE_PAGE}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок страницы -->
                <TextBlock Grid.Row="0" Text="{loc:Loc Key=UI_TITLE_PROFILE_PAGE}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,20"/>

                <!-- Главная двухколоночная сетка (ЗОНА A и ЗОНА B) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <!-- Разделитель -->
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ========================================== -->
                    <!-- ЗОНА A: Профиль, Команда и Удаление (Слева) -->
                    <!-- ========================================== -->
                    <StackPanel Grid.Column="0">

                        <!-- 1. Данные профиля -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=UI_HEADER_PROFILE_DATA}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Key=UI_LABEL_NAME}" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="NameTextBlock" Text="-" Foreground="{DynamicResource AppForegroundBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Key=UI_LABEL_EMAIL}" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="EmailTextBlock" Text="-" Foreground="{DynamicResource AppForegroundBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Key=UI_LABEL_SYSTEM_ROLE}" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="RoleTextBlock" Text="-" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Управление сотрудниками организации -->
                        <Border x:Name="TeamManagementBorder" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20" Visibility="{auth:HasPermission Permission=USERS_MANAGE}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=UI_HEADER_TEAM_MANAGEMENT}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15"/>

                                <WrapPanel Margin="0,0,0,15" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,10,5">
                                        <TextBlock Text="{loc:Loc Key=UI_LABEL_FULL_NAME}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBox x:Name="NewUserFullNameTextBox" Width="130" Height="28"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,5">
                                        <TextBlock Text="{loc:Loc Key=UI_LABEL_EMAIL}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBox x:Name="NewUserEmailTextBox" Width="130" Height="28"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,5">
                                        <TextBlock Text="{loc:Loc Key=UI_LABEL_PASSWORD}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <PasswordBox x:Name="NewUserPasswordBox" Width="100" Height="28"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,10,5">
                                        <TextBlock Text="{loc:Loc Key=UI_LABEL_ROLE}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <ComboBox x:Name="NewUserRoleComboBox" Width="120" Height="28"/>
                                    </StackPanel>

                                    <Button Content="{loc:Loc Key=UI_BTN_ADD_EMPLOYEE}" Click="CreateTeamUser_Click" Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="12,0" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                </WrapPanel>

                                <TextBlock Text="{loc:Loc Key=UI_HEADER_EMPLOYEES_LIST}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,5,0,8"/>
                                <DataGrid x:Name="TeamUsersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_FULL_NAME}" Binding="{Binding FullName}" Width="130"/>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_EMAIL}" Binding="{Binding Email}" Width="140"/>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_ROLE}" Binding="{Binding RoleDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_STATUS}" Binding="{Binding StatusDisplay}" Width="80"/>

                                        <DataGridTemplateColumn Header="{loc:Loc Key=UI_COL_ACTIONS}" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding ActionButtonText}" 
                                                            Click="ToggleUserStatus_Click" 
                                                            Tag="{Binding Id}"
                                                            IsEnabled="{Binding CanToggle}"
                                                            Height="22" Padding="6,0" FontSize="10" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Опасная зона -->
                        <Border x:Name="DangerZoneBorder" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=UI_HEADER_DANGER_ZONE}" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,10"/>
                                <TextBlock Text="{loc:Loc Key=UI_LABEL_EXIT_OPTIONS_INFO}" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="12"/>

                                <StackPanel Margin="5,0,0,12">
                                    <TextBlock Text="{loc:Loc Key=UI_INFO_DEACTIVATION_OPTION}" Foreground="{DynamicResource AppForegroundBrush}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="11"/>
                                    <TextBlock Text="{loc:Loc Key=UI_INFO_DELETE_OPTION}" Foreground="#DC2626" TextWrapping="Wrap" FontSize="11"/>
                                </StackPanel>

                                <Button Content="{loc:Loc Key=UI_BTN_MANAGE_EXIT}" 
                                        Click="DeleteAccount_Click" 
                                        Background="#DC2626" 
                                        Foreground="White" 
                                        FontWeight="Bold" 
                                        Height="32" 
                                        HorizontalAlignment="Left" 
                                        Padding="16,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========================================== -->
                    <!-- ЗОНА B: Финансы, Подписки и Аддоны (Справа)-->
                    <!-- ========================================== -->
                    <StackPanel Grid.Column="2">

                        <!-- 1. Состояние текущей подписки -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="💳 Текущий тариф и подписка" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <Border HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" CornerRadius="12" Padding="10,3">
                                        <TextBlock x:Name="SubscriptionStatusBadge" Text="ТРИАЛ" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Активный план:" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="CurrentPlanTitleText" Text="Загрузка..." Foreground="{DynamicResource AppForegroundBrush}" FontWeight="Bold"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Срок действия до:" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="SubscriptionExpiresText" Text="-" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Подключение Аддонов (Запрос на оплату) -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="🧩 Дополнительные цеха (Аддоны)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Для подключения дополнительных цехов сформируйте заявку или свяжитесь с отделом продаж." FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🍺 Варочный цех: Пивоварение" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBlock Text="Модуль рецептур сусла, варок и созревания пива" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Запросить счет" Click="RequestAddonInvoice_Click" Tag="BEER_STARTER" Height="26" Padding="12,0"/>
                                </Grid>

                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🥩 Мясной цех: Сыровяление и Бастурма" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBlock Text="Модуль засола, сушки, усушки и созревания мяса" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Запросить счет" Click="RequestAddonInvoice_Click" Tag="MEAT_STARTER" Height="26" Padding="12,0"/>
                                </Grid>

                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,5,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🫙 Цех Ферментации и Солений" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBlock Text="Модуль квашения, кимчи, соусов и выдержки" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Запросить счет" Click="RequestAddonInvoice_Click" Tag="FERMENTATION_STARTER" Height="26" Padding="12,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Таблица финансовых транзакций -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="📜 История платежей и операций" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="PaymentsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="140">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                                        <DataGridTextColumn Header="Тариф/Модуль" Binding="{Binding PlanCode}" Width="130"/>
                                        <DataGridTextColumn Header="Дней" Binding="{Binding DaysAdded}" Width="60"/>
                                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</Page>