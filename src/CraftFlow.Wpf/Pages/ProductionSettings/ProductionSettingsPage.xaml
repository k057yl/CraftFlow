<Page x:Class="CraftFlow.Wpf.Pages.ProductionSettings.ProductionSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:ctrl="clr-namespace:CraftFlow.Wpf.Pages.ProductionSettings.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="{loc:Loc Key=UI_SETTINGS_TITLE}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <TextBlock Text="{loc:Loc Key=UI_SETTINGS_HEADER}" 
                   FontSize="22" FontWeight="Bold" 
                   Foreground="{DynamicResource AppForegroundBrush}" 
                   Margin="0,0,0,16"/>

        <!-- 2 Основные Вкладки -->
        <TabControl Grid.Row="1">
            <TabItem Header="{loc:Loc Key=UI_SETTINGS_TAB_TECHNOLOGY}">
                <ctrl:RecipesControl x:Name="RecipesView" StatusUpdated="OnStatusUpdated"/>
            </TabItem>
            <TabItem Header="{loc:Loc Key=UI_SETTINGS_TAB_INFRASTRUCTURE}">
                <ctrl:StorageControl x:Name="StorageView" StatusUpdated="OnStatusUpdated"/>
            </TabItem>
        </TabControl>

        <!-- Общий StatusBlock снизу -->
        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" 
                   Text="{loc:Loc Key=UI_STATUS_READY}" 
                   Foreground="{DynamicResource AccentBrush}" 
                   FontWeight="SemiBold" Margin="0,12,0,0"/>
    </Grid>
</Page>