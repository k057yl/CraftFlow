<UserControl x:Class="CraftFlow.Wpf.Pages.ProductionSettings.Controls.RecipesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization">

    <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="{StaticResource ColumnGap}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Левая колонка: Сырьё и Ингредиенты -->
        <GroupBox Grid.Column="0" Header="{loc:Loc Key=UI_RECIPES_HEADER_RAW_MATERIALS}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_RAW_NAME}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="RawMaterialNameTextBox" Margin="{StaticResource FieldRowMargin}"/>

                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_SELECT_UOM}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <ComboBox x:Name="RawUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,12"/>

                    <Button Content="{loc:Loc Key=UI_RECIPES_BTN_CREATE_RAW}"
                            Click="CreateRawMaterial_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="{StaticResource ControlHeight}"/>
                </StackPanel>

                <CheckBox x:Name="ShowArchivedRawCheckBox"
                          Grid.Row="1"
                          Content="{loc:Loc Key=UI_RECIPES_CHECKBOX_SHOW_ARCHIVED}"
                          Margin="{StaticResource FieldRowMargin}"
                          Checked="ShowArchived_Changed"
                          Unchecked="ShowArchived_Changed"/>

                <DataGrid Grid.Row="2" x:Name="RawMaterialsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=UI_RECIPES_LABEL_RAW_NAME}" Binding="{Binding Name}" Width="*"/>
                        <DataGridTemplateColumn x:Name="RawMaterialDeleteColumn" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="OpenRawMaterialMenu_Click" Tag="{Binding}" Style="{StaticResource ActionButtonStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 2. Правая колонка: Технологические Рецепты -->
        <GroupBox Grid.Column="2" Header="{loc:Loc Key=UI_RECIPES_HEADER_RECIPES_LIST}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель действий (зеркально кнопке "Добавить оборудование" в StorageControl) -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{loc:Loc Key=UI_RECIPES_HEADER_NEW_RECIPE}"
                            Click="OpenCreateRecipeModal_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="{StaticResource ButtonHeight}"
                            Padding="16,0"
                            VerticalAlignment="Center"/>

                    <CheckBox x:Name="ShowArchivedRecipesCheckBox"
                              Grid.Column="2"
                              Content="{loc:Loc Key=UI_RECIPES_CHECKBOX_SHOW_ARCHIVED}"
                              VerticalAlignment="Center"
                              Checked="ShowArchived_Changed"
                              Unchecked="ShowArchived_Changed"/>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="RecipesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Loc Key=UI_RECIPES_LABEL_RECIPE_NAME}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" Margin="5,0">
                                        <Hyperlink Click="OpenRecipeDetails_Click" Foreground="{DynamicResource AccentBrush}">
                                            <Run Text="{Binding Name}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{loc:Loc Key=UI_RECIPES_COL_MODULE}" Binding="{Binding TargetModule}" Width="160"/>

                        <DataGridTemplateColumn x:Name="RecipeDeleteColumn" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="OpenRecipeMenu_Click" Tag="{Binding}" Style="{StaticResource ActionButtonStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>