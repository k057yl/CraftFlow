<UserControl x:Class="CraftFlow.Wpf.Pages.ProductionSettings.Controls.RecipesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
             xmlns:conv="clr-namespace:CraftFlow.Wpf.Services.Converters">

    <UserControl.Resources>
        <conv:UnitValueConverter x:Key="UnitValueConverter"/>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Ингредиенты и Сырьё -->
        <GroupBox Grid.Column="0" Header="{loc:Loc Key=UI_RECIPES_HEADER_RAW_MATERIALS}" Margin="0,0,10,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_RAW_NAME}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="RawMaterialNameTextBox" Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_SELECT_UOM}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <ComboBox x:Name="RawUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,12"/>

                    <Button Content="{loc:Loc Key=UI_RECIPES_BTN_CREATE_RAW}" Click="CreateRawMaterial_Click" Style="{StaticResource PrimaryButtonStyle}" Height="30"/>
                </StackPanel>

                <CheckBox x:Name="ShowArchivedRawCheckBox"
                          Grid.Row="1"
                          Content="{loc:Loc Key=UI_RECIPES_CHECKBOX_SHOW_ARCHIVED}"
                          Margin="0,0,0,8"
                          Checked="ShowArchived_Changed"
                          Unchecked="ShowArchived_Changed"/>

                <DataGrid Grid.Row="2" x:Name="RawMaterialsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=UI_RECIPES_LABEL_RAW_NAME}" Binding="{Binding Name}" Width="*"/>
                        <DataGridTemplateColumn x:Name="RawMaterialDeleteColumn" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="OpenRawMaterialMenu_Click" Tag="{Binding}" Style="{StaticResource ActionButtonStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 2. Конструктор рецепта -->
        <GroupBox Grid.Column="1" Header="{loc:Loc Key=UI_RECIPES_HEADER_NEW_RECIPE}" Margin="0,0,10,0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_RECIPE_NAME}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="ProductNameTextBox" Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_MODULE}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <ComboBox x:Name="RecipeModuleComboBox" DisplayMemberPath="Name" SelectedValuePath="Code" Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_SELECT_UOM}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <ComboBox x:Name="ProductUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_TARGET_OUTPUT}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="RecipeOutputQuantityTextBox" Text="1" Margin="0,0,0,8"/>

                    <CheckBox x:Name="IsAgingRequiredCheckBox"
                              Content="{loc:Loc Key=UI_RECIPES_LABEL_IS_AGING_REQUIRED}"
                              Margin="0,4,0,6"/>
                    <TextBox x:Name="DefaultMinAgingDaysTextBox" Text="30" Margin="0,0,0,12"/>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_INGREDIENTS_SECTION}" Style="{StaticResource FieldLabelTextStyle}" FontSize="11" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="RecipeRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="RecipeIngredientQuantityTextBox" Text="1"/>
                    </Grid>

                    <Button Content="{loc:Loc Key=UI_RECIPES_BTN_ADD_INGREDIENT}" Click="AddIngredient_Click" Style="{StaticResource PrimaryButtonStyle}" Height="28" Margin="0,0,0,8"/>

                    <ListBox x:Name="AddedIngredientsListBox" Height="100" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RawMaterialName}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" — "/>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UnitValueConverter}">
                                                    <Binding Path="Quantity"/>
                                                    <Binding Path="UnitOfMeasureCode"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Click="RemoveIngredient_Click"
                                            Tag="{Binding}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Width="20"
                                            Height="20"
                                            Margin="6,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="{loc:Loc Key=UI_RECIPES_BTN_CREATE_RECIPE}" Click="CreateRecipe_Click" Style="{StaticResource PrimaryButtonStyle}" Height="32"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- 3. Список сохранённых рецептов -->
        <GroupBox Grid.Column="2" Header="{loc:Loc Key=UI_RECIPES_HEADER_RECIPES_LIST}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <CheckBox x:Name="ShowArchivedRecipesCheckBox"
                          Grid.Row="0"
                          Content="{loc:Loc Key=UI_RECIPES_CHECKBOX_SHOW_ARCHIVED}"
                          Margin="0,0,0,8"
                          Checked="ShowArchived_Changed"
                          Unchecked="ShowArchived_Changed"/>

                <DataGrid Grid.Row="1" x:Name="RecipesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Loc Key=UI_RECIPES_LABEL_RECIPE_NAME}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" Margin="5,0">
                                        <Hyperlink Click="OpenRecipeDetails_Click" Foreground="{DynamicResource AccentBrush}">
                                            <Run Text="{Binding Name}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{loc:Loc Key=UI_RECIPES_COL_MODULE}" Binding="{Binding TargetModule}" Width="130"/>

                        <DataGridTemplateColumn x:Name="RecipeDeleteColumn" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="OpenRecipeMenu_Click" Tag="{Binding}" Style="{StaticResource ActionButtonStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>