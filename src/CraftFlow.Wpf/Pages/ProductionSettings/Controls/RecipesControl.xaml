<UserControl x:Class="CraftFlow.Wpf.Pages.ProductionSettings.Controls.RecipesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
             xmlns:conv="clr-namespace:CraftFlow.Wpf.Services.Converters">

    <UserControl.Resources>
        <conv:UnitValueConverter x:Key="UnitValueConverter"/>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Ингредиенты и Сырьё -->
        <GroupBox Grid.Column="0" Header="{loc:Loc Key=HEADER_RAW_MATERIALS}" Margin="0,0,10,0" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc Key=RAW_MATERIAL_NAME}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="RawMaterialNameTextBox" Height="28" Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc Key=SELECT_UOM}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="RawUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,12"/>

                    <Button Content="{loc:Loc Key=CREATE_RAW_MATERIAL}" Click="CreateRawMaterial_Click" Style="{StaticResource PrimaryButtonStyle}" Height="30"/>
                </StackPanel>

                <CheckBox x:Name="ShowArchivedRawCheckBox" Grid.Row="1" Content="{loc:Loc Key=CHECKBOX_SHOW_ARCHIVED}" 
                          FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,8" 
                          Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed"/>

                <DataGrid Grid.Row="2" x:Name="RawMaterialsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=RAW_MATERIAL_NAME}" Binding="{Binding Name}" Width="*"/>
                        <DataGridTemplateColumn x:Name="RawMaterialDeleteColumn" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="•••" Click="DeleteRawMaterial_Click" Tag="{Binding Id}" Style="{StaticResource ActionButtonStyle}" Width="28" Height="24" Padding="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 2. Конструктор рецепта -->
        <GroupBox Grid.Column="1" Header="{loc:Loc Key=HEADER_NEW_RECIPE}" Margin="0,0,10,0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=RECIPE_NAME}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="ProductNameTextBox" Height="28" Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc Key=SELECT_UOM}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ProductUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,8"/>

                    <TextBlock Text="{loc:Loc Key=TARGET_OUTPUT_QUANTITY}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="RecipeOutputQuantityTextBox" Text="1" Height="28" Margin="0,0,0,8"/>

                    <CheckBox x:Name="IsAgingRequiredCheckBox" Content="{loc:Loc Key=IS_AGING_REQUIRED}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,4,0,4"/>
                    <TextBox x:Name="DefaultMinAgingDaysTextBox" Text="30" Height="28" Margin="0,0,0,12"/>

                    <Separator Margin="0,0,0,12"/>

                    <TextBlock Text="{loc:Loc Key=INGREDIENT_SECTION}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="RecipeRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" x:Name="RecipeIngredientQuantityTextBox" Text="1" Height="28"/>
                    </Grid>

                    <Button Content="{loc:Loc Key=BTN_ADD}" Click="AddIngredient_Click" Style="{StaticResource PrimaryButtonStyle}" Height="28" Margin="0,0,0,8"/>

                    <ListBox x:Name="AddedIngredientsListBox" Height="100" Margin="0,0,0,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <TextBlock Text="{Binding RawMaterialName}" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBlock Text=" — " Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBlock Foreground="{DynamicResource AppForegroundBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource UnitValueConverter}">
                                                <Binding Path="Quantity"/>
                                                <Binding Path="UnitOfMeasureCode"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="{loc:Loc Key=CREATE_RECIPE}" Click="CreateRecipe_Click" Style="{StaticResource PrimaryButtonStyle}" Height="32"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- 3. Список сохранённых рецептов -->
        <GroupBox Grid.Column="2" Header="{loc:Loc Key=HEADER_RECIPES}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <CheckBox x:Name="ShowArchivedRecipesCheckBox" Grid.Row="0" Content="{loc:Loc Key=CHECKBOX_SHOW_ARCHIVED}" 
                          FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,8" 
                          Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed"/>

                <DataGrid Grid.Row="1" x:Name="RecipesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Loc Key=RECIPE_NAME}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" Margin="5,0">
                                        <Hyperlink Click="OpenRecipeDetails_Click">
                                            <Run Text="{Binding Name}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="RecipeDeleteColumn" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="•••" Click="DeleteRecipe_Click" Tag="{Binding Id}" Style="{StaticResource ActionButtonStyle}" Width="28" Height="24" Padding="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>