<Window x:Class="CraftFlow.Wpf.Windows.CreateRecipeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
        xmlns:conv="clr-namespace:CraftFlow.Wpf.Services.Converters"
        Title="{loc:Loc Key=UI_RECIPES_HEADER_NEW_RECIPE}"
        Height="470"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}">

    <Window.Resources>
        <conv:UnitValueConverter x:Key="UnitValueConverter"/>
    </Window.Resources>

    <Border Padding="{StaticResource CardPadding}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <TextBlock Grid.Row="0"
                       Text="{loc:Loc Key=UI_RECIPES_HEADER_NEW_RECIPE}"
                       Style="{StaticResource CardTitleTextStyle}"
                       Margin="0,0,0,16"/>

            <!-- 2 колонки: слева паспорт рецепта, справа ингредиенты -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="{StaticResource ColumnGap}"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Основные параметры -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_RECIPE_NAME}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="ProductNameTextBox" Margin="{StaticResource FieldRowMargin}"/>

                    <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_MODULE}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <ComboBox x:Name="RecipeModuleComboBox" DisplayMemberPath="Name" SelectedValuePath="Code" Margin="{StaticResource FieldRowMargin}"/>

                    <Grid Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_TARGET_OUTPUT}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <TextBox x:Name="RecipeOutputQuantityTextBox" Text="1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Key=UI_RECIPES_LABEL_SELECT_UOM}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <ComboBox x:Name="ProductUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="IsAgingRequiredCheckBox"
                              Content="{loc:Loc Key=UI_RECIPES_LABEL_IS_AGING_REQUIRED}"
                              Margin="0,6,0,6"
                              Checked="IsAgingRequired_Changed"
                              Unchecked="IsAgingRequired_Changed"/>
                    <TextBox x:Name="DefaultMinAgingDaysTextBox" Text="30" IsEnabled="False"/>
                </StackPanel>

                <!-- Правая колонка: Состав рецепта -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{loc:Loc Key=UI_RECIPES_LABEL_INGREDIENTS_SECTION}"
                               Style="{StaticResource FieldLabelTextStyle}"
                               FontSize="11"
                               Margin="0,0,0,6"/>

                    <Grid Grid.Row="1" Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  x:Name="RecipeRawMaterialComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1"
                                 x:Name="RecipeIngredientQuantityTextBox"
                                 Text="1"
                                 Margin="0,0,6,0"/>
                        <Button Grid.Column="2"
                                Content="+"
                                Click="AddIngredient_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="32"
                                Height="{StaticResource ControlHeight}"/>
                    </Grid>

                    <ListBox Grid.Row="2"
                             x:Name="AddedIngredientsListBox"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RawMaterialName}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" — "/>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource UnitValueConverter}">
                                                    <Binding Path="Quantity"/>
                                                    <Binding Path="UnitOfMeasureCode"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Click="RemoveIngredient_Click"
                                            Tag="{Binding}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Width="20"
                                            Height="20"
                                            Margin="6,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- Нижняя панель кнопок -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="{loc:Loc Key=UI_BTN_CANCEL}"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="{StaticResource ButtonHeight}"
                        Padding="18,0"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="2"
                        Content="{loc:Loc Key=UI_RECIPES_BTN_CREATE_RECIPE}"
                        Click="Save_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="{StaticResource ButtonHeight}"
                        Padding="18,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>