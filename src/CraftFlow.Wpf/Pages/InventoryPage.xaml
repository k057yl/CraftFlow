<Page x:Class="CraftFlow.Wpf.Pages.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="InventoryPage">
	<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
		<StackPanel>
			<TextBlock Text="{loc:Loc TITLE_INVENTORY}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

			<!-- Склады -->
			<GroupBox Header="{loc:Loc WAREHOUSES_HEADER}" Margin="0,0,0,10" Padding="8">
				<StackPanel>
					<TextBlock Text="{loc:Loc WAREHOUSE_NAME}"/>
					<TextBox x:Name="WarehouseNameTextBox" Text="Main Raw Storage" Margin="0,0,0,5"/>

					<TextBlock Text="{loc:Loc WAREHOUSE_ADDRESS}"/>
					<TextBox x:Name="WarehouseAddressTextBox" Text="Industrial Zone 1" Margin="0,0,0,5"/>

					<Button Content="{loc:Loc CREATE_WAREHOUSE}" Click="CreateWarehouse_Click" Height="25" Margin="0,5,0,0"/>
				</StackPanel>
			</GroupBox>

			<!-- Оприходование сырья -->
			<GroupBox Header="{loc:Loc STOCK_LOTS_HEADER}" Margin="0,0,0,10" Padding="8">
				<StackPanel>
					<TextBlock Text="{loc:Loc SELECT_WAREHOUSE}"/>
					<ComboBox x:Name="StockWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>

					<TextBlock Text="{loc:Loc SELECT_RAW_MATERIAL}"/>
					<ComboBox x:Name="StockRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>

					<Grid Margin="0,0,0,5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" Margin="0,0,5,0">
							<TextBlock Text="{loc:Loc LOT_QUANTITY}"/>
							<TextBox x:Name="StockQuantityTextBox" Text="500"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Margin="5,0,0,0">
							<TextBlock Text="{loc:Loc UNIT_PRICE}"/>
							<TextBox x:Name="StockUnitPriceTextBox" Text="25.00"/>
						</StackPanel>
					</Grid>

					<TextBlock Text="{loc:Loc BATCH_NUMBER}"/>
					<TextBox x:Name="StockBatchTextBox" Text="BATCH-2026-001" Margin="0,0,0,5"/>

					<Button Content="{loc:Loc ADD_STOCK_LOT}" Click="AddStockLot_Click" Height="25" Margin="0,5,0,0"/>
				</StackPanel>
			</GroupBox>

			<TextBlock x:Name="StatusTextBlock" Text="READY" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
		</StackPanel>
	</ScrollViewer>
</Page>