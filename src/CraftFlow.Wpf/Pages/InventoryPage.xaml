<Page x:Class="CraftFlow.Wpf.Pages.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="InventoryPage">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=TITLE_INVENTORY}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1">
            <!-- 1. Склады -->
            <TabItem Header="{loc:Loc Key=WAREHOUSES_HEADER}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="{loc:Loc Key=CREATE_WAREHOUSE}" Margin="0,0,0,10" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Key=WAREHOUSE_NAME}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="WarehouseNameTextBox" Width="180" Margin="0,0,15,0" Text="Склад сырья №1"/>

                            <TextBlock Text="{loc:Loc Key=WAREHOUSE_ADDRESS}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="WarehouseAddressTextBox" Width="200" Margin="0,0,15,0" Text="Industrial Zone 1"/>

                            <Button Content="{loc:Loc Key=CREATE_WAREHOUSE}" Click="CreateWarehouse_Click" Width="120" Height="25"/>
                        </StackPanel>
                    </GroupBox>

                    <DataGrid Grid.Row="1" x:Name="WarehousesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название Склада" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 2. Камеры Созревания -->
            <TabItem Header="{loc:Loc Key=HEADER_AGING_CHAMBERS}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="{loc:Loc Key=CREATE_AGING_CHAMBER}" Margin="0,0,0,10" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Key=AGING_CHAMBER_NAME}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="ChamberNameTextBox" Width="160" Margin="0,0,15,0" Text="Chamber #1 (Gouda)"/>

                            <TextBlock Text="{loc:Loc Key=TARGET_TEMPERATURE}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="ChamberTempTextBox" Width="60" Margin="0,0,15,0" Text="12.0"/>

                            <TextBlock Text="{loc:Loc Key=TARGET_HUMIDITY}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="ChamberHumidityTextBox" Width="60" Margin="0,0,15,0" Text="85.0"/>

                            <Button Content="{loc:Loc Key=CREATE_AGING_CHAMBER}" Click="CreateChamber_Click" Width="140" Height="25"/>
                        </StackPanel>
                    </GroupBox>

                    <DataGrid Grid.Row="1" x:Name="ChambersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название Камеры" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="READY" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>