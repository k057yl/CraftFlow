<Page x:Class="CraftFlow.Wpf.Pages.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_INVENTORY}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=TITLE_INVENTORY}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1">
            <!-- 1. Склады -->
            <TabItem Header="{loc:Loc Key=WAREHOUSES_HEADER}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="{loc:Loc Key=CREATE_WAREHOUSE}" Margin="0,0,0,10" Padding="10">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                <TextBlock Text="{loc:Loc Key=WAREHOUSE_NAME}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="WarehouseNameTextBox" Width="180" Padding="5,3" Text="Склад сырья №1"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                <TextBlock Text="{loc:Loc Key=WAREHOUSE_ADDRESS}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="WarehouseAddressTextBox" Width="220" Padding="5,3" Text="Industrial Zone 1"/>
                            </StackPanel>

                            <Button Content="{loc:Loc Key=CREATE_WAREHOUSE}" 
                                    Click="CreateWarehouse_Click" 
                                    Width="130" 
                                    Height="28" 
                                    Margin="0,0,0,5" 
                                    FontWeight="SemiBold"/>
                        </WrapPanel>
                    </GroupBox>

                    <DataGrid Grid.Row="1" x:Name="WarehousesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=WAREHOUSE_NAME}" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 2. Камеры Созревания -->
            <TabItem Header="{loc:Loc Key=HEADER_AGING_CHAMBERS}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="{loc:Loc Key=CREATE_AGING_CHAMBER}" Margin="0,0,0,10" Padding="10">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                <TextBlock Text="{loc:Loc Key=AGING_CHAMBER_NAME}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="ChamberNameTextBox" Width="160" Padding="5,3" Text="Chamber #1 (Gouda)"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                <TextBlock Text="{loc:Loc Key=TARGET_TEMPERATURE}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="ChamberTempTextBox" Width="60" Padding="5,3" Text="12.0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,15,5">
                                <TextBlock Text="{loc:Loc Key=TARGET_HUMIDITY}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="ChamberHumidityTextBox" Width="60" Padding="5,3" Text="85.0"/>
                            </StackPanel>

                            <Button Content="{loc:Loc Key=CREATE_AGING_CHAMBER}" 
                                    Click="CreateChamber_Click" 
                                    Width="160" 
                                    Height="28" 
                                    Margin="0,0,0,5" 
                                    FontWeight="SemiBold"/>
                        </WrapPanel>
                    </GroupBox>

                    <DataGrid Grid.Row="1" x:Name="ChambersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=AGING_CHAMBER_NAME}" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=STATUS_READY}" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>