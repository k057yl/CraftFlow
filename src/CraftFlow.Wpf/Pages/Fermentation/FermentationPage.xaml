<Page x:Class="CraftFlow.Wpf.Pages.Fermentation.FermentationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:controls="clr-namespace:CraftFlow.Wpf.Pages.Production.Controls"
      Title="{loc:Loc Key=UI_TITLE_FERMENTATION}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <TextBlock Text="{loc:Loc Key=UI_FERMENTATION_HEADER}"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppForegroundBrush}"
                   Margin="0,0,0,16"/>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" x:Name="FermentationTabControl">

            <!-- Вкладка 1: Закладка сырья и выпуск -->
            <TabItem Header="{loc:Loc Key=UI_TAB_FERMENTATION_BATCHES}">
                <controls:BrewhouseControl x:Name="FermentationBrewhouseView"/>
            </TabItem>

            <!-- Вкладка 2: Журнал брожения и контроль pH -->
            <TabItem Header="{loc:Loc Key=UI_TAB_FERMENTATION_LOG}">
                <Border Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка: Паспорт брожения + Калькулятор соли -->
                        <GroupBox Grid.Column="0" Header="{loc:Loc Key=UI_FERM_GROUP_NEW_PASSPORT}" Margin="0,0,8,0" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=UI_FERM_LABEL_ACTIVE_BATCH}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="ActiveProdBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc Key=UI_FERM_LABEL_SUBSTRATE_KG}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="SubstrateWeightTextBox" Text="10" Height="26" Padding="4,2" TextChanged="SaltInputs_Changed"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc Key=UI_FERM_LABEL_SALT_PERCENT}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="SaltPercentageTextBox" Text="2.0" Height="26" Padding="4,2" TextChanged="SaltInputs_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                        <TextBlock x:Name="CalculatedSaltTextBlock" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc Key=UI_FERM_LABEL_TARGET_TEMP}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TargetTempTextBox" Text="20" Height="26" Padding="4,2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc Key=UI_FERM_LABEL_INITIAL_PH}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="InitialPhTextBox" Height="26" Padding="4,2"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{loc:Loc Key=UI_FERM_LABEL_VESSEL_INFO}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="VesselInfoTextBox" Height="26" Padding="4,2" Margin="0,0,0,12"/>

                                    <Button Content="{loc:Loc Key=UI_FERM_BTN_CREATE_PASSPORT}"
                                            Click="CreateFermentationPassport_Click"
                                            Height="28"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- Центральная колонка: Активные партии брожения -->
                        <GroupBox Grid.Column="1" Header="{loc:Loc Key=UI_FERM_GROUP_ACTIVE_LOTS}" Margin="0,0,8,0" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0"
                                          x:Name="FermentationBatchesDataGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          Background="Transparent"
                                          GridLinesVisibility="Horizontal"
                                          SelectionChanged="FermentationBatchesDataGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_FERM_COL_BATCH}" Binding="{Binding BatchNumber}" Width="1.1*"/>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_FERM_COL_PRODUCT}" Binding="{Binding RecipeName}" Width="1.3*"/>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_FERM_COL_STAGE}" Binding="{Binding StageDisplay}" Width="1.1*"/>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_FERM_COL_DAYS}" Binding="{Binding DaysElapsed}" Width="0.55*"/>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_FERM_COL_SALT}" Binding="{Binding SaltDisplay}" Width="0.95*"/>
                                        <DataGridTemplateColumn Header="{loc:Loc Key=UI_FERM_COL_PH}" Width="0.8*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PhDisplay}" FontWeight="Bold" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSafeAcidity}" Value="True">
                                                                        <Setter Property="Foreground" Value="#059669"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{loc:Loc Key=UI_FERM_COL_VESSEL}" Binding="{Binding VesselInfo}" Width="1*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{loc:Loc Key=UI_FERM_BTN_MOVE_COLD}"
                                            Click="MoveToCold_Click"
                                            Height="28"
                                            Padding="12,0"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Content="{loc:Loc Key=UI_FERM_BTN_COMPLETE}"
                                            Click="CompleteFermentation_Click"
                                            Height="28"
                                            Padding="12,0"
                                            Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Правая колонка: Замер и история -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0" Header="{loc:Loc Key=UI_FERM_GROUP_ADD_READING}" Margin="0,0,0,8" Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc Key=UI_FERM_LABEL_PH}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="ReadingPhTextBox" Height="26" Padding="4,2"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc Key=UI_FERM_LABEL_TEMP}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="ReadingTempTextBox" Height="26" Padding="4,2"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="DegassedCheckBox" Content="{loc:Loc Key=UI_FERM_CHECK_DEGASSED}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="BrineToppedUpCheckBox" Content="{loc:Loc Key=UI_FERM_CHECK_BRINE}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Text="{loc:Loc Key=UI_FERM_LABEL_NOTES}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="SensoryNotesTextBox" Height="26" Padding="4,2" Margin="0,0,0,10"/>

                                    <Button Content="{loc:Loc Key=UI_FERM_BTN_ADD_READING}"
                                            Click="AddReading_Click"
                                            Height="28"
                                            Padding="14,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Header="{loc:Loc Key=UI_FERM_GROUP_HISTORY}" Padding="8">
                                <ListBox x:Name="ReadingsHistoryListBox" DisplayMemberPath="Summary" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Вкладка 3: Списание -->
            <TabItem Header="{loc:Loc Key=UI_TAB_DISCARD_ACTS}">
                <controls:DiscardActsControl x:Name="FermentationDiscardView"/>
            </TabItem>

        </TabControl>

        <!-- Строка статуса -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Text="{loc:Loc Key=UI_STATUS_READY}"
                   Foreground="{DynamicResource AccentBrush}"
                   FontWeight="SemiBold"
                   Margin="0,12,0,0"/>
    </Grid>
</Page>