<Window x:Class="CraftFlow.Wpf.Windows.RecipeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CraftFlow.Wpf.Services.Converters"
        Title="Состав рецепта" Height="380" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <conv:UnitValueConverter x:Key="UnitValueConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="RecipeNameTextBlock" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="RecipeInfoTextBlock" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Ингредиенты" Padding="5">
            <DataGrid x:Name="IngredientsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Сырьё" Binding="{Binding RawMaterialName}" Width="*"/>
                    <DataGridTemplateColumn Header="Количество" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource UnitValueConverter}">
                                            <Binding Path="Quantity"/>
                                            <Binding Path="UnitOfMeasureCode"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Button Grid.Row="2" Content="Закрыть" Click="Close_Click" Style="{StaticResource PrimaryButtonStyle}" Height="30" Margin="0,10,0,0" HorizontalAlignment="Right" Width="100"/>
    </Grid>
</Window>