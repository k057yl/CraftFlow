<Page x:Class="CraftFlow.Wpf.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:auth="clr-namespace:CraftFlow.Wpf.MarkupExtensions"
      Title="Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20" Visibility="{auth:HasPermission Permission=DASHBOARD_VIEW}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панель Фильтров Периода -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Key=AUDIT_DATE_FROM}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                    <DatePicker x:Name="FromDatePicker" Width="130" Height="28" Margin="0,0,15,0"/>

                    <TextBlock Text="{loc:Loc Key=AUDIT_DATE_TO}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                    <DatePicker x:Name="ToDatePicker" Width="130" Height="28" Margin="0,0,15,0"/>

                    <Button Content="{loc:Loc Key=REFRESH_LOGS}" Click="RefreshDashboard_Click" Style="{StaticResource PrimaryButtonStyle}" Height="28" Width="100"/>
                </StackPanel>
            </Border>

            <!-- СЕКЦИЯ АЛАРМОВ / ТРЕВОГ -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,15">
                <Border Background="#FFF1F0" BorderBrush="#FFA39E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=DASH_EXPIRING_LOTS}" FontSize="11" Foreground="#CF1322" FontWeight="Bold"/>
                        <TextBlock x:Name="ExpiringLotsTextBlock" Text="0" FontSize="20" FontWeight="Bold" Foreground="#CF1322" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF7E6" BorderBrush="#FFD591" BorderThickness="1" CornerRadius="6" Padding="12" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=DASH_OVERDUE_SANITATION}" FontSize="11" Foreground="#D46B08" FontWeight="Bold"/>
                        <TextBlock x:Name="OverdueSanitationTextBlock" Text="0" FontSize="20" FontWeight="Bold" Foreground="#D46B08" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#E6F7FF" BorderBrush="#91CAFF" BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=DASH_PENDING_PROCUREMENTS}" FontSize="11" Foreground="#0958D9" FontWeight="Bold"/>
                        <TextBlock x:Name="PendingProcurementsTextBlock" Text="0" FontSize="20" FontWeight="Bold" Foreground="#0958D9" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- КЛЮЧЕВЫЕ ПОКАЗАТЕЛИ (ОБЗОР) -->
            <GroupBox Grid.Row="2" Header="{loc:Loc Key=SYSTEM_DASHBOARD_OVERVIEW}" Padding="15" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="10">
                        <TextBlock Text="{loc:Loc Key=PRODUCTS_RECIPES}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Opacity="0.7"/>
                        <TextBlock x:Name="ProductsCountTextBlock" Text="0 / 0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
                        <TextBlock Text="{loc:Loc Key=ACTIVE_BATCHES}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Opacity="0.7"/>
                        <TextBlock x:Name="ActiveBatchesTextBlock" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
                        <TextBlock Text="{loc:Loc Key=DASH_RAW_STOCK}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Opacity="0.7"/>
                        <TextBlock x:Name="RawStockTextBlock" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
                        <TextBlock Text="{loc:Loc Key=DASH_FINISHED_STOCK}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Opacity="0.7"/>
                        <TextBlock x:Name="FinishedStockTextBlock" Text="0.00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10">
                        <TextBlock Text="{loc:Loc Key=DASH_PERIOD_REVENUE}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Opacity="0.7"/>
                        <TextBlock x:Name="TotalRevenueTextBlock" Text="$ 0.00" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Page>