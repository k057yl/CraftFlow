<Page x:Class="CraftFlow.Wpf.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="Dashboard">
	<Grid Margin="20">
		<GroupBox Header="{loc:Loc SYSTEM_DASHBOARD_OVERVIEW}" Padding="15" Background="#F8FAFC">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Grid.Column="0" Margin="10">
					<TextBlock Text="{loc:Loc PRODUCTS_RECIPES}" FontSize="11" Foreground="Gray"/>
					<TextBlock x:Name="ProductsCountTextBlock" Text="0 / 0" FontSize="22" FontWeight="Bold"/>
				</StackPanel>

				<StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
					<TextBlock Text="{loc:Loc ACTIVE_BATCHES}" FontSize="11" Foreground="Gray"/>
					<TextBlock x:Name="ActiveBatchesTextBlock" Text="0" FontSize="22" FontWeight="Bold" Foreground="Orange"/>
				</StackPanel>

				<StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
					<TextBlock Text="{loc:Loc CUSTOMERS}" FontSize="11" Foreground="Gray"/>
					<TextBlock x:Name="CustomersCountTextBlock" Text="0" FontSize="22" FontWeight="Bold"/>
				</StackPanel>

				<StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
					<TextBlock Text="{loc:Loc TOTAL_STOCK_QTY}" FontSize="11" Foreground="Gray"/>
					<TextBlock x:Name="TotalStockTextBlock" Text="0.00" FontSize="22" FontWeight="Bold" Foreground="Blue"/>
				</StackPanel>

				<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10">
					<TextBlock Text="{loc:Loc TOTAL_REVENUE}" FontSize="11" Foreground="Gray"/>
					<TextBlock x:Name="TotalRevenueTextBlock" Text="$ 0.00" FontSize="28" FontWeight="Bold" Foreground="Green"/>
				</StackPanel>
			</Grid>
		</GroupBox>
	</Grid>
</Page>