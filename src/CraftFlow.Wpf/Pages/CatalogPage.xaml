<Page x:Class="CraftFlow.Wpf.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_CATALOG}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=TITLE_CATALOG}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1">

            <!-- ================= 1. НОМЕНКЛАТУРА И РЕЦЕПТЫ ================= -->
            <TabItem Header="Номенклатура и Рецепты">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <!-- 1. Сырье -->
                        <ColumnDefinition Width="260"/>
                        <!-- 2 & 2.1 Новая рецептура -->
                        <ColumnDefinition Width="300"/>
                        <!-- 2.2 Список рецептов -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= [1] СЫРЬЕ И ИНГРЕДИЕНТЫ ================= -->
                    <GroupBox Grid.Column="0" Header="{loc:Loc Key=HEADER_RAW_MATERIALS}" Margin="0,0,10,0" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Название сырья:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="RawMaterialNameTextBox" Height="24" Margin="0,0,0,6"/>

                                <TextBlock Text="Единица измерения:" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="RawUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="24" Margin="0,0,0,8"/>

                                <Button Content="Добавить сырьё" Click="CreateRawMaterial_Click" Style="{StaticResource PrimaryButtonStyle}" Height="26" Margin="0,0,0,4"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="RawMaterialsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=RAW_MATERIAL_NAME}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTemplateColumn Width="45">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Click="DeleteRawMaterial_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}" Width="24" Height="24" Padding="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- ================= [2 & 2.1] СОЗДАНИЕ РЕЦЕПТУРЫ ================= -->
                    <GroupBox Grid.Column="1" Header="Новая рецептура" Margin="0,0,10,0" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- [Блок 2] Основная информация -->
                                <TextBlock Text="Название продукта / рецепта:" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="ProductNameTextBox" Height="24" Margin="0,0,0,6"/>

                                <TextBlock Text="Единица измерения выхода:" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ProductUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="24" Margin="0,0,0,6"/>

                                <TextBlock Text="Выход (кг/л):" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="RecipeOutputQuantityTextBox" Text="1" Height="24" Margin="0,0,0,6"/>

                                <CheckBox x:Name="IsAgingRequiredCheckBox" Content="Созревание (дни):" FontSize="10" Margin="0,2,0,2"/>
                                <TextBox x:Name="DefaultMinAgingDaysTextBox" Text="30" Height="24" Margin="0,0,0,12"/>

                                <Separator Margin="0,0,0,10"/>

                                <!-- [Блок 2.1] Состав сырья и кнопки -->
                                <TextBlock Text="Состав сырья:" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="RecipeRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="24" Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1" x:Name="RecipeIngredientQuantityTextBox" Text="1" Height="24" Margin="0,0,4,0"/>
                                    <Button Grid.Column="2" Content="+" Click="AddIngredient_Click" Style="{StaticResource PrimaryButtonStyle}" Height="24"/>
                                </Grid>

                                <ListBox x:Name="AddedIngredientsListBox" Height="90" DisplayMemberPath="DisplayInfo" Margin="0,0,0,12"/>

                                <Button Content="Сохранить рецепт" Click="CreateRecipe_Click" Style="{StaticResource PrimaryButtonStyle}" Height="28"/>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- ================= [2.2] СПИСОК РЕЦЕПТУР ================= -->
                    <GroupBox Grid.Column="2" Header="{loc:Loc Key=HEADER_RECIPES}" Padding="8">
                        <DataGrid x:Name="RecipesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Рецепт" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" Margin="5,0">
                                                <Hyperlink Click="OpenRecipeDetails_Click">
                                                    <Run Text="{Binding Name}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="45">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Click="DeleteRecipe_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}" Width="24" Height="24" Padding="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ================= 2. ИНФРАСТРУКТУРА И СКЛАДЫ ================= -->
            <TabItem Header="Инфраструктура и Склады">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Склады -->
                        <GroupBox Grid.Column="0" Header="{loc:Loc Key=WAREHOUSES_HEADER}" Margin="0,0,5,0" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBox x:Name="WarehouseNameTextBox" Width="120" Margin="0,0,5,0" ToolTip="Название"/>
                                    <TextBox x:Name="WarehouseAddressTextBox" Width="120" Margin="0,0,5,0" ToolTip="Адрес"/>
                                    <Button Content="+" Click="CreateWarehouse_Click" Style="{StaticResource PrimaryButtonStyle}" Width="30" Height="24"/>
                                </WrapPanel>
                                <DataGrid Grid.Row="1" x:Name="WarehousesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Склад" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTemplateColumn Width="45">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Click="DeleteWarehouse_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}" Width="24" Height="24" Padding="0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                        <!-- Камеры Созревания -->
                        <GroupBox Grid.Column="1" Header="{loc:Loc Key=HEADER_AGING_CHAMBERS}" Margin="5,0,0,0" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBox x:Name="ChamberNameTextBox" Width="110" Margin="0,0,5,0" ToolTip="Название"/>
                                    <TextBox x:Name="ChamberTempTextBox" Width="45" Text="12.0" Margin="0,0,5,0" ToolTip="Температура °C"/>
                                    <TextBox x:Name="ChamberHumidityTextBox" Width="45" Text="85.0" Margin="0,0,5,0" ToolTip="Влажность %"/>
                                    <Button Content="+" Click="CreateChamber_Click" Style="{StaticResource PrimaryButtonStyle}" Width="30" Height="24"/>
                                </WrapPanel>
                                <DataGrid Grid.Row="1" x:Name="ChambersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Камера" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTemplateColumn Width="45">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Click="DeleteChamber_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}" Width="24" Height="24" Padding="0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Ёмкости / Стеллажи -->
                    <GroupBox Grid.Row="1" Header="Ёмкости / Стеллажи" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button Content="➕ Создать ёмкость / танк" Click="OpenCreateStorageLocationModal_Click" Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="12,0" HorizontalAlignment="Left"/>
                            </DockPanel>

                            <DataGrid Grid.Row="1" x:Name="StorageLocationsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding LocationType}" Width="120"/>
                                    <DataGridTextColumn Header="Склад / Камера" Binding="{Binding ParentName}" Width="180"/>
                                    <DataGridTextColumn Header="Загрузка / Объём" Binding="{Binding VolumeInfo}" Width="*"/>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Click="DeleteStorageLocation_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}" Width="24" Height="24" Padding="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=STATUS_READY}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>