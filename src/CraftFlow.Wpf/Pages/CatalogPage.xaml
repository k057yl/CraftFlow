<Page x:Class="CraftFlow.Wpf.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_CATALOG}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=TITLE_CATALOG}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1">

            <!-- ================= 1. НОМЕНКЛАТУРА И РЕЦЕПТЫ (СЕТКА 2x2) ================= -->
            <TabItem Header="Номенклатура и Рецепты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- [1] Единицы измерения -->
                    <GroupBox Grid.Row="0" Grid.Column="0" Header="{loc:Loc Key=HEADER_UOM}" Margin="0,0,5,5" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBox x:Name="UomNameTextBox" Width="120" Margin="0,0,5,5" ToolTip="Название"/>
                                <TextBox x:Name="UomCodeTextBox" Width="60" Margin="0,0,5,5" ToolTip="Код"/>
                                <Button Content="{loc:Loc Key=CREATE_UOM}" Click="CreateUom_Click" Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="8,0" Margin="0,0,5,5"/>
                                <Button Content="⚡ Presets ▾" Click="SeedUomPreset_Click" Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" Height="26" Padding="8,0" Margin="0,0,0,5">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="🇪🇺 Metric (kg, g, l, ml, pcs)" Click="SeedMetric_Click"/>
                                            <MenuItem Header="🇺🇸 Imperial (lb, oz, gal, fl oz, pcs)" Click="SeedImperial_Click"/>
                                            <Separator/>
                                            <MenuItem Header="🌐 Full Set" Click="SeedFull_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </WrapPanel>
                            <DataGrid Grid.Row="1" x:Name="UomDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=UOM_NAME}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UOM_CODE}" Binding="{Binding Code}" Width="80"/>
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="❌" Click="DeleteUom_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- [2] Сырье и ингредиенты -->
                    <GroupBox Grid.Row="0" Grid.Column="1" Header="{loc:Loc Key=HEADER_RAW_MATERIALS}" Margin="5,0,0,5" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBox x:Name="RawMaterialNameTextBox" Width="140" Margin="0,0,5,5"/>
                                <ComboBox x:Name="RawUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="100" Margin="0,0,5,5"/>
                                <Button Content="Добавить" Click="CreateRawMaterial_Click" Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="10,0" Margin="0,0,0,5"/>
                            </WrapPanel>
                            <DataGrid Grid.Row="1" x:Name="RawMaterialsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=RAW_MATERIAL_NAME}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="❌" Click="DeleteRawMaterial_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- [3] Готовая продукция -->
                    <GroupBox Grid.Row="1" Grid.Column="0" Header="{loc:Loc Key=HEADER_PRODUCTS}" Margin="0,5,5,0" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBox x:Name="ProductNameTextBox" Width="140" Margin="0,0,5,5"/>
                                <ComboBox x:Name="ProductUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="100" Margin="0,0,5,5"/>
                                <Button Content="Создать" Click="CreateProduct_Click" Style="{StaticResource PrimaryButtonStyle}" Height="26" Padding="10,0" Margin="0,0,0,5"/>
                            </WrapPanel>
                            <DataGrid Grid.Row="1" x:Name="ProductsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=PRODUCT_NAME}" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="❌" Click="DeleteProduct_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- [4] Технологические рецептуры -->
                    <GroupBox Grid.Row="1" Grid.Column="1" Header="{loc:Loc Key=HEADER_RECIPES}" Margin="5,5,0,0" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Рецепт:" FontSize="10"/>
                                    <TextBox x:Name="RecipeNameTextBox" Height="24" Margin="0,0,0,4"/>

                                    <TextBlock Text="Продукт:" FontSize="10"/>
                                    <ComboBox x:Name="RecipeProductComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="24" Margin="0,0,0,4"/>

                                    <TextBlock Text="Выход (кг/л):" FontSize="10"/>
                                    <TextBox x:Name="RecipeOutputQuantityTextBox" Text="1" Height="24" Margin="0,0,0,4"/>

                                    <CheckBox x:Name="IsAgingRequiredCheckBox" Content="Созревание (дни):" FontSize="10" Margin="0,2,0,2"/>
                                    <TextBox x:Name="DefaultMinAgingDaysTextBox" Text="30" Height="24" Margin="0,0,0,6"/>

                                    <TextBlock Text="Состав:" FontSize="10" FontWeight="Bold"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="24"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="RecipeRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="24" Margin="0,0,2,0"/>
                                        <TextBox Grid.Column="1" x:Name="RecipeIngredientQuantityTextBox" Text="1" Height="24" Margin="0,0,2,0"/>
                                        <Button Grid.Column="2" Content="+" Click="AddIngredient_Click" Style="{StaticResource PrimaryButtonStyle}" Height="24"/>
                                    </Grid>
                                    <ListBox x:Name="AddedIngredientsListBox" Height="60" DisplayMemberPath="DisplayInfo" Margin="0,0,0,6"/>

                                    <Button Content="Сохранить рецепт" Click="CreateRecipe_Click" Style="{StaticResource PrimaryButtonStyle}" Height="26"/>
                                </StackPanel>
                            </ScrollViewer>

                            <DataGrid Grid.Column="1" x:Name="RecipesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Рецепт" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="❌" Click="DeleteRecipe_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ================= 2. ИНФРАСТРУКТУРА И СКЛАДЫ ================= -->
            <TabItem Header="Инфраструктура и Склады">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Склады -->
                        <GroupBox Grid.Column="0" Header="{loc:Loc Key=WAREHOUSES_HEADER}" Margin="0,0,5,0" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBox x:Name="WarehouseNameTextBox" Width="120" Margin="0,0,5,0" ToolTip="Название"/>
                                    <TextBox x:Name="WarehouseAddressTextBox" Width="120" Margin="0,0,5,0" ToolTip="Адрес"/>
                                    <Button Content="+" Click="CreateWarehouse_Click" Style="{StaticResource PrimaryButtonStyle}" Width="30" Height="24"/>
                                </WrapPanel>
                                <DataGrid Grid.Row="1" x:Name="WarehousesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Склад" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="❌" Click="DeleteWarehouse_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                        <!-- Камеры Созревания -->
                        <GroupBox Grid.Column="1" Header="{loc:Loc Key=HEADER_AGING_CHAMBERS}" Margin="5,0,0,0" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBox x:Name="ChamberNameTextBox" Width="110" Margin="0,0,5,0" ToolTip="Название"/>
                                    <TextBox x:Name="ChamberTempTextBox" Width="45" Text="12.0" Margin="0,0,5,0" ToolTip="Температура °C"/>
                                    <TextBox x:Name="ChamberHumidityTextBox" Width="45" Text="85.0" Margin="0,0,5,0" ToolTip="Влажность %"/>
                                    <Button Content="+" Click="CreateChamber_Click" Style="{StaticResource PrimaryButtonStyle}" Width="30" Height="24"/>
                                </WrapPanel>
                                <DataGrid Grid.Row="1" x:Name="ChambersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Камера" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTemplateColumn Width="40">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="❌" Click="DeleteChamber_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Ёмкости / Стеллажи -->
                    <GroupBox Grid.Row="1" Header="Ёмкости / Стеллажи" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button Content="➕ Создать ёмкость / танк" Click="OpenCreateStorageLocationModal_Click" Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="12,0" HorizontalAlignment="Left"/>
                            </DockPanel>

                            <DataGrid Grid.Row="1" x:Name="StorageLocationsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding LocationType}" Width="120"/>
                                    <DataGridTextColumn Header="Склад / Камера" Binding="{Binding ParentName}" Width="180"/>
                                    <DataGridTextColumn Header="Загрузка / Объём" Binding="{Binding VolumeInfo}" Width="*"/>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="❌" Click="DeleteStorageLocation_Click" Tag="{Binding Id}" Style="{StaticResource DangerButtonStyle}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=STATUS_READY}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>