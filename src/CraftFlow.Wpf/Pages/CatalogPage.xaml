<Page x:Class="CraftFlow.Wpf.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="CatalogPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="{loc:Loc TITLE_CATALOG}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- 1. Единицы измерения -->
            <GroupBox Header="{loc:Loc HEADER_UOM}" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{loc:Loc UOM_NAME}"/>
                            <TextBox x:Name="UomNameTextBox" Text="Kilogram"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{loc:Loc UOM_CODE}"/>
                            <TextBox x:Name="UomCodeTextBox" Text="kg"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="{loc:Loc CREATE_UOM}" Click="CreateUom_Click" Height="25" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 2. Сырье -->
            <GroupBox Header="{loc:Loc HEADER_RAW_MATERIALS}" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="{loc:Loc RAW_MATERIAL_NAME}"/>
                    <TextBox x:Name="RawMaterialNameTextBox" Text="Milk 3.6%" Margin="0,0,0,5"/>

                    <TextBlock Text="{loc:Loc SELECT_UOM}"/>
                    <ComboBox x:Name="RawUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>

                    <Button Content="{loc:Loc CREATE_RAW_MATERIAL}" Click="CreateRawMaterial_Click" Height="25" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 3. Готовая продукция -->
            <GroupBox Header="{loc:Loc HEADER_PRODUCTS}" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="{loc:Loc PRODUCT_NAME}"/>
                    <TextBox x:Name="ProductNameTextBox" Text="Gouda Cheese" Margin="0,0,0,5"/>

                    <TextBlock Text="{loc:Loc SELECT_UOM}"/>
                    <ComboBox x:Name="ProductUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>

                    <Button Content="{loc:Loc CREATE_PRODUCT}" Click="CreateProduct_Click" Height="25" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 4. Технологические Рецепты -->
            <GroupBox Header="{loc:Loc HEADER_RECIPES}" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="{loc:Loc RECIPE_NAME}"/>
                    <TextBox x:Name="RecipeNameTextBox" Text="Classic Gouda Recipe" Margin="0,0,0,5"/>

                    <TextBlock Text="{loc:Loc SELECT_PRODUCT}"/>
                    <ComboBox x:Name="RecipeProductComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>

                    <TextBlock Text="{loc:Loc TARGET_OUTPUT_QUANTITY}"/>
                    <!-- БАЗОВЫЙ ВЫХОД ТЕПЕРЬ СТРОГО = 1 КГ/Л -->
                    <TextBox x:Name="RecipeOutputQuantityTextBox" Text="1" Margin="0,0,0,5"/>

                    <GroupBox Header="{loc:Loc INGREDIENT_SECTION}" Margin="0,5,0,5" Padding="5">
                        <StackPanel>
                            <!-- Выбор сырья и добавление нескольких ингредиентов -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="{loc:Loc SELECT_RAW_MATERIAL}"/>
                                    <ComboBox x:Name="RecipeRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                    <TextBlock Text="{loc:Loc INGREDIENT_QUANTITY}"/>
                                    <TextBox x:Name="RecipeIngredientQuantityTextBox" Text="10"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="+" Click="AddIngredient_Click" Width="30" Height="23" VerticalAlignment="Bottom"/>
                            </Grid>

                            <!-- Список добавленных ингредиентов (Молоко, Соль, Фермент) -->
                            <ListBox x:Name="AddedIngredientsListBox" Height="80" DisplayMemberPath="DisplayInfo" Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <Button Content="{loc:Loc CREATE_RECIPE}" Click="CreateRecipe_Click" Height="25" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusTextBlock" Text="READY" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>