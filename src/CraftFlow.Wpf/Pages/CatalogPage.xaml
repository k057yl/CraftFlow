<Page x:Class="CraftFlow.Wpf.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="CatalogPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="CATALOG MANAGEMENT" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <GroupBox Header="1. UNITS OF MEASURE" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="UOM_NAME:"/>
                            <TextBox x:Name="UomNameTextBox" Text="Kilogram"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="UOM_CODE:"/>
                            <TextBox x:Name="UomCodeTextBox" Text="kg"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="CREATE UOM" Click="CreateUom_Click" Margin="0,8,0,0" Height="25"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. RAW MATERIALS" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="RAW_MATERIAL_NAME:"/>
                    <TextBox x:Name="RawMaterialNameTextBox" Text="Milk 3.6%" Margin="0,0,0,5"/>
                    <TextBlock Text="SELECT UOM:"/>
                    <ComboBox x:Name="RawUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <Button Content="CREATE RAW MATERIAL" Click="CreateRawMaterial_Click" Height="25"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="3. PRODUCTS" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="PRODUCT_NAME:"/>
                    <TextBox x:Name="ProductNameTextBox" Text="Gouda Cheese" Margin="0,0,0,5"/>
                    <TextBlock Text="SELECT UOM:"/>
                    <ComboBox x:Name="ProductUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <Button Content="CREATE PRODUCT" Click="CreateProduct_Click" Height="25"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="4. RECIPES" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="RECIPE_NAME:"/>
                    <TextBox x:Name="RecipeNameTextBox" Text="Classic Gouda Recipe" Margin="0,0,0,5"/>
                    <TextBlock Text="SELECT PRODUCT:"/>
                    <ComboBox x:Name="RecipeProductComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <TextBlock Text="TARGET OUTPUT QUANTITY:"/>
                    <TextBox x:Name="RecipeOutputQuantityTextBox" Text="10" Margin="0,0,0,5"/>

                    <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,5,0,5">
                        <StackPanel>
                            <TextBlock Text="INGREDIENT SECTION" FontWeight="Bold"/>
                            <TextBlock Text="SELECT RAW MATERIAL:"/>
                            <ComboBox x:Name="RecipeRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                            <TextBlock Text="INGREDIENT QUANTITY:"/>
                            <TextBox x:Name="RecipeIngredientQuantityTextBox" Text="100" Margin="0,0,0,5"/>
                        </StackPanel>
                    </Border>

                    <Button Content="CREATE RECIPE" Click="CreateRecipe_Click" Height="25"/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusTextBlock" Text="READY" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>