<Window x:Class="CraftFlow.Wpf.Pages.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CraftFlow Loading" 
        Height="300" Width="500"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Background="#0F172A" CornerRadius="12" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Логотип -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="CRAFTFLOW" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Enterprise ERP System" Foreground="#38BDF8" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Шкала прогресса -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <ProgressBar x:Name="LoadingProgressBar" 
                             Height="6" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="0" 
                             Background="#1E293B" 
                             Foreground="#0284C7" 
                             BorderThickness="0"/>
            </StackPanel>

            <!-- Статус -->
            <TextBlock x:Name="StatusTextBlock" 
                       Grid.Row="2" 
                       Text="Инициализация системы..." 
                       Foreground="#94A3B8" 
                       FontSize="11" 
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>