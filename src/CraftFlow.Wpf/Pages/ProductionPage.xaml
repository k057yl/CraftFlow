<Page x:Class="CraftFlow.Wpf.Pages.ProductionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ProductionPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="PRODUCTION MANAGEMENT" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- 1. Запуск Варки -->
            <GroupBox Header="1. PRODUCTION BATCHES (START)" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="SELECT_RECIPE:"/>
                    <ComboBox x:Name="BatchRecipeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>

                    <TextBlock Text="SELECT_WAREHOUSE:"/>
                    <ComboBox x:Name="BatchWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>

                    <TextBlock Text="PLANNED_OUTPUT_QUANTITY:"/>
                    <TextBox x:Name="BatchQuantityTextBox" Text="10" Margin="0,0,0,5"/>

                    <Button Content="START PRODUCTION BATCH" Click="StartBatch_Click" Height="25" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 2. Завершить Варку -->
            <GroupBox Header="2. COMPLETE PRODUCTION BATCH" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="SELECT_ACTIVE_BATCH:"/>
                    <ComboBox x:Name="ActiveBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>

                    <TextBlock Text="ACTUAL_OUTPUT_QUANTITY:"/>
                    <TextBox x:Name="ActualOutputQuantityTextBox" Text="9.8" Margin="0,0,0,5"/>

                    <Button Content="COMPLETE PRODUCTION BATCH" Click="CompleteBatch_Click" Height="25" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 3. BATCH COST CALCULATOR -->
            <GroupBox Header="3. BATCH COST ANALYSIS" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <Button Content="CALCULATE BATCH COST" Click="CalculateCost_Click" Height="25" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL RAW MATERIAL COST:" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="TotalCostTextBlock" Text="$ 0.00" FontSize="18" FontWeight="Bold" Foreground="Green"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="UNIT COST (PER KG/UNIT):" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="UnitCostTextBlock" Text="$ 0.00" FontSize="18" FontWeight="Bold" Foreground="Blue"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusTextBlock" Text="READY" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>