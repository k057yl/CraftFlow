<Page x:Class="CraftFlow.Wpf.Pages.ProductionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_PRODUCTION}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=PRODUCTION_HEADER}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1" x:Name="ProductionTabControl">

            <!-- Вкладка 1: Варочный цех -->
            <TabItem Header="{loc:Loc Key=TAB_BREWHOUSE}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel MaxWidth="920" HorizontalAlignment="Left" Width="920">

                        <!-- 1. Запуск варки -->
                        <GroupBox Header="{loc:Loc Key=GROUP_START_BATCH}" Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:Loc Key=LABEL_BATCH_CODE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="BatchNameTextBox" Padding="5,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc Key=LABEL_SELECT_RECIPE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <ComboBox x:Name="BatchRecipeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4" SelectionChanged="BatchInputs_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:Loc Key=LABEL_RAW_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <ComboBox x:Name="BatchWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4" SelectionChanged="BatchInputs_Changed"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc Key=LABEL_DEST_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <ComboBox x:Name="DestinationWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Loc Key=LABEL_PLANNED_OUTPUT}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="BatchQuantityTextBox" Text="10" TextChanged="BatchInputs_Changed" Padding="5,4"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" 
                                            Content="{loc:Loc Key=BTN_CALC_MAX}" 
                                            Click="CalculateMaxQuantity_Click" 
                                            Margin="10,18,0,0" 
                                            Padding="12,4" 
                                            Height="28"
                                            Background="#0284C7" 
                                            Foreground="White" 
                                            FontWeight="SemiBold"/>
                                </Grid>

                                <GroupBox Header="{loc:Loc Key=GROUP_RAW_REQUIREMENTS}" Margin="0,5,0,10" Padding="8" Background="#F8FAFC">
                                    <StackPanel>
                                        <ListBox x:Name="RequirementsListBox" Height="90" DisplayMemberPath="DisplayInfo" BorderThickness="0" Background="Transparent"/>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Key=LABEL_ESTIMATED_COST}" Foreground="Gray" Margin="0,0,5,0"/>
                                                <TextBlock x:Name="EstimatedCostTextBlock" Text="$ 0.00" FontWeight="Bold" Foreground="Green"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" 
                                                    Content="{loc:Loc Key=BTN_PRINT_CARD}" 
                                                    Click="PrintRecipeCard_Click" 
                                                    Padding="10,4" 
                                                    Background="#475569" 
                                                    Foreground="White"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>

                                <Button Content="{loc:Loc Key=BTN_START_BATCH}" 
                                        Click="StartBatch_Click" 
                                        Height="32" 
                                        Width="180" 
                                        HorizontalAlignment="Left" 
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ТЕКУЩИЕ ВАРКИ В РАБОТЕ -->
                        <GroupBox Header="Текущие варки в процессе" Margin="0,0,0,12" Padding="8">
                            <DataGrid x:Name="ActiveBatchesDataGrid" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      RowHeaderWidth="0"
                                      MaxHeight="160"
                                      SelectionMode="Single"
                                      SelectionChanged="ActiveBatchesDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Партия" Binding="{Binding BatchName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Рецептура" Binding="{Binding RecipeName}" Width="2*"/>
                                    <DataGridTextColumn Header="План (кг/л)" Binding="{Binding PlannedOutputQuantity, StringFormat={}{0:F2}}" Width="1*"/>
                                    <DataGridTextColumn Header="Старт" Binding="{Binding StartedAt, StringFormat={}{0:HH:mm}}" Width="0.8*"/>
                                    <DataGridTemplateColumn Header="В работе" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FormattedElapsed}" 
                                                           FontWeight="Bold" 
                                                           VerticalAlignment="Center" 
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0369A1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOverdueStatus}" Value="True">
                                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="План (мин)" Binding="{Binding TargetDurationMinutes}" Width="0.8*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- Завершение варки и Анализ -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="{loc:Loc Key=GROUP_COMPLETE_BATCH}" Margin="0,0,10,0" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=LABEL_ACTIVE_BATCH}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <ComboBox x:Name="ActiveBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,8" Padding="5,4" SelectionChanged="ActiveBatchComboBox_SelectionChanged"/>

                                    <TextBlock Text="Наименование готовой партии:" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="CompleteBatchNameTextBox" Margin="0,0,0,8" Padding="5,4"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Фактический вес (кг/л):" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                            <TextBox x:Name="ActualOutputQuantityTextBox" Padding="5,4" TextChanged="CostInputs_Changed"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="{loc:Loc Key=LABEL_UNITS_COUNT}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                            <TextBox x:Name="ActualUnitsCountTextBox" Text="1" Padding="5,4"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="UseOverheadCheckBox" Grid.Column="0" Content="Накладные расходы" VerticalAlignment="Center" Margin="0,0,8,0" Click="CostInputs_Changed"/>
                                        <TextBox x:Name="OverheadPercentageTextBox" Grid.Column="1" Text="15" Padding="5,4" IsEnabled="{Binding IsChecked, ElementName=UseOverheadCheckBox}" TextChanged="CostInputs_Changed"/>
                                        <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#475569" FontWeight="Bold"/>
                                    </Grid>

                                    <Button x:Name="CompleteBatchButton" 
                                            Content="{loc:Loc Key=BTN_COMPLETE_BATCH}" 
                                            Click="CompleteBatch_Click" 
                                            Height="32" 
                                            HorizontalAlignment="Left"
                                            Padding="15,0"
                                            Background="#0284C7" 
                                            Foreground="White" 
                                            FontWeight="Bold"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="Расчет себестоимости партии" Padding="12" Background="#F8FAFC">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Затраты на сырье:" Foreground="#475569" FontSize="11"/>
                                        <TextBlock x:Name="RawMaterialCostTextBlock" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Накладные расходы:" Foreground="#475569" FontSize="11"/>
                                        <TextBlock x:Name="OverheadCostTextBlock" Text="+$0.00 (0%)" HorizontalAlignment="Right" Foreground="#D97706" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Separator Margin="0,4,0,8" Background="#CBD5E1"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Итого стоимость партии:" Foreground="#1E293B" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock x:Name="TotalBatchCostTextBlock" Text="$0.00" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#059669" FontSize="14"/>
                                    </Grid>

                                    <Border Background="#E0F2FE" Padding="8" CornerRadius="4" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Себестоимость за 1 кг/л:" Foreground="#0369A1" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="UnitCostTextBlock" Text="$0.00 / кг" FontSize="18" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </GroupBox>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 2: Созревание и Аффинаж -->
            <TabItem Header="{loc:Loc Key=TAB_AGING}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel MaxWidth="920" HorizontalAlignment="Left" Width="920">

                        <GroupBox Header="{loc:Loc Key=GROUP_TRANSFER_AGING}" Margin="0,0,0,12" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:Loc Key=LABEL_COMPLETED_BATCH}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <ComboBox x:Name="CompletedBatchesComboBox" 
                                                  DisplayMemberPath="Name" 
                                                  SelectedValuePath="Id" 
                                                  Padding="5,4" 
                                                  SelectionChanged="CompletedBatchesComboBox_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc Key=LABEL_AGING_LOT_NAME}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="AgingLotNameTextBox" Padding="5,4"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:Loc Key=LABEL_AGING_CHAMBER}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <ComboBox x:Name="AgingChambersComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc Key=LABEL_MIN_AGING_DAYS}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="MinAgingDaysTextBox" Text="30" Padding="5,4"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="{loc:Loc Key=BTN_TRANSFER_AGING}" 
                                        Click="TransferToAging_Click" 
                                        Height="32" 
                                        HorizontalAlignment="Left"
                                        Padding="15,0"
                                        Background="#059669" 
                                        Foreground="White" 
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ТАБЛИЦА: ТЕКУЩИЕ ПАРТИИ В КАМЕРАХ СОЗРЕВАНИЯ -->
                        <GroupBox Header="Текущие партии в камерах созревания" Margin="0,0,0,12" Padding="8">
                            <DataGrid x:Name="AgingLotsDataGrid" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      RowHeaderWidth="0"
                                      MaxHeight="180"
                                      SelectionMode="Single"
                                      SelectionChanged="AgingLotsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Лот / Партия" Binding="{Binding BatchNumber}" Width="2*"/>
                                    <DataGridTextColumn Header="Камера" Binding="{Binding ChamberName}" Width="*"/>
                                    <DataGridTextColumn Header="Текущий остаток (кг)" Binding="{Binding InitialQuantity, StringFormat={}{0:N2}}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Головок (шт)" Binding="{Binding UnitsCount}" Width="0.8*"/>
                                    <DataGridTextColumn Header="Дней в камере" Binding="{Binding DaysInChamber}" Width="*"/>
                                    <DataGridTextColumn Header="План (дней)" Binding="{Binding TargetDays}" Width="*"/>
                                    <DataGridCheckBoxColumn Header="Готов" Binding="{Binding IsReadyForRelease}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- Извлечение из камеры созревания -->
                        <GroupBox Header="{loc:Loc Key=GROUP_RELEASE_AGING}" Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{loc:Loc Key=LABEL_ACTIVE_AGING_LOT}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <ComboBox x:Name="ActiveAgingLotsComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4" SelectionChanged="ActiveAgingLotsComboBox_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc Key=LABEL_TARGET_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <ComboBox x:Name="TargetWarehousesComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4" SelectionChanged="TargetWarehousesComboBox_SelectionChanged"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Стеллажи / ячейки приемного склада:" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ListBox x:Name="TargetStorageLocationsListBox" Height="80" Background="#F8FAFC" SelectionMode="Multiple">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="[Свободно: " Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding FreeCapacity, StringFormat={}{0:N0}}" Foreground="#16A34A" FontWeight="Bold"/>
                                                    <TextBlock Text=" л/кг]" Foreground="#64748B"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Наименование лота готовой продукции:" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="ReleaseLotNameTextBox" Padding="5,4"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="{loc:Loc Key=LABEL_FINAL_WEIGHT}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="ActualFinalQuantityTextBox" TextChanged="ActualFinalQuantityTextBox_TextChanged" Padding="5,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                        <TextBlock Text="{loc:Loc Key=LABEL_UNITS_COUNT}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="ReleaseUnitsCountTextBox" Text="1" Padding="5,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="5,0,5,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="CalculatedCostLabelTextBlock" Text="Себестоимость (за 1 кг):" FontSize="11" Foreground="Gray"/>
                                        <TextBlock x:Name="CalculatedUnitCostTextBlock" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="Green" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="5,0,0,0">
                                        <TextBlock x:Name="UnitPriceLabelTextBlock" Text="Отпускная цена (за 1 кг):" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="UnitPriceTextBox" Padding="5,4"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="{loc:Loc Key=BTN_RELEASE_AGING}" 
                                        Click="ReleaseFromAging_Click" 
                                        Height="32" 
                                        HorizontalAlignment="Left"
                                        Padding="15,0"
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 3: Брак варки и Акт списания -->
            <TabItem Header="Забраковка и Акт списания">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Забраковка активной варки (в котле)" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Выберите варку в процессе:" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <ComboBox x:Name="DiscardBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Причина забраковки:" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="DiscardReasonTextBox" Text="Закисание партии при формовании" Padding="5,4"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="🗑️ Списать варку в брак" 
                                    Click="DiscardBatch_Click" 
                                    Height="32" 
                                    HorizontalAlignment="Left"
                                    Padding="15,0"
                                    Background="#DC2626" 
                                    Foreground="White" 
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ТАБЛИЦА ЛОТОВ ДЛЯ БРАКОВКИ С ШТУКАМИ -->
                    <GroupBox Grid.Row="1" Header="Забраковка лотов из камер созревания (плесень, порча, брак флипа)" Padding="10">
                        <DataGrid x:Name="DiscardAgingLotsDataGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal" 
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Лот / Партия" Binding="{Binding BatchNumber}" Width="2*"/>
                                <DataGridTextColumn Header="Камера" Binding="{Binding ChamberName}" Width="*"/>
                                <DataGridTextColumn Header="Текущий остаток (кг)" Binding="{Binding InitialQuantity, StringFormat={}{0:N2}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Головок (шт)" Binding="{Binding UnitsCount}" Width="0.8*"/>
                                <DataGridTextColumn Header="Дней на выдержке" Binding="{Binding DaysInChamber}" Width="*"/>
                                <DataGridTemplateColumn Header="Действие" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️ В брак" 
                                                    Click="DiscardAgingLotRow_Click" 
                                                    Tag="{Binding LotId}" 
                                                    Background="#FEE2E2" 
                                                    Foreground="#991B1B" 
                                                    BorderBrush="#FCA5A5" 
                                                    FontWeight="Bold" 
                                                    Padding="6,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=STATUS_READY}" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>