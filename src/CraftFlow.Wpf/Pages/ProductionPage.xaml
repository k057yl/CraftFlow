<Page x:Class="CraftFlow.Wpf.Pages.ProductionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_PRODUCTION}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление Производством и Выдержкой" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1" x:Name="ProductionTabControl">
            <!-- Вкладка 1: Варочный цех -->
            <TabItem Header="1. Варочный цех">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <!-- 1. Запуск варки -->
                        <GroupBox Header="1. Запуск Варочного Процесса" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Наименование / Код партии (Опционально):" Margin="0,0,0,3"/>
                                <TextBox x:Name="BatchNameTextBox" Margin="0,0,0,10" Padding="3"/>

                                <TextBlock Text="Выберите Рецептуру:" Margin="0,0,0,3"/>
                                <ComboBox x:Name="BatchRecipeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10" SelectionChanged="BatchInputs_Changed"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Склад списания сырья:" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="BatchWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="BatchInputs_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Склад зачисления продукции (для сыров без выдержки):" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="DestinationWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Планируемый объём выхода (кг/л):" Margin="0,0,0,3"/>
                                <TextBox x:Name="BatchQuantityTextBox" Text="10" Margin="0,0,0,10" TextChanged="BatchInputs_Changed" Padding="3"/>

                                <!-- Интерактивный калькулятор сырья -->
                                <GroupBox Header="Расчётная потребность и остатки сырья на складе" Margin="0,5,0,10" Padding="8" Background="#F8FAFC">
                                    <StackPanel>
                                        <ListBox x:Name="RequirementsListBox" Height="80" DisplayMemberPath="DisplayInfo" BorderThickness="0" Background="Transparent"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="Предварительная себестоимость сырья:" Foreground="Gray" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="EstimatedCostTextBlock" Text="$ 0.00" FontWeight="Bold" Foreground="Green"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <Button Content="Запустить Варку" Click="StartBatch_Click" Height="30" FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 2. Завершение варки -->
                        <GroupBox Header="2. Завершение Варочного Процесса" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Выберите активную варку (В процессе):" Margin="0,0,0,3"/>
                                <ComboBox x:Name="ActiveBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10" SelectionChanged="ActiveBatchComboBox_SelectionChanged"/>

                                <TextBlock Text="Фактический выход сырной массы / зерна (кг):" Margin="0,0,0,3"/>
                                <TextBox x:Name="ActualOutputQuantityTextBox" Margin="0,0,0,10" Padding="3"/>

                                <!-- Сценарии завершения -->
                                <StackPanel Orientation="Horizontal">
                                    <!-- Сценарий А: Прямой выпуск на склад (без выдержки) -->
                                    <Button x:Name="CompleteBatchButton" Content="Завершить и оприходовать на Склад ГП" Click="CompleteBatch_Click" Height="32" Padding="15,0" Margin="0,0,10,0"/>

                                    <!-- Сценарий Б: Выдержка (Перевод варки в Completed + переход на Таб 2) -->
                                    <Button x:Name="SendToAgingButton" Content="Завершить варку и перенести в Камеру ➔" Click="SendToAging_Click" Height="32" Padding="15,0" Background="#0284C7" Foreground="White" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 3. Анализ себестоимости -->
                        <GroupBox Header="3. Анализ Себестоимости Выбранной Партии" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Общая стоимость сырья:" FontSize="11" Foreground="Gray"/>
                                    <TextBlock x:Name="TotalCostTextBlock" Text="$ 0.00" FontSize="18" FontWeight="Bold" Foreground="Green"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Себестоимость единицы:" FontSize="11" Foreground="Gray"/>
                                    <TextBlock x:Name="UnitCostTextBlock" Text="$ 0.00" FontSize="18" FontWeight="Bold" Foreground="Blue"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 2: Созревание и Аффинаж -->
            <TabItem Header="2. Созревание и Аффинаж">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <!-- Перемещение в камеру -->
                        <GroupBox Header="Размещение партии в Климатической Камере" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Выбор завершённой варки (Готовой к выдержке):" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CompletedBatchesComboBox" 
                              DisplayMemberPath="Name" 
                              SelectedValuePath="Id" 
                              Margin="0,0,0,10" 
                              SelectionChanged="CompletedBatchesComboBox_SelectionChanged"/>

                                <TextBlock Text="Маркировка / Наименование лота на созревании:" Margin="0,0,0,3"/>
                                <TextBox x:Name="AgingLotNameTextBox" Margin="0,0,0,10" Padding="3"/>

                                <TextBlock Text="Выбор Климатической Камеры:" Margin="0,0,0,3"/>
                                <ComboBox x:Name="AgingChambersComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                                <TextBlock Text="Минимальный срок выдержки (дней):" Margin="0,0,0,3"/>
                                <TextBox x:Name="MinAgingDaysTextBox" Text="30" Margin="0,0,0,15" Padding="3"/>

                                <Button Content="Разместить в Камере Созревания" Click="TransferToAging_Click" Height="32" Background="#059669" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Снятие с выдержки -->
                        <GroupBox Header="Снятие с выдержки (Фасовка / Передача на Склад ГП)" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Выберите партию на выдержке (В камере):" Margin="0,0,0,3"/>
                                <ComboBox x:Name="ActiveAgingLotsComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                                <TextBlock Text="Склад зачисления готового сыра:" Margin="0,0,0,3"/>
                                <ComboBox x:Name="TargetWarehousesComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Фактический вес после усушки (кг):" Margin="0,0,0,3"/>
                                        <TextBox x:Name="ActualFinalQuantityTextBox" Padding="3"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Отпускная цена за ед.:" Margin="0,0,0,3"/>
                                        <TextBox x:Name="UnitPriceTextBox" Padding="3"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Выпустить в Продажу на Склад" Click="ReleaseFromAging_Click" Height="32" FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 3: Брак и Списание -->
            <TabItem Header="3. Брак и Списание">
                <Grid Margin="15">
                    <StackPanel>
                        <GroupBox Header="Регистрация брака и утилизация партии" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Выберите бракованную варку / партию:" Margin="0,0,0,3"/>
                                <ComboBox x:Name="DiscardBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                                <TextBlock Text="Причина списания (Брак / Закисание / Плесень):" Margin="0,0,0,3"/>
                                <TextBox x:Name="DiscardReasonTextBox" Text="Закисание партии при формовании" Margin="0,0,0,15" Padding="3"/>

                                <Button Content="❌ Списать партию в утиль (Зафиксировать брак)" Click="DiscardBatch_Click" Height="35" Background="#DC2626" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="ГОТОВО" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>