<Page x:Class="CraftFlow.Wpf.Pages.ProductionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="ProductionPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="{loc:Loc TITLE_PRODUCTION}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- 1. Запуск Варки -->
            <GroupBox Header="{loc:Loc PRODUCTION_BATCHES_START}" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="{loc:Loc SELECT_RECIPE}"/>
                    <ComboBox x:Name="BatchRecipeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5" SelectionChanged="BatchInputs_Changed"/>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{loc:Loc SELECT_WAREHOUSE_RAW}"/>
                            <ComboBox x:Name="BatchWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="BatchInputs_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{loc:Loc SELECT_WAREHOUSE_DESTINATION}"/>
                            <ComboBox x:Name="DestinationWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Loc PLANNED_OUTPUT_QUANTITY}"/>
                    <TextBox x:Name="BatchQuantityTextBox" Text="10" Margin="0,0,0,5" TextChanged="BatchInputs_Changed"/>

                    <!-- Интерактивный калькулятор остатков и потребности -->
                    <GroupBox Header="{loc:Loc CALCULATED_REQUIREMENTS}" Margin="0,5,0,5" Padding="5" Background="#F8FAFC">
                        <StackPanel>
                            <ListBox x:Name="RequirementsListBox" Height="70" DisplayMemberPath="DisplayInfo" BorderThickness="0" Background="Transparent"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{loc:Loc ESTIMATED_BATCH_COST}" Foreground="Gray" Margin="0,0,5,0"/>
                                <TextBlock x:Name="EstimatedCostTextBlock" Text="$ 0.00" FontWeight="Bold" Foreground="Green"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <Button Content="{loc:Loc START_PRODUCTION_BATCH}" Click="StartBatch_Click" Height="25" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 2. Завершить Варку -->
            <GroupBox Header="{loc:Loc COMPLETE_PRODUCTION_BATCH_HEADER}" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="{loc:Loc SELECT_ACTIVE_BATCH}"/>
                    <ComboBox x:Name="ActiveBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5" SelectionChanged="ActiveBatchComboBox_SelectionChanged"/>

                    <TextBlock Text="{loc:Loc ACTUAL_OUTPUT_QUANTITY}"/>
                    <TextBox x:Name="ActualOutputQuantityTextBox" Text="" Margin="0,0,0,5"/>

                    <Button Content="{loc:Loc COMPLETE_PRODUCTION_BATCH}" Click="CompleteBatch_Click" Height="25" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 3. Анализ себестоимости -->
            <GroupBox Header="{loc:Loc BATCH_COST_ANALYSIS}" Margin="0,0,0,10" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc TOTAL_RAW_MATERIAL_COST}" FontSize="11" Foreground="Gray"/>
                        <TextBlock x:Name="TotalCostTextBlock" Text="$ 0.00" FontSize="18" FontWeight="Bold" Foreground="Green"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:Loc UNIT_COST_PER_UNIT}" FontSize="11" Foreground="Gray"/>
                        <TextBlock x:Name="UnitCostTextBlock" Text="$ 0.00" FontSize="18" FontWeight="Bold" Foreground="Blue"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <TextBlock x:Name="StatusTextBlock" Text="READY" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>