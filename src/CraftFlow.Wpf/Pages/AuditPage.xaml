<Page x:Class="CraftFlow.Wpf.Pages.AuditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="AuditPage">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="{loc:Loc SYSTEM_AUDIT_LOGS}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

		<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
			<Button Content="{loc:Loc REFRESH_LOGS}" Click="Refresh_Click" Height="28" Width="120" Margin="0,0,10,0"/>
			<Button Content="{loc:Loc EXPORT_CSV}" Click="ExportCsv_Click" Height="28" Width="120"/>
		</StackPanel>

		<DataGrid Grid.Row="2" x:Name="AuditDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="White">
			<DataGrid.Columns>
				<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
				<DataGridTextColumn Header="{loc:Loc COL_ENTITY_NAME}" Binding="{Binding EntityName}" Width="150"/>
				<DataGridTextColumn Header="{loc:Loc COL_ACTION}" Binding="{Binding Action}" Width="100"/>
				<DataGridTextColumn Header="{loc:Loc COL_DETAILS}" Binding="{Binding Details}" Width="*"/>
				<DataGridTextColumn Header="{loc:Loc COL_CREATED_AT}" Binding="{Binding CreatedAtUtc, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="160"/>
			</DataGrid.Columns>
		</DataGrid>

		<TextBlock Grid.Row="3" x:Name="StatusTextBlock" Text="READY" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
	</Grid>
</Page>