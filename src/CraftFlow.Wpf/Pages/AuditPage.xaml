<Page x:Class="CraftFlow.Wpf.Pages.AuditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:auth="clr-namespace:CraftFlow.Wpf.MarkupExtensions"
      Title="AuditPage">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Key=SYSTEM_AUDIT_LOGS}" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource AppForegroundBrush}"/>

        <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{auth:HasPermission Permission=SETTINGS_MANAGE}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панель Фильтров -->
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,15">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical" Margin="0,0,10,5">
                        <TextBlock Text="{loc:Loc Key=AUDIT_SEARCH_LABEL}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,2"/>
                        <TextBox x:Name="SearchTextBox" Width="180" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,0,10,5">
                        <TextBlock Text="{loc:Loc Key=AUDIT_ACTION_LABEL}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ActionComboBox" Width="120" Height="28" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,0,10,5">
                        <TextBlock Text="{loc:Loc Key=AUDIT_DATE_FROM}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,2"/>
                        <DatePicker x:Name="FromDatePicker" Width="130" Height="28"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,0,10,5">
                        <TextBlock Text="{loc:Loc Key=AUDIT_DATE_TO}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,2"/>
                        <DatePicker x:Name="ToDatePicker" Width="130" Height="28"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,5">
                        <Button Content="{loc:Loc Key=REFRESH_LOGS}" Click="ApplyFilter_Click" Style="{StaticResource PrimaryButtonStyle}" Height="28" Width="100" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Key=BTN_RESET}" Click="ResetFilter_Click" Style="{StaticResource SecondaryButtonStyle}" Height="28" Width="90" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Key=EXPORT_CSV}" Click="ExportCsv_Click" Style="{StaticResource SecondaryButtonStyle}" Height="28" Width="100"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Таблица Логов -->
            <DataGrid Grid.Row="1" x:Name="AuditDataGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="32" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Key=AUDIT_COL_DATETIME}" Binding="{Binding CreatedAtUtc, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}" Width="160"/>
                    <DataGridTextColumn Header="{loc:Loc Key=AUDIT_COL_EMPLOYEE}" Binding="{Binding UserEmail}" Width="220"/>
                    <DataGridTextColumn Header="{loc:Loc Key=AUDIT_COL_ACTION}" Binding="{Binding Action}" Width="120"/>
                    <DataGridTextColumn Header="{loc:Loc Key=AUDIT_COL_DETAILS}" Binding="{Binding Details}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" Text="{loc:Loc Key=STATUS_READY}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>