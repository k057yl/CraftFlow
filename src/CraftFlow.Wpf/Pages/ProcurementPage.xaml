<Page x:Class="CraftFlow.Wpf.Pages.ProcurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_PROCUREMENT}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=TITLE_PROCUREMENT}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AppForegroundBrush}"/>

        <TabControl Grid.Row="1">
            <!-- 1. Приход и Остатки Сырья -->
            <TabItem Header="{loc:Loc Key=TAB_STOCK_RECEIPT}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Форма оприходования -->
                    <GroupBox Grid.Row="0" Header="{loc:Loc Key=GROUP_RECEIVE_STOCK_LOT}" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_SELECT_SUPPLIER}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <ComboBox x:Name="StockSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                    <TextBlock Text="{loc:Loc Key=SELECT_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <ComboBox x:Name="StockWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" SelectionChanged="StockWarehouseComboBox_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="{loc:Loc Key=SELECT_RAW_MATERIAL}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <ComboBox x:Name="StockRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="{loc:Loc Key=LOT_QUANTITY}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBox x:Name="StockQuantityTextBox" Text="500" Height="28" TextChanged="StockQuantityTextBox_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_UNITS_COUNT}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBox x:Name="StockUnitsCountTextBox" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="{loc:Loc Key=UNIT_PRICE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBox x:Name="StockUnitPriceTextBox" Text="25.00" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="4,0,4,0">
                                    <TextBlock Text="{loc:Loc Key=BATCH_NUMBER}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBox x:Name="StockBatchTextBox" Text="BATCH-2026-001" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="4,0,0,0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_EXPIRATION_DATE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <DatePicker x:Name="ExpirationDatePicker" Height="28"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc Key=LABEL_AVAILABLE_CONTAINERS}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" VerticalAlignment="Center"/>
                                <Button Content="{loc:Loc Key=BTN_QUICK_NEW_LOCATION}" Click="QuickCreateLocation_Click" Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Height="24" Padding="8,0" FontSize="10"/>
                            </StackPanel>

                            <!-- Емкости хранилища -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_AVAILABLE_CONTAINERS_HINT}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                                    <ListBox x:Name="AvailableLocationsListBox" Height="90" Background="{DynamicResource AppBackgroundBrush}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="[" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding FreeCapacity, StringFormat={}{0:N0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" / " Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding Capacity, StringFormat={}{0:N0}}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="]" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="+" Click="AddLocationToSelected_Click" Style="{StaticResource PrimaryButtonStyle}" Height="20" Padding="6,0" Margin="6,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_SELECTED_CONTAINERS_HINT}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                                    <ListBox x:Name="SelectedLocationsListBox" Height="90" Background="{DynamicResource AppBackgroundBrush}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="[" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding FreeCapacity, StringFormat={}{0:N0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                                        <TextBlock Text=" / " Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding Capacity, StringFormat={}{0:N0}}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="]" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="✕" Click="RemoveLocationFromSelected_Click" Style="{StaticResource DangerButtonStyle}" Width="20" Height="20" Padding="0" Margin="6,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AddStockLotButton"
                                        Content="{loc:Loc Key=ADD_STOCK_LOT}" 
                                        Click="AddStockLot_Click" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="30" 
                                        Padding="14,0"/>
                                <TextBlock x:Name="CapacityWarningTextBlock" 
                                           VerticalAlignment="Center" 
                                           Margin="15,0,0,0" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Панель текущих остатков -->
                    <GroupBox Grid.Row="1" Header="{loc:Loc Key=GROUP_CURRENT_STOCK}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{loc:Loc Key=LABEL_SUPPLIER_FILTER}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="FilterSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="160" Height="28" SelectionChanged="FilterStockLots_Changed"/>

                                <TextBlock Text="{loc:Loc Key=LABEL_WAREHOUSE_FILTER}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="FilterWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="160" Height="28" SelectionChanged="FilterStockLots_Changed"/>

                                <CheckBox x:Name="FilterExpiringCheckBox" Content="{loc:Loc Key=CHECK_EXPIRING_SOON}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource AppForegroundBrush}" Click="FilterStockLots_Changed"/>

                                <Button Content="{loc:Loc Key=BTN_REFRESH}" Click="RefreshStockLots_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Height="28" Padding="12,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" 
                                      x:Name="StockLotsDataGrid" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" 
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_RAW_MATERIAL}" Binding="{Binding ItemName}" Width="150"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=WAREHOUSE_NAME}" Binding="{Binding WarehouseName}" Width="110"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_STORAGE_CONTAINERS}" Binding="{Binding StorageLocationsInfo}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_SELECT_SUPPLIER}" Binding="{Binding SupplierName}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_REMAINING_STOCK}" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="85"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UNIT_PRICE}" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="85"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="110"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_EXPIRATION_DATE}" Binding="{Binding ExpirationDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 2. Списание / Акты Потерь -->
            <TabItem Header="{loc:Loc Key=TAB_WRITE_OFF}">
                <Grid Margin="10">
                    <GroupBox Header="{loc:Loc Key=GROUP_WRITE_OFF_SELECTION}" Padding="10">
                        <DataGrid x:Name="WriteOffDataGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal" 
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=LABEL_RAW_MATERIAL}" Binding="{Binding ItemName}" Width="150"/>
                                <DataGridTextColumn Header="{loc:Loc Key=WAREHOUSE_NAME}" Binding="{Binding WarehouseName}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Loc Key=LABEL_STORAGE_CONTAINERS}" Binding="{Binding StorageLocationsInfo}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc Key=LABEL_REMAINING_STOCK}" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Loc Key=BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="130"/>
                                <DataGridTemplateColumn Header="{loc:Loc Key=LABEL_ACTION}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Loc Key=BTN_WRITE_OFF}" 
                                                    Click="WriteOffRow_Click" 
                                                    Tag="{Binding Id}" 
                                                    Style="{StaticResource DangerButtonStyle}" 
                                                    Padding="8,3"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 3. Поставщики -->
            <TabItem Header="{loc:Loc Key=TAB_SUPPLIERS}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left" Width="600">
                        <GroupBox Header="{loc:Loc Key=HEADER_SUPPLIERS}" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{loc:Loc Key=SUPPLIER_NAME}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBox x:Name="NameTextBox" Height="28"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="{loc:Loc Key=SUPPLIER_PHONE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBox x:Name="PhoneTextBox" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="{loc:Loc Key=SUPPLIER_EMAIL}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBox x:Name="EmailTextBox" Height="28"/>
                                </StackPanel>

                                <Button Content="{loc:Loc Key=CREATE_SUPPLIER}" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="32"
                                        Padding="14,0"
                                        HorizontalAlignment="Left" 
                                        Click="CreateSupplier_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=STATUS_READY}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>