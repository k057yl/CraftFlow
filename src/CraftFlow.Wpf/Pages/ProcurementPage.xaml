<Page x:Class="CraftFlow.Wpf.Pages.ProcurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:converters="clr-namespace:CraftFlow.Wpf.Services.Converters"
      xmlns:auth="clr-namespace:CraftFlow.Wpf.MarkupExtensions"
      Title="{loc:Loc Key=TITLE_PROCUREMENT}">

    <Page.Resources>
        <converters:SupplierStatusTextConverter x:Key="SupplierStatusTextConverter"/>
        <converters:SupplierStatusStyleConverter x:Key="SupplierStatusStyleConverter"/>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=TITLE_PROCUREMENT}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AppForegroundBrush}"/>

        <TabControl Grid.Row="1">
            <!-- 1. Приход и Остатки Сырья -->
            <TabItem Header="{loc:Loc Key=TAB_STOCK_RECEIPT}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Форма оприходования -->
                    <GroupBox Grid.Row="0" Header="{loc:Loc Key=GROUP_RECEIVE_STOCK_LOT}" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <!-- 1. ВЕРХНИЙ БЛОК -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левая колонка -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_SELECT_SUPPLIER}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <ComboBox x:Name="StockSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,8"/>

                                    <TextBlock Text="{loc:Loc Key=SELECT_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <ComboBox x:Name="StockWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Margin="0,0,0,8" SelectionChanged="StockWarehouseComboBox_SelectionChanged"/>

                                    <TextBlock Text="{loc:Loc Key=SELECT_RAW_MATERIAL}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <ComboBox x:Name="StockRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" SelectionChanged="StockRawMaterialComboBox_SelectionChanged"/>
                                </StackPanel>

                                <!-- Правая колонка -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Loc Key=BATCH_NUMBER}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBox x:Name="StockBatchTextBox" Text="BATCH-2026-001" Height="28" Margin="0,0,0,8"/>

                                    <TextBlock Text="{loc:Loc Key=UNIT_PRICE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBox x:Name="StockUnitPriceTextBox" Text="25.00" Height="28" Margin="0,0,0,8"/>

                                    <TextBlock Text="{loc:Loc Key=LABEL_EXPIRATION_DATE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <DatePicker x:Name="ExpirationDatePicker" Height="28"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2. КНОПКА СОЗДАНИЯ ЕМКОСТЕЙ -->
                            <DockPanel Margin="0,4,0,8">
                                <Button Content="{loc:Loc Key=BTN_QUICK_NEW_LOCATION}" 
                                        Click="QuickCreateLocation_Click" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Height="28" 
                                        Padding="14,0" 
                                        FontSize="11"
                                        HorizontalAlignment="Left"/>
                            </DockPanel>

                            <!-- 3. ЦЕНТРАЛЬНЫЕ БЛОКИ (ЕМКОСТЕЙ) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Доступные емкости -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_AVAILABLE_CONTAINERS_HINT}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                                    <ListBox x:Name="AvailableLocationsListBox" Height="100" Background="{DynamicResource AppBackgroundBrush}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="[" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding FreeCapacity, StringFormat={}{0:N0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" / " Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding Capacity, StringFormat={}{0:N0}}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text=" " Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding UnitOfMeasure}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="]" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="+" Click="AddLocationToSelected_Click" Style="{StaticResource PrimaryButtonStyle}" Height="20" Padding="6,0" Margin="6,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Выбранные емкости -->
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_SELECTED_CONTAINERS_HINT}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,4"/>
                                    <ListBox x:Name="SelectedLocationsListBox" Height="100" Background="{DynamicResource AppBackgroundBrush}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="[" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding FreeCapacity, StringFormat={}{0:N0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                                        <TextBlock Text=" / " Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding Capacity, StringFormat={}{0:N0}}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text=" " Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="{Binding UnitOfMeasure}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                        <TextBlock Text="]" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="✕" Click="RemoveLocationFromSelected_Click" Style="{StaticResource DangerButtonStyle}" Width="20" Height="20" Padding="0" Margin="6,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>

                            <!-- 4. НИЖНИЙ БЛОК -->
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Поле объема -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{loc:Loc Key=LOT_QUANTITY}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="StockQuantityTextBox" Text="500" Height="28" TextChanged="StockQuantityTextBox_TextChanged"/>
                                </StackPanel>

                                <!-- Дропдаун с выбором ЕИ -->
                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="{loc:Loc Key=UI_LABEL_UNIT_OF_MEASURE}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="UnitOfMeasureComboBox" Height="28" SelectedIndex="0" SelectionChanged="UnitOfMeasureComboBox_SelectionChanged">
                                        <ComboBoxItem Content="{loc:Loc Key=UI_UOM_L}" Tag="l"/>
                                        <ComboBoxItem Content="{loc:Loc Key=UI_UOM_ML}" Tag="ml"/>
                                        <ComboBoxItem Content="{loc:Loc Key=UI_UOM_KG}" Tag="kg"/>
                                        <ComboBoxItem Content="{loc:Loc Key=UI_UOM_G}" Tag="g"/>
                                        <ComboBoxItem Content="{loc:Loc Key=UI_UOM_PCS}" Tag="pcs"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Кнопка принять партию -->
                                <Button Grid.Column="2" 
                                        x:Name="AddStockLotButton"
                                        Content="{loc:Loc Key=ADD_STOCK_LOT}" 
                                        Click="AddStockLot_Click" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="28" 
                                        Padding="16,0"
                                        VerticalAlignment="Bottom"/>

                                <!-- Текст валидации -->
                                <TextBlock Grid.Column="3" 
                                           x:Name="CapacityWarningTextBlock" 
                                           VerticalAlignment="Center" 
                                           Margin="15,15,0,0" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Панель текущих остатков -->
                    <GroupBox Grid.Row="1" Header="{loc:Loc Key=GROUP_CURRENT_STOCK}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{loc:Loc Key=LABEL_SUPPLIER_FILTER}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="FilterSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="160" Height="28" SelectionChanged="FilterStockLots_Changed"/>

                                <TextBlock Text="{loc:Loc Key=LABEL_WAREHOUSE_FILTER}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="FilterWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="160" Height="28" SelectionChanged="FilterStockLots_Changed"/>

                                <CheckBox x:Name="FilterExpiringCheckBox" Content="{loc:Loc Key=CHECK_EXPIRING_SOON}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource AppForegroundBrush}" Click="FilterStockLots_Changed"/>

                                <Button Content="{loc:Loc Key=BTN_REFRESH}" Click="RefreshStockLots_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Height="28" Padding="12,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" 
                                      x:Name="StockLotsDataGrid" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" 
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_RAW_MATERIAL}" Binding="{Binding ItemName}" Width="150"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_WAREHOUSE_NAME}" Binding="{Binding WarehouseName}" Width="110"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_STORAGE_CONTAINERS}" Binding="{Binding StorageLocationsInfo}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_SUPPLIER_FILTER}" Binding="{Binding SupplierName}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_REMAINING_STOCK}" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="100"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UNIT_PRICE}" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="85"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="110"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_EXPIRATION_DATE}" Binding="{Binding ExpirationDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 2. Списание / Акты Потерь -->
            <TabItem Header="{loc:Loc Key=TAB_WRITE_OFF}">
                <Grid Margin="10">
                    <GroupBox Header="{loc:Loc Key=GROUP_WRITE_OFF_SELECTION}" Padding="10">
                        <DataGrid x:Name="WriteOffDataGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal" 
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=LABEL_RAW_MATERIAL}" Binding="{Binding ItemName}" Width="150"/>
                                <DataGridTextColumn Header="{loc:Loc Key=UI_COL_WAREHOUSE_NAME}" Binding="{Binding WarehouseName}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Loc Key=LABEL_STORAGE_CONTAINERS}" Binding="{Binding StorageLocationsInfo}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc Key=LABEL_REMAINING_STOCK}" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="100"/>
                                <DataGridTextColumn Header="{loc:Loc Key=BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="130"/>
                                <DataGridTemplateColumn Header="{loc:Loc Key=LABEL_ACTION}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Loc Key=BTN_WRITE_OFF}" 
                                                    Click="WriteOffRow_Click" 
                                                    Tag="{Binding Id}" 
                                                    Style="{StaticResource DangerButtonStyle}" 
                                                    Padding="8,3"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 3. Поставщики -->
            <TabItem x:Name="SuppliersTabItem" 
                     Header="{loc:Loc Key=TAB_SUPPLIERS}"
                     Visibility="{auth:HasPermission Permission=SUPPLIERS_MANAGE}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- СЕКЦИЯ A: ФОРМА -->
                    <GroupBox Grid.Column="0" x:Name="SupplierFormGroupBox" Header="{loc:Loc Key=HEADER_SUPPLIERS}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=SUPPLIER_NAME}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="NameTextBox" Height="28" Margin="0,0,0,8"/>

                                <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_LEGAL_NAME}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="LegalNameTextBox" Height="28" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_TAX_ID}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBox x:Name="TaxIdTextBox" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Loc Key=SUPPLIER_PHONE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBox x:Name="PhoneTextBox" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{loc:Loc Key=SUPPLIER_EMAIL}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="EmailTextBox" Height="28" Margin="0,0,0,8"/>

                                <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_ADDRESS}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="AddressTextBox" Height="28" Margin="0,0,0,8"/>

                                <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_NOTES}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="NotesTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SaveSupplierButton" 
                                            Content="{loc:Loc Key=CREATE_SUPPLIER}" 
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="32"
                                            Padding="16,0"
                                            Click="SaveSupplier_Click"/>

                                    <Button x:Name="ResetFormButton" 
                                            Content="{loc:Loc Key=UI_BTN_RESET}" 
                                            Visibility="Collapsed"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            Click="ResetSupplierForm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- СЕКЦИЯ B: ТАБЛИЦА С ПОСТАВЩИКАМИ -->
                    <GroupBox Grid.Column="2" Header="{loc:Loc Key=UI_HEADER_SUPPLIERS_REGISTRY}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="ShowInactiveSuppliersCheckBox" 
                                      Content="{loc:Loc Key=UI_CHECK_SHOW_INACTIVE_SUPPLIERS}" 
                                      Visibility="{auth:HasPermission Permission=SUPPLIERS_MANAGE}"
                                      Margin="0,0,0,10" 
                                      Foreground="{DynamicResource AppForegroundBrush}"
                                      Click="ShowInactiveSuppliers_Click"/>

                            <DataGrid Grid.Row="1"
                                      x:Name="SuppliersDataGrid" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" 
                                      HeadersVisibility="Column"
                                      MouseDoubleClick="SuppliersDataGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_NAME}" Binding="{Binding Name}" Width="140"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_LEGAL_NAME}" Binding="{Binding LegalName}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_TAX_ID}" Binding="{Binding TaxId}" Width="90"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_PHONE}" Binding="{Binding Phone}" Width="100"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_EMAIL}" Binding="{Binding Email}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_ADDRESS}" Binding="{Binding Address}" Width="*"/>

                                    <DataGridTemplateColumn x:Name="SupplierActionsColumn" Header="{loc:Loc Key=LABEL_ACTION}" Width="170" Visibility="{auth:HasPermission Permission=SUPPLIERS_MANAGE}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="✏️" 
                                                            ToolTip="{loc:Loc Key=UI_TOOLTIP_EDIT}"
                                                            Click="EditSupplierRow_Click" 
                                                            Tag="{Binding}" 
                                                            Style="{StaticResource SecondaryButtonStyle}" 
                                                            Height="24" Width="28" Padding="0" Margin="0,0,5,0"/>

                                                    <Button Content="{Binding IsActive, Converter={StaticResource SupplierStatusTextConverter}}" 
                                                            Click="ToggleSupplierActive_Click" 
                                                            Tag="{Binding}" 
                                                            Style="{Binding IsActive, Converter={StaticResource SupplierStatusStyleConverter}}" 
                                                            Height="24" Padding="8,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=UI_STATUS_READY}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>