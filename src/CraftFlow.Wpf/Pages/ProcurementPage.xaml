<Page x:Class="CraftFlow.Wpf.Pages.ProcurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:converters="clr-namespace:CraftFlow.Wpf.Services.Converters"
      xmlns:auth="clr-namespace:CraftFlow.Wpf.MarkupExtensions"
      Title="{loc:Loc Key=TITLE_PROCUREMENT}">

    <Page.Resources>
        <converters:SupplierStatusTextConverter x:Key="SupplierStatusTextConverter"/>
        <converters:SupplierStatusStyleConverter x:Key="SupplierStatusStyleConverter"/>
    </Page.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=TITLE_PROCUREMENT}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource AppForegroundBrush}"/>

        <TabControl Grid.Row="1">
            <!-- 1. Приход и Остатки Сырья -->
            <TabItem Header="{loc:Loc Key=TAB_STOCK_RECEIPT}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Форма пакетного оприходования (Накладная) -->
                    <GroupBox Grid.Row="0" Header="{loc:Loc Key=GROUP_RECEIVE_STOCK_LOT}" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 1. ШАПКА НАКЛАДНОЙ -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_SELECT_SUPPLIER}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <ComboBox x:Name="StockSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Loc Key=SELECT_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <ComboBox x:Name="StockWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" SelectionChanged="StockWarehouseComboBox_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="№ Накладной / Партия по умолч." Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                    <TextBox x:Name="InvoiceNumberTextBox" Text="INV-2026-001" Height="28"/>
                                </StackPanel>

                                <!-- Задел под парсер Excel/PDF -->
                                <Button Grid.Column="6"
                                        Content="📥 Импорт Excel / PDF"
                                        Click="ImportInvoiceFile_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="28"
                                        Padding="12,0"
                                        VerticalAlignment="Bottom"
                                        ToolTip="Загрузить позиции из файла накладной"/>
                            </Grid>

                            <!-- 2. СТРОКА БЫСТРОГО ВВОДА ПОЗИЦИИ -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Сырьё (с поиском по вводу текста) -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc Key=SELECT_RAW_MATERIAL}" Margin="0,0,0,2" FontSize="10" Foreground="{DynamicResource AppForegroundBrush}"/>
                                            <ComboBox x:Name="StockRawMaterialComboBox"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      IsEditable="True"
                                                      StaysOpenOnEdit="True"
                                                      Height="28"
                                                      SelectionChanged="StockRawMaterialComboBox_SelectionChanged"/>
                                        </StackPanel>

                                        <!-- Количество -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc Key=LOT_QUANTITY}" Margin="0,0,0,2" FontSize="10" Foreground="{DynamicResource AppForegroundBrush}"/>
                                            <TextBox x:Name="StockQuantityTextBox" Height="28" TextChanged="StockQuantityTextBox_TextChanged" KeyDown="DraftInput_KeyDown"/>
                                        </StackPanel>

                                        <!-- ЕИ -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="{loc:Loc Key=UI_LABEL_UNIT_OF_MEASURE}" Margin="0,0,0,2" FontSize="10" Foreground="{DynamicResource AppForegroundBrush}"/>
                                            <ComboBox x:Name="UnitOfMeasureComboBox" Height="28" SelectedIndex="0" SelectionChanged="UnitOfMeasureComboBox_SelectionChanged">
                                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_L}" Tag="l"/>
                                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_ML}" Tag="ml"/>
                                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_KG}" Tag="kg"/>
                                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_G}" Tag="g"/>
                                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_PCS}" Tag="pcs"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Цена -->
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="{loc:Loc Key=UNIT_PRICE}" Margin="0,0,0,2" FontSize="10" Foreground="{DynamicResource AppForegroundBrush}"/>
                                            <TextBox x:Name="StockUnitPriceTextBox" Height="28" KeyDown="DraftInput_KeyDown"/>
                                        </StackPanel>

                                        <!-- Партия -->
                                        <StackPanel Grid.Column="8">
                                            <TextBlock Text="{loc:Loc Key=BATCH_NUMBER}" Margin="0,0,0,2" FontSize="10" Foreground="{DynamicResource AppForegroundBrush}"/>
                                            <TextBox x:Name="StockBatchTextBox" Height="28" KeyDown="DraftInput_KeyDown"/>
                                        </StackPanel>

                                        <!-- Годен до -->
                                        <StackPanel Grid.Column="10">
                                            <TextBlock Text="{loc:Loc Key=LABEL_EXPIRATION_DATE}" Margin="0,0,0,2" FontSize="10" Foreground="{DynamicResource AppForegroundBrush}"/>
                                            <DatePicker x:Name="ExpirationDatePicker" Height="28"/>
                                        </StackPanel>

                                        <!-- Добавить в буфер -->
                                        <Button Grid.Column="12"
                                                x:Name="AddDraftLineButton"
                                                Content="+ В список"
                                                Click="AddDraftLine_Click"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="28"
                                                Padding="12,0"
                                                VerticalAlignment="Bottom"/>
                                    </Grid>

                                    <!-- Опциональный выбор ёмкостей под текущую позицию -->
                                    <Expander Grid.Row="1" Header="Распределить по ёмкостям / таре (опционально)" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}">
                                        <StackPanel Margin="0,6,0,0">
                                            <DockPanel Margin="0,0,0,6">
                                                <Button Content="{loc:Loc Key=BTN_QUICK_NEW_LOCATION}"
                                                        Click="QuickCreateLocation_Click"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Height="24"
                                                        Padding="10,0"
                                                        FontSize="11"
                                                        HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="CapacityWarningTextBlock"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"/>
                                            </DockPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <ListBox Grid.Column="0" x:Name="AvailableLocationsListBox" Height="75" Margin="0,0,4,0" Background="{DynamicResource AppBackgroundBrush}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                                    <TextBlock Text="{Binding FreeCapacity, StringFormat=[{0:N0}}" Foreground="{DynamicResource AccentBrush}"/>
                                                                    <TextBlock Text="{Binding Capacity, StringFormat= / {0:N0}]}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="+" Click="AddLocationToSelected_Click" Style="{StaticResource PrimaryButtonStyle}" Height="18" Padding="6,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <ListBox Grid.Column="1" x:Name="SelectedLocationsListBox" Height="75" Margin="4,0,0,0" Background="{DynamicResource AppBackgroundBrush}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                                    <TextBlock Text="{Binding FreeCapacity, StringFormat=[{0:N0}}" Foreground="{DynamicResource AccentBrush}"/>
                                                                    <TextBlock Text="{Binding Capacity, StringFormat= / {0:N0}]}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="✕" Click="RemoveLocationFromSelected_Click" Style="{StaticResource DangerButtonStyle}" Width="18" Height="18" Padding="0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </Grid>
                            </Border>

                            <!-- 3. БУФЕРНАЯ ТАБЛИЦА ПОЗИЦИЙ НАКЛАДНОЙ -->
                            <DataGrid x:Name="ReceiptDraftDataGrid"
                                      MaxHeight="190"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      CellEditEnding="ReceiptDraftDataGrid_CellEditEnding"
                                      Margin="0,0,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_RAW_MATERIAL}" Binding="{Binding ItemName}" IsReadOnly="True" Width="2*"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LOT_QUANTITY}" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="95"/>
                                    <DataGridTextColumn Header="ЕИ" Binding="{Binding UnitOfMeasureDisplay}" IsReadOnly="True" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UNIT_PRICE}" Binding="{Binding UnitPrice, StringFormat={}{0:0.##}}" Width="95"/>
                                    <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat={}{0:C2}}" IsReadOnly="True" Width="105"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="125"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_EXPIRATION_DATE}" Binding="{Binding ExpirationDate, StringFormat={}{0:dd.MM.yyyy}}" IsReadOnly="True" Width="95"/>
                                    <DataGridTextColumn Header="Тара" Binding="{Binding StorageLocationsDisplay}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Width="45">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕"
                                                        Click="RemoveDraftLine_Click"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Width="22" Height="22" Padding="0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 4. ИТОГИ И ОТПРАВКА НАКЛАДНОЙ -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           x:Name="DraftSummaryTextBlock"
                                           Text="Позиций в накладной: 0 | Итого: $0.00"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppForegroundBrush}"/>

                                <Button Grid.Column="1"
                                        Content="Очистить список"
                                        Click="ClearDraftLines_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="30"
                                        Padding="12,0"
                                        Margin="0,0,8,0"/>

                                <Button Grid.Column="2"
                                        x:Name="SubmitReceiptBatchButton"
                                        Content="✔ Оприходовать накладную"
                                        Click="SubmitReceiptBatch_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="30"
                                        Padding="18,0"
                                        IsEnabled="False"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- Панель текущих остатков (без изменений) -->
                    <GroupBox Grid.Row="1" Header="{loc:Loc Key=GROUP_CURRENT_STOCK}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{loc:Loc Key=LABEL_SUPPLIER_FILTER}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="FilterSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="160" Height="28" SelectionChanged="FilterStockLots_Changed"/>

                                <TextBlock Text="{loc:Loc Key=LABEL_WAREHOUSE_FILTER}" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="FilterWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="160" Height="28" SelectionChanged="FilterStockLots_Changed"/>

                                <CheckBox x:Name="FilterExpiringCheckBox" Content="{loc:Loc Key=CHECK_EXPIRING_SOON}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource AppForegroundBrush}" Click="FilterStockLots_Changed"/>

                                <Button Content="{loc:Loc Key=BTN_REFRESH}" Click="RefreshStockLots_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Height="28" Padding="12,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" 
                                      x:Name="StockLotsDataGrid" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" 
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_RAW_MATERIAL}" Binding="{Binding ItemName}" Width="150"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_WAREHOUSE_NAME}" Binding="{Binding WarehouseName}" Width="110"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_STORAGE_CONTAINERS}" Binding="{Binding StorageLocationsInfo}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_SUPPLIER_FILTER}" Binding="{Binding SupplierName}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_REMAINING_STOCK}" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="100"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UNIT_PRICE}" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="85"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="110"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=LABEL_EXPIRATION_DATE}" Binding="{Binding ExpirationDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 2. Списание / Акты Потерь -->
            <TabItem Header="{loc:Loc Key=TAB_WRITE_OFF}">
                <Grid Margin="10">
                    <GroupBox Header="{loc:Loc Key=GROUP_WRITE_OFF_SELECTION}" Padding="10">
                        <DataGrid x:Name="WriteOffDataGrid" 
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  GridLinesVisibility="Horizontal" 
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Key=LABEL_RAW_MATERIAL}" Binding="{Binding ItemName}" Width="150"/>
                                <DataGridTextColumn Header="{loc:Loc Key=UI_COL_WAREHOUSE_NAME}" Binding="{Binding WarehouseName}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Loc Key=LABEL_STORAGE_CONTAINERS}" Binding="{Binding StorageLocationsInfo}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc Key=LABEL_REMAINING_STOCK}" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="100"/>
                                <DataGridTextColumn Header="{loc:Loc Key=BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="130"/>
                                <DataGridTemplateColumn Header="{loc:Loc Key=LABEL_ACTION}" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{loc:Loc Key=BTN_WRITE_OFF}" 
                                                    Click="WriteOffRow_Click" 
                                                    Tag="{Binding Id}" 
                                                    Style="{StaticResource DangerButtonStyle}" 
                                                    Padding="8,3"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 3. Поставщики -->
            <TabItem x:Name="SuppliersTabItem" 
                     Header="{loc:Loc Key=TAB_SUPPLIERS}"
                     Visibility="{auth:HasPermission Permission=SUPPLIERS_MANAGE}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- СЕКЦИЯ A: ФОРМА -->
                    <GroupBox Grid.Column="0" x:Name="SupplierFormGroupBox" Header="{loc:Loc Key=HEADER_SUPPLIERS}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=SUPPLIER_NAME}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="NameTextBox" Height="28" Margin="0,0,0,8"/>

                                <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_LEGAL_NAME}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="LegalNameTextBox" Height="28" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_TAX_ID}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBox x:Name="TaxIdTextBox" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Loc Key=SUPPLIER_PHONE}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        <TextBox x:Name="PhoneTextBox" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{loc:Loc Key=SUPPLIER_EMAIL}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="EmailTextBox" Height="28" Margin="0,0,0,8"/>

                                <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_ADDRESS}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="AddressTextBox" Height="28" Margin="0,0,0,8"/>

                                <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_NOTES}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="NotesTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="SaveSupplierButton" 
                                            Content="{loc:Loc Key=CREATE_SUPPLIER}" 
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="32"
                                            Padding="16,0"
                                            Click="SaveSupplier_Click"/>

                                    <Button x:Name="ResetFormButton" 
                                            Content="{loc:Loc Key=UI_BTN_RESET}" 
                                            Visibility="Collapsed"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Padding="12,0"
                                            Click="ResetSupplierForm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- СЕКЦИЯ B: ТАБЛИЦА С ПОСТАВЩИКАМИ -->
                    <GroupBox Grid.Column="2" Header="{loc:Loc Key=UI_HEADER_SUPPLIERS_REGISTRY}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="ShowInactiveSuppliersCheckBox" 
                                      Content="{loc:Loc Key=UI_CHECK_SHOW_INACTIVE_SUPPLIERS}" 
                                      Visibility="{auth:HasPermission Permission=SUPPLIERS_MANAGE}"
                                      Margin="0,0,0,10" 
                                      Foreground="{DynamicResource AppForegroundBrush}"
                                      Click="ShowInactiveSuppliers_Click"/>

                            <DataGrid Grid.Row="1"
                                      x:Name="SuppliersDataGrid" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" 
                                      HeadersVisibility="Column"
                                      MouseDoubleClick="SuppliersDataGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_NAME}" Binding="{Binding Name}" Width="140"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_LEGAL_NAME}" Binding="{Binding LegalName}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_TAX_ID}" Binding="{Binding TaxId}" Width="90"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_PHONE}" Binding="{Binding Phone}" Width="100"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_EMAIL}" Binding="{Binding Email}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_ADDRESS}" Binding="{Binding Address}" Width="*"/>

                                    <DataGridTemplateColumn x:Name="SupplierActionsColumn" Header="{loc:Loc Key=LABEL_ACTION}" Width="170" Visibility="{auth:HasPermission Permission=SUPPLIERS_MANAGE}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="✏️" 
                                                            ToolTip="{loc:Loc Key=UI_TOOLTIP_EDIT}"
                                                            Click="EditSupplierRow_Click" 
                                                            Tag="{Binding}" 
                                                            Style="{StaticResource SecondaryButtonStyle}" 
                                                            Height="24" Width="28" Padding="0" Margin="0,0,5,0"/>

                                                    <Button Content="{Binding IsActive, Converter={StaticResource SupplierStatusTextConverter}}" 
                                                            Click="ToggleSupplierActive_Click" 
                                                            Tag="{Binding}" 
                                                            Style="{Binding IsActive, Converter={StaticResource SupplierStatusStyleConverter}}" 
                                                            Height="24" Padding="8,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=UI_STATUS_READY}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>