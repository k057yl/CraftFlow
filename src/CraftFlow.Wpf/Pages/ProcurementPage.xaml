<Page x:Class="CraftFlow.Wpf.Pages.ProcurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_PROCUREMENT}">

	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Text="{loc:Loc Key=TITLE_PROCUREMENT}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

		<TabControl Grid.Row="1">
			<!-- 1. Оприходование -->
			<TabItem Header="1. Оприходование сырья">
				<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
					<StackPanel>
						<GroupBox Header="Принять партию сырья на склад" Padding="10">
							<StackPanel>
								<TextBlock Text="Выбор Поставщика:" Margin="0,0,0,3"/>
								<ComboBox x:Name="StockSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

								<TextBlock Text="{loc:Loc Key=SELECT_WAREHOUSE}" Margin="0,0,0,3"/>
								<ComboBox x:Name="StockWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

								<TextBlock Text="{loc:Loc Key=SELECT_RAW_MATERIAL}" Margin="0,0,0,3"/>
								<ComboBox x:Name="StockRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

								<Grid Margin="0,0,0,10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0" Margin="0,0,5,0">
										<TextBlock Text="{loc:Loc Key=LOT_QUANTITY}" Margin="0,0,0,3"/>
										<TextBox x:Name="StockQuantityTextBox" Text="500" Padding="3"/>
									</StackPanel>
									<StackPanel Grid.Column="1" Margin="5,0,0,0">
										<TextBlock Text="{loc:Loc Key=UNIT_PRICE}" Margin="0,0,0,3"/>
										<TextBox x:Name="StockUnitPriceTextBox" Text="25.00" Padding="3"/>
									</StackPanel>
								</Grid>

								<TextBlock Text="{loc:Loc Key=BATCH_NUMBER}" Margin="0,0,0,3"/>
								<TextBox x:Name="StockBatchTextBox" Text="BATCH-2026-001" Margin="0,0,0,15" Padding="3"/>

								<Button Content="{loc:Loc Key=ADD_STOCK_LOT}" Click="AddStockLot_Click" Height="30"/>
							</StackPanel>
						</GroupBox>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<!-- 2. Поставщики -->
			<TabItem Header="2. Поставщики сырья">
				<Grid Margin="15">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
						<TextBlock Text="{loc:Loc Key=SUPPLIER_NAME}" Width="150" VerticalAlignment="Center"/>
						<TextBox x:Name="NameTextBox" Width="250" Padding="5"/>
					</StackPanel>

					<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
						<TextBlock Text="{loc:Loc Key=SUPPLIER_PHONE}" Width="150" VerticalAlignment="Center"/>
						<TextBox x:Name="PhoneTextBox" Width="250" Padding="5"/>
					</StackPanel>

					<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
						<TextBlock Text="{loc:Loc Key=SUPPLIER_EMAIL}" Width="150" VerticalAlignment="Center"/>
						<TextBox x:Name="EmailTextBox" Width="250" Padding="5"/>
					</StackPanel>

					<Button Grid.Row="3" Content="{loc:Loc Key=CREATE_SUPPLIER}" Width="180" HorizontalAlignment="Left" Padding="10,5" Click="CreateSupplier_Click"/>
				</Grid>
			</TabItem>
		</TabControl>

		<TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="READY" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
	</Grid>
</Page>