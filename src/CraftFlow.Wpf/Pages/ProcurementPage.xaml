<Page x:Class="CraftFlow.Wpf.Pages.ProcurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_PROCUREMENT}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=TITLE_PROCUREMENT}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1">
            <!-- 1. Закупки и Остатки Сырья -->
            <TabItem Header="Оприходование и Остатки">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Форма оприходования -->
                    <GroupBox Grid.Row="0" Header="{loc:Loc Key=GROUP_RECEIVE_STOCK_LOT}" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{loc:Loc Key=LABEL_SELECT_SUPPLIER}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <ComboBox x:Name="StockSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="4,3"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                    <TextBlock Text="{loc:Loc Key=SELECT_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <ComboBox x:Name="StockWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="4,3" SelectionChanged="StockWarehouseComboBox_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="{loc:Loc Key=SELECT_RAW_MATERIAL}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <ComboBox x:Name="StockRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="4,3"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="{loc:Loc Key=LOT_QUANTITY}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="StockQuantityTextBox" Text="500" Padding="4,3" TextChanged="StockQuantityTextBox_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="Кол-во тар / мест (опц.)" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="StockUnitsCountTextBox" Padding="4,3"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="{loc:Loc Key=UNIT_PRICE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="StockUnitPriceTextBox" Text="25.00" Padding="4,3"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="4,0,4,0">
                                    <TextBlock Text="{loc:Loc Key=BATCH_NUMBER}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="StockBatchTextBox" Text="BATCH-2026-001" Padding="4,3"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="4,0,0,0">
                                    <TextBlock Text="Срок годности" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <DatePicker x:Name="ExpirationDatePicker" Padding="4,1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Блок двух списков: Доступные и Выбранные Ёмкости -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Доступные емкости -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Доступные ёмкости на складе (нажмите +, чтобы добавить):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ListBox x:Name="AvailableLocationsListBox" Height="90" Background="#F8FAFC">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                        <TextBlock Text="[Свободно: " Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding FreeCapacity, StringFormat={}{0:N0}}" Foreground="#0EA5E9" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" из " Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Capacity, StringFormat={}{0:N0}}" Foreground="#64748B"/>
                                                        <TextBlock Text=" л]" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="➕" Click="AddLocationToSelected_Click" Padding="4,1" Margin="6,0,0,0" Background="#0EA5E9" Foreground="White"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Выбранные емкости -->
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Выбранные ёмкости под эту партию:" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                                    <ListBox x:Name="SelectedLocationsListBox" Height="90" Background="#F1F5F9">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,6,0"/>
                                                        <TextBlock Text="[Доступно под приход: " Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding FreeCapacity, StringFormat={}{0:N0}}" Foreground="#16A34A" FontWeight="Bold"/>
                                                        <TextBlock Text=" из " Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Capacity, StringFormat={}{0:N0}}" Foreground="#64748B"/>
                                                        <TextBlock Text=" л]" Foreground="#64748B"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="❌" Click="RemoveLocationFromSelected_Click" Padding="4,1" Margin="6,0,0,0" Background="Transparent" Foreground="#DC2626" BorderThickness="0" FontWeight="Bold"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>

                            <!-- Предупреждение о вместимости и кнопка -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Button x:Name="AddStockLotButton"
                                        Content="{loc:Loc Key=ADD_STOCK_LOT}" 
                                        Click="AddStockLot_Click" 
                                        Height="28" 
                                        Width="160" 
                                        FontWeight="Bold" 
                                        Background="#0284C7" 
                                        Foreground="White"/>
                                <TextBlock x:Name="CapacityWarningTextBlock" 
                                           VerticalAlignment="Center" 
                                           Margin="15,0,0,0" 
                                           FontWeight="SemiBold" 
                                           FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Панель остатков со списанием -->
                    <GroupBox Grid.Row="1" Header="Текущие остатки сырья на складах" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Форма ручного списания -->
                            <Border Grid.Row="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Списание порчи / брака:" FontWeight="Bold" Foreground="#991B1B" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <TextBlock Text="Партия:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                        <ComboBox x:Name="WriteOffStockLotComboBox" DisplayMemberPath="BatchNumber" SelectedValuePath="Id" Width="180" Padding="4,2"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <TextBlock Text="Кол-во:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                        <TextBox x:Name="WriteOffQuantityTextBox" Width="70" Padding="4,2"/>
                                    </StackPanel>

                                    <Button Content="Списать" Click="WriteOffStockLot_Click" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="12,3"/>
                                </WrapPanel>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Поставщик:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                <ComboBox x:Name="FilterSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="160" SelectionChanged="FilterStockLots_Changed"/>

                                <TextBlock Text="Склад:" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="11"/>
                                <ComboBox x:Name="FilterWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Width="160" SelectionChanged="FilterStockLots_Changed"/>

                                <CheckBox x:Name="FilterExpiringCheckBox" Content="Только скоро просрочится" VerticalAlignment="Center" Margin="12,0,0,0" Click="FilterStockLots_Changed"/>

                                <Button Content="Обновить" Click="RefreshStockLots_Click" Margin="12,0,0,0" Padding="8,2"/>
                            </StackPanel>

                            <DataGrid Grid.Row="2" 
                                      x:Name="StockLotsDataGrid" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" 
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Сырьё / Материал" Binding="{Binding ItemName}" Width="150"/>
                                    <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseName}" Width="110"/>
                                    <DataGridTextColumn Header="Емкости хранения" Binding="{Binding StorageLocationsInfo}" Width="*"/>
                                    <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="120"/>
                                    <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="85"/>
                                    <DataGridTextColumn Header="Цена за ед." Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="85"/>
                                    <DataGridTextColumn Header="Партия" Binding="{Binding BatchNumber}" Width="110"/>
                                    <DataGridTextColumn Header="Срок годности" Binding="{Binding ExpirationDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️" 
                                                        Click="WriteOffRow_Click" 
                                                        Tag="{Binding Id}" 
                                                        Background="Transparent" 
                                                        BorderThickness="0" 
                                                        ToolTip="Списать полностью"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 2. Поставщики -->
            <TabItem Header="{loc:Loc Key=TAB_SUPPLIERS}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left" Width="600">
                        <GroupBox Header="{loc:Loc Key=HEADER_SUPPLIERS}" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{loc:Loc Key=SUPPLIER_NAME}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="NameTextBox" Padding="5,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="{loc:Loc Key=SUPPLIER_PHONE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                        <TextBox x:Name="PhoneTextBox" Padding="5,4"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="{loc:Loc Key=SUPPLIER_EMAIL}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                    <TextBox x:Name="EmailTextBox" Padding="5,4"/>
                                </StackPanel>

                                <Button Content="{loc:Loc Key=CREATE_SUPPLIER}" 
                                        Width="180" 
                                        Height="32"
                                        HorizontalAlignment="Left" 
                                        FontWeight="Bold"
                                        Click="CreateSupplier_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=STATUS_READY}" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>