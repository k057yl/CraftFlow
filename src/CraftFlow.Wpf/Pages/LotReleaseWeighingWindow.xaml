<Window x:Class="CraftFlow.Wpf.Pages.Production.Windows.LotReleaseWeighingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Взвешивание и Маркировка Головок" Height="600" Width="850"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F1F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка партии -->
        <Border Grid.Row="0" Background="White" Padding="12" CornerRadius="8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="LotNameTextBlock" Text="Партия: " FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="ChamberInfoTextBlock" Text="Камера: " FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Основная часть: Таблица головок + Итоги -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица взвешивания конкретных головок -->
            <GroupBox Grid.Column="0" Header="Поштучное взвешивание головок" Padding="5" Background="White" Margin="0,0,8,0">
                <DataGrid x:Name="ItemsDataGrid" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          CellEditEnding="ItemsDataGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ / Маркировка" 
                                            Binding="{Binding ItemCode}" 
                                            IsReadOnly="True" 
                                            Width="1.5*"/>

                        <DataGridTextColumn Header="Вес (кг)" 
                                            Binding="{Binding Weight, StringFormat={}{0:N3}, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="1*"/>

                        <DataGridCheckBoxColumn Header="Брак?" 
                                                Binding="{Binding IsDiscarded, UpdateSourceTrigger=PropertyChanged}" 
                                                Width="0.6*">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <EventSetter Event="Click" Handler="CheckBox_Click"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Боковая панель: Итоги и Детали продажи -->
            <StackPanel Grid.Column="1">
                <GroupBox Header="Сводка по партии" Padding="10" Background="White" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Количество головок:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="TotalUnitsTextBlock" Text="0 шт" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>

                        <TextBlock Text="Общий фактический вес:" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="TotalWeightTextBlock" Text="0.000 кг" FontSize="22" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,8"/>

                        <TextBlock Text="Себестоимость (1 кг):" FontSize="11" Foreground="#64748B"/>
                        <TextBlock x:Name="CalculatedCostTextBlock" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Параметры продажи" Padding="10" Background="White">
                    <StackPanel>
                        <TextBlock Text="Цена продажи за 1 кг:" FontSize="11" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBox x:Name="UnitPriceTextBox" FontSize="15" Padding="4" Margin="0,0,0,10"/>

                        <CheckBox x:Name="AutoPrintCheckBox" Content="Печать этикетки на каждую головку" IsChecked="True" FontWeight="SemiBold"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- Подвал -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Width="100" Height="32" Background="#94A3B8" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="Подтвердить и Снять" Click="Confirm_Click" Width="180" Height="32" Background="#16A34A" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>