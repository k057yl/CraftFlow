<Page x:Class="CraftFlow.Wpf.Pages.MrpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc TITLE_MRP}">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Text="{loc:Loc TITLE_MRP}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

		<Button Content="{loc:Loc CALCULATE_MRP}" Click="CalculateMrp_Click" Grid.Row="1" Width="200" HorizontalAlignment="Left" Margin="0,0,0,15" Padding="10,5"/>

		<DataGrid Grid.Row="2" x:Name="MrpDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,15">
			<DataGrid.Columns>
				<DataGridTextColumn Header="{loc:Loc RAW_MATERIAL_NAME}" Binding="{Binding RawMaterialName}" Width="*"/>
				<DataGridTextColumn Header="{loc:Loc QUANTITY}" Binding="{Binding TotalRequiredQuantity, StringFormat={}{0:N2}}" Width="140"/>
				<DataGridTextColumn Header="{loc:Loc AVAILABLE_STOCK}" Binding="{Binding CurrentStockQuantity, StringFormat={}{0:N2}}" Width="140"/>
				<DataGridTextColumn Header="{loc:Loc CALCULATED_REQUIREMENTS}" Binding="{Binding ShortageQuantity, StringFormat={}{0:N2}}" Width="160"/>
			</DataGrid.Columns>
		</DataGrid>

		<TextBlock x:Name="StatusTextBlock" Grid.Row="3" Text="READY" Foreground="Blue" FontWeight="Bold"/>
	</Grid>
</Page>