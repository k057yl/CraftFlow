<Page x:Class="CraftFlow.Wpf.Pages.Subscriptions.ModulePreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=UI_SUB_PREVIEW_PAGE_TITLE}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="30">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc Key=UI_SUB_PREVIEW_BADGE}" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                </Border>

                <TextBlock x:Name="ModuleTitleText"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppForegroundBrush}"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="ModuleSubtitleText"
                           FontSize="14"
                           Foreground="{DynamicResource AppForegroundBrush}"
                           Opacity="0.8"
                           TextWrapping="Wrap"
                           Margin="0,0,0,22"/>

                <!-- Что входит в модуль -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=UI_SUB_PREVIEW_WHAT_AUTOMATES}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppForegroundBrush}"
                                   Margin="0,0,0,12"/>

                        <ItemsControl x:Name="CapabilitiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="✓" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource AppForegroundBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Кнопка перехода в тарифы -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc Key=UI_SUB_PREVIEW_BTN_CONNECT}"
                            Click="GoToPlans_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="38"
                            Padding="20,0"
                            FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>