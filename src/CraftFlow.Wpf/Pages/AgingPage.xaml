<Page x:Class="CraftFlow.Wpf.Pages.AgingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc TITLE_AGING}">

	<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
		<StackPanel>
			<TextBlock Text="{loc:Loc TITLE_AGING}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

			<!-- 1. Отправка варки на созревание -->
			<GroupBox Header="{loc:Loc HEADER_AGING_CHAMBERS}" Margin="0,0,0,15" Padding="10">
				<StackPanel>
					<TextBlock Text="{loc:Loc SELECT_ACTIVE_BATCH}"/>
					<ComboBox x:Name="CompletedBatchesComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

					<TextBlock Text="{loc:Loc HEADER_AGING_CHAMBERS}"/>
					<ComboBox x:Name="AgingChambersComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

					<TextBlock Text="{loc:Loc LOT_QUANTITY}"/>
					<TextBox x:Name="MinAgingDaysTextBox" Text="30" Margin="0,0,0,15"/>

					<Button Content="{loc:Loc TRANSFER_TO_AGING}" Click="TransferToAging_Click" Height="30"/>
				</StackPanel>
			</GroupBox>

			<!-- 2. Снятие с выдержки (В продажу) -->
			<GroupBox Header="{loc:Loc HEADER_AGING_LOTS}" Margin="0,0,0,15" Padding="10">
				<StackPanel>
					<TextBlock Text="{loc:Loc BATCH_NUMBER}"/>
					<ComboBox x:Name="ActiveAgingLotsComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

					<TextBlock Text="{loc:Loc SELECT_WAREHOUSE_DESTINATION}"/>
					<ComboBox x:Name="TargetWarehousesComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

					<TextBlock Text="{loc:Loc ACTUAL_OUTPUT_QUANTITY}"/>
					<TextBox x:Name="ActualFinalQuantityTextBox" Margin="0,0,0,10"/>

					<TextBlock Text="{loc:Loc UNIT_PRICE}"/>
					<TextBox x:Name="UnitPriceTextBox" Margin="0,0,0,15"/>

					<Button Content="{loc:Loc RELEASE_FROM_AGING}" Click="ReleaseFromAging_Click" Height="30"/>
				</StackPanel>
			</GroupBox>

			<TextBlock x:Name="StatusTextBlock" Text="READY" Foreground="Blue" FontWeight="Bold" Margin="0,5,0,0"/>
		</StackPanel>
	</ScrollViewer>
</Page>