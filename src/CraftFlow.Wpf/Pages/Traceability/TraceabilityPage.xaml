<Page x:Class="CraftFlow.Wpf.Pages.Traceability.TraceabilityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      Title="{loc:Loc Key=TITLE_TRACEABILITY}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Page.Resources>

    <Border Style="{StaticResource PageRootBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок страницы -->
            <TextBlock Grid.Row="0"
                       Text="{loc:Loc Key=TITLE_TRACEABILITY}"
                       Style="{StaticResource PageTitleTextStyle}"/>

            <!-- Панель управления трассировкой -->
            <GroupBox Grid.Row="1"
                      Header="{loc:Loc Key=GROUP_TRACE_CONTROLS}"
                      Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource ColumnGap}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{StaticResource ColumnGap}"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Key=LABEL_SELECT_LOT_TRACE}" Style="{StaticResource InputCaptionTextStyle}"/>
                        <ComboBox x:Name="StockLotsComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom"
                                Height="{StaticResource ControlHeight}">
                        <RadioButton x:Name="ForwardRadioButton"
                                     Content="{loc:Loc Key=TRACE_FORWARD}"
                                     IsChecked="True"
                                     Margin="0,0,16,0"
                                     VerticalAlignment="Center"
                                     FontWeight="SemiBold"
                                     Checked="RadioButton_Checked"/>
                        <RadioButton x:Name="BackwardRadioButton"
                                     Content="{loc:Loc Key=TRACE_BACKWARD}"
                                     VerticalAlignment="Center"
                                     FontWeight="SemiBold"
                                     Checked="RadioButton_Checked"/>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="{loc:Loc Key=RUN_TRACEABILITY}"
                            Click="RunTraceability_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="{StaticResource ButtonHeight}"
                            Padding="20,0"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </GroupBox>

            <!-- Дерево результатов -->
            <GroupBox Grid.Row="2" Header="{loc:Loc Key=GROUP_TRACE_RESULTS}">
                <Grid>
                    <TreeView x:Name="TraceTreeView"
                              FontSize="14"
                              BorderThickness="0"
                              Background="Transparent">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="2,3"/>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,4">
                                    <!-- Иконка и Заголовок узла -->
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,8,0" Foreground="{DynamicResource AppForegroundBrush}" VerticalAlignment="Center"/>

                                    <!-- Текст до ссылки (Префикс) -->
                                    <TextBlock Text="{Binding PrefixDetails}" Foreground="{DynamicResource AppForegroundBrush}" Opacity="0.8" VerticalAlignment="Center"/>

                                    <!-- Кликабельная ссылка (если есть HasLink) -->
                                    <TextBlock Visibility="{Binding HasLink, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <Hyperlink Click="EntityLink_Click" Foreground="{DynamicResource AccentBrush}">
                                            <Run Text="{Binding LinkText}" FontWeight="SemiBold"/>
                                        </Hyperlink>
                                    </TextBlock>

                                    <!-- Обычный текст, если ссылки нет -->
                                    <TextBlock Text="{Binding LinkText}" Foreground="{DynamicResource AppForegroundBrush}" Opacity="0.8" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLink}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Текст после ссылки (Суффикс) -->
                                    <TextBlock Text="{Binding SuffixDetails}" Foreground="{DynamicResource AppForegroundBrush}" Opacity="0.8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Text="Выберите партию сверху, укажите направление (вперёд или назад) и запустите трассировку"
                               FontSize="12"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=TraceTreeView}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </GroupBox>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="3"
                       Text="{loc:Loc Key=UI_STATUS_READY}"
                       Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold"
                       Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Page>