<PageFunction
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
    x:Class="CraftFlow.Wpf.Pages.TenantKeysPage"
    x:TypeArguments="sys:String"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CraftFlow.Wpf.Pages"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800"
    Title="TenantKeysPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ввод OTP от админа -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{loc:Loc DEVICE_ACTIVATION_TITLE}" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource AppForegroundBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{loc:Loc DEVICE_ACTIVATION_DESC}" 
                           Foreground="Gray" 
                           FontSize="11" 
                           Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="OtpInputTextBox" 
                             Width="180" 
                             Height="36" 
                             FontSize="16" 
                             FontWeight="Bold" 
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"/>
                    <Button Content="{loc:Loc BUTTON_ACTIVATE_KEY}" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Click="ActivateOtp_Click" 
                            Height="36" 
                            Margin="10,0,0,0" 
                            Padding="15,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Список ключей текущего тенанта -->
        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" 
                       Text="{loc:Loc MY_KEYS_TITLE}" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource AppForegroundBrush}"
                       Margin="0,0,0,8"/>
            <DataGrid x:Name="MyKeysDataGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc HEADER_DEVICE_NAME}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Loc HEADER_KEY_MASK}" Binding="{Binding MaskedKey}" Width="150"/>
                    <DataGridTextColumn Header="{loc:Loc HEADER_CREATED_AT}" Binding="{Binding CreatedAtUtc}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</PageFunction>