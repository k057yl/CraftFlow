<Window x:Class="CraftFlow.Wpf.Windows.SanitationRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка регламента мойки" 
        Height="360" Width="480" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="EquipmentTitleTextBlock" Text="Ёмкость: Ferment" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
            <TextBlock Text="Настройка интервалов и химических средств для сантехобслуживания" FontSize="12" Foreground="#888" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Настройки правила -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <GroupBox Header="Регламент сантехобслуживания" Padding="12">
                <StackPanel>
                    <TextBlock Text="Тип триггера мойки" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TriggerTypeComboBox" Height="30" Margin="0,0,0,10" SelectedIndex="3" SelectionChanged="TriggerType_SelectionChanged">
                        <ComboBoxItem Content="По количеству партий (батчей)"/>
                        <ComboBoxItem Content="По интервалу дней"/>
                        <ComboBoxItem Content="По конкретной дате"/>
                        <ComboBoxItem Content="⚡ Комбинированный (батчи ИЛИ дни — что раньше)"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Интервал (батчей)" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                            <TextBox x:Name="BatchIntervalTextBox" Text="1" Height="28"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Интервал (дней)" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                            <TextBox x:Name="DaysIntervalTextBox" Text="7" Height="28"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Используемая химия / моющие средства" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox x:Name="ChemicalsTextBox" Text="Щелочной раствор CIP-30" Height="28" Margin="0,0,0,12"/>

                    <Button Content="💾 Сохранить регламент" Click="SaveRule_Click" Style="{StaticResource PrimaryButtonStyle}" Height="32" HorizontalAlignment="Right"/>
                </StackPanel>
            </GroupBox>
        </ScrollViewer>

        <!-- Подвал -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Закрыть" Click="Close_Click" Width="100" Height="32" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>