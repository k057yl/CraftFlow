<Window x:Class="CraftFlow.Wpf.Windows.SanitationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
        Title="{loc:Loc Key=UI_SANITATION_HISTORY_TITLE}" 
        Height="500" Width="720"
        MinHeight="400" MinWidth="580"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource CardBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TargetTitleTextBlock" Text="Ёмкость: —" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
            <TextBlock x:Name="StatusTextBlock" Text="Статус: —" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Таблица Истории -->
        <GroupBox Grid.Row="1" Header="{loc:Loc Key=UI_SANITATION_HISTORY_GROUP_HEADER}" Padding="10">
            <DataGrid x:Name="LogsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Key=UI_SANITATION_COL_COMPLETED_AT}" Binding="{Binding CompletedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                    <DataGridTextColumn Header="{loc:Loc Key=UI_SANITATION_COL_PERFORMER}" Binding="{Binding PerformedByUserName}" Width="120"/>
                    <DataGridTextColumn Header="{loc:Loc Key=UI_SANITATION_COL_VERIFIER}" Binding="{Binding VerifiedByUserName}" Width="120"/>
                    <DataGridTextColumn Header="{loc:Loc Key=UI_SANITATION_COL_CHEMICALS}" Binding="{Binding ChemicalsUsed}" Width="140"/>
                    <DataGridTextColumn Header="{loc:Loc Key=UI_SANITATION_COL_NOTES}" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Подвал -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Key=UI_BTN_CANCEL}" Click="Close_Click" Width="100" Height="32"/>
        </StackPanel>
    </Grid>
</Window>