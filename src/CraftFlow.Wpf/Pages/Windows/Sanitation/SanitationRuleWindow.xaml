<Window x:Class="CraftFlow.Wpf.Windows.SanitationRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
        Title="{loc:Loc Key=UI_SANITATION_RULE_TITLE}" 
        Height="460" Width="520"
        MinHeight="400" MinWidth="460"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource CardBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="EquipmentTitleTextBlock" Text="Ёмкость: —" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
            <TextBlock Text="{loc:Loc Key=UI_SANITATION_RULE_SUBTITLE}" FontSize="12" Foreground="#888" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Настройки правила -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <GroupBox Header="{loc:Loc Key=UI_SANITATION_RULE_GROUP_HEADER}" Padding="14">
                <StackPanel>

                    <!-- Выбор триггера -->
                    <TextBlock Text="{loc:Loc Key=UI_SANITATION_RULE_LABEL_TRIGGER_TYPE}" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TriggerTypeComboBox" Height="30" Margin="0,0,0,14" SelectionChanged="TriggerType_SelectionChanged">
                        <ComboBoxItem Content="{loc:Loc Key=UI_SANITATION_TRIGGER_BATCHES}"/>
                        <ComboBoxItem Content="{loc:Loc Key=UI_SANITATION_TRIGGER_DAYS}"/>
                        <ComboBoxItem Content="{loc:Loc Key=UI_SANITATION_TRIGGER_DATE}"/>
                        <ComboBoxItem Content="{loc:Loc Key=UI_SANITATION_TRIGGER_BOTH}"/>
                        <ComboBoxItem Content="{loc:Loc Key=UI_SANITATION_TRIGGER_UPON_EMPTY}"/>
                    </ComboBox>

                    <!-- 1. Поле Батчей -->
                    <StackPanel x:Name="BatchPanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=UI_SANITATION_RULE_LABEL_BATCH_INTERVAL}" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox x:Name="BatchIntervalTextBox" Text="1" Height="28"/>
                    </StackPanel>

                    <!-- 2. Поле Дней -->
                    <StackPanel x:Name="DaysPanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=UI_SANITATION_RULE_LABEL_DAYS_INTERVAL}" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox x:Name="DaysIntervalTextBox" Text="7" Height="28"/>
                    </StackPanel>

                    <!-- 3. Поле Даты -->
                    <StackPanel x:Name="DatePanel" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="{loc:Loc Key=UI_SANITATION_RULE_LABEL_SCHEDULED_DATE}" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                        <DatePicker x:Name="ScheduledDatePicker" Height="28" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Поле Химии -->
                    <TextBlock Text="{loc:Loc Key=UI_SANITATION_RULE_LABEL_CHEMICALS}" FontSize="11" Foreground="#666" Margin="0,4,0,4"/>
                    <TextBox x:Name="ChemicalsTextBox" Text="{loc:Loc Key=UI_SANITATION_DEFAULT_CHEMICAL}" Height="28" Margin="0,0,0,16"/>

                    <Button Content="{loc:Loc Key=UI_SANITATION_RULE_BTN_SAVE}" Click="SaveRule_Click" Style="{StaticResource PrimaryButtonStyle}" Height="32" HorizontalAlignment="Right" Padding="16,0"/>
                </StackPanel>
            </GroupBox>
        </ScrollViewer>

        <!-- Подвал -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Key=UI_BTN_CANCEL}" Click="Close_Click" Width="100" Height="32"/>
        </StackPanel>
    </Grid>
</Window>