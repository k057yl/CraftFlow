<Window x:Class="CraftFlow.Wpf.Windows.SanitationDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состояние и история сантехобслуживания" 
        Height="540" Width="600" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TargetTitleTextBlock" Text="Ёмкость: Ferment" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}"/>
                <TextBlock x:Name="StatusTextBlock" Text="Статус: 🟢 В норме" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- КНОПКА 1: Запуск мойки -->
            <Button x:Name="StartSanitationButton" Grid.Column="1" Content="🧼 Начать мойку" Click="PerformSanitation_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#2E7D32" Height="32" Padding="12,0" Margin="0,0,8,0"/>

            <!-- КНОПКА 2: Переход к текущей мойке -->
            <Button x:Name="CurrentSanitationButton" Grid.Column="1" Content="⚠️ Перейти к текущей мойке" Click="PerformSanitation_Click" Style="{StaticResource PrimaryButtonStyle}" Background="#E65100" Height="32" Padding="12,0" Margin="0,0,8,0" Visibility="Collapsed"/>

            <!-- КНОПКА 3: Настройки -->
            <Button Grid.Column="2" Content="⚙️ Настроить правила" Click="EditRules_Click" Height="32" Padding="12,0"/>
        </Grid>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Прошлое обслуживание" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LastWashDateTextBlock" Text="Дата: —" FontWeight="Bold" FontSize="13" Foreground="#333"/>
                            <TextBlock x:Name="LastWashedByTextBlock" Text="Кто убирал: —" FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Fill="#E0E0E0" VerticalAlignment="Stretch"/>

                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                            <TextBlock Text="Следующая уборка" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
                            <TextBlock x:Name="NextWashDateTextBlock" Text="Срок: —" FontWeight="Bold" FontSize="13" Foreground="#333"/>
                            <TextBlock x:Name="ChemicalsTextBlock" Text="Химия: CIP-30" FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <GroupBox Header="История проведённых моек" Padding="8">
                    <DataGrid x:Name="LogsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата завершения" Binding="{Binding CompletedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                            <DataGridTextColumn Header="Кто убирал" Binding="{Binding PerformedByUserName}" Width="120"/>
                            <DataGridTextColumn Header="Моющее средство" Binding="{Binding ChemicalsUsed}" Width="130"/>
                            <DataGridTextColumn Header="Длительность" Binding="{Binding DurationMinutes, StringFormat=\{0\} мин}" Width="90"/>
                            <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Подвал -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Закрыть" Click="Close_Click" Width="100" Height="32" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>