<Window x:Class="CraftFlow.Wpf.Windows.SanitationExecutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
        Title="{loc:Loc Key=UI_SETTINGS_TAB_INFRASTRUCTURE}" 
        Height="400" Width="460" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="TargetTitleTextBlock" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15"/>

            <!-- ФАЗА 1: СТАРТ МОЙКИ -->
            <StackPanel x:Name="StartPanel" Visibility="Visible">
                <TextBlock Text="{loc:Loc Key=UI_SANITATION_LABEL_PERFORMER}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                <ComboBox x:Name="PerformerComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="30" Margin="0,0,0,12"/>

                <TextBlock Text="{loc:Loc Key=UI_SANITATION_LABEL_START_NOTES}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                <TextBox x:Name="StartNotesTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Grid.Column="0" Content="{loc:Loc Key=UI_SANITATION_BTN_START}" Click="Start_Click" Height="34" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Grid.Column="1" Content="{loc:Loc Key=UI_BTN_CANCEL}" Click="Close_Click" Height="34" Width="90"/>
                </Grid>
            </StackPanel>

            <!-- ФАЗА 2: ПРИЁМКА / ЗАВЕРШЕНИЕ МОЙКИ -->
            <StackPanel x:Name="CompletePanel" Visibility="Collapsed">
                <TextBlock Text="{loc:Loc Key=UI_SANITATION_LABEL_CHEMICALS}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                <TextBox x:Name="ChemicalsTextBox" Height="28" Margin="0,0,0,10"/>

                <TextBlock Text="{loc:Loc Key=UI_SANITATION_LABEL_VERIFY_NOTES}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                <TextBox x:Name="VerificationNotesTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                <CheckBox x:Name="PassedCheckBox" Content="{loc:Loc Key=UI_SANITATION_CHECKBOX_PASSED}" IsChecked="True" FontWeight="SemiBold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{loc:Loc Key=UI_SANITATION_BTN_ACCEPT}" Click="CompleteAndVerify_Click" Height="34" Margin="0,0,4,0" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Grid.Column="1" Content="{loc:Loc Key=UI_SANITATION_BTN_REWASH}" Click="ReWash_Click" Height="34" Margin="4,0,4,0"/>
                    <Button Grid.Column="2" Content="{loc:Loc Key=UI_BTN_CANCEL}" Click="Close_Click" Height="34" Width="80" Margin="4,0,0,0"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>