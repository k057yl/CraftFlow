<Window x:Class="CraftFlow.Wpf.Windows.EditOrganizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление подпиской организации" 
        Height="540" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="OrgNameTextBlock" Text="Организация" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,15"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Выбор Тарифного плана из БД -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Тарифный план / Аддон:" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="PlanComboBox" 
                              Height="32" 
                              VerticalContentAlignment="Center"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Code"/>
                </StackPanel>

                <!-- Корректировка дней (+ / -) -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Изменить дни (+30 или -15):" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="AddDaysTextBox" Text="0" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Статус доступа -->
            <CheckBox x:Name="IsActiveCheckBox" Content="Доступ разрешен (Организация активна)" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,15"/>

            <!-- Таблица истории платежей -->
            <TextBlock Text="История транзакций и изменений:" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="Bold" Margin="0,5,0,8"/>
            <DataGrid x:Name="PaymentsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="180" Margin="0,0,0,20" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAtUtc, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="120"/>
                    <DataGridTextColumn Header="Тариф" Binding="{Binding PlanCode}" Width="125"/>
                    <DataGridTextColumn Header="Дней" Binding="{Binding DaysAdded}" Width="55"/>
                    <DataGridTextColumn Header="Операция" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Кнопки действия -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Отмена" Click="Cancel_Click" Height="36"/>
                <Button Grid.Column="2" Content="Сохранить изменения" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" Height="36"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>