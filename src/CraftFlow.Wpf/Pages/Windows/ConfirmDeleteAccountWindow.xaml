<Window x:Class="CraftFlow.Wpf.Windows.ConfirmDeleteAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление аккаунтом" 
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="Управление учетной записью" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,10"/>

            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                <TextBlock Text="⚠️ Внимание! Введите ваш Email для подтверждения операции. Далее выберите требуемое действие:" 
                           Foreground="#991B1B" TextWrapping="Wrap" FontSize="12"/>
            </Border>

            <TextBlock Text="Ваш текущий Email:" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
            <TextBlock x:Name="RequiredEmailTextBlock" Text="user@example.com" FontWeight="Bold" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,10"/>

            <TextBox x:Name="EmailInputTextBox" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Заморозить (Soft)" Click="Deactivate_Click" Background="#EAB308" Foreground="Black" FontWeight="Bold" Height="36"/>
                <Button Grid.Column="2" Content="Удалить насовсем (Hard)" Click="Purge_Click" Background="#DC2626" Foreground="White" FontWeight="Bold" Height="36"/>
            </Grid>

            <Button Content="Отмена" Click="Cancel_Click" Height="32" Width="100" HorizontalAlignment="Right"/>
        </StackPanel>
    </Border>
</Window>