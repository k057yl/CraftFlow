<Window x:Class="CraftFlow.Wpf.Pages.Production.Windows.LotReleaseWeighingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Взвешивание и приходование готовой продукции"
        Height="660" Width="1040"
        MinHeight="600" MinWidth="940"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- Стиль заголовков колонок -->
        <Style x:Key="ModernColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Стиль ячеек -->
        <Style x:Key="ModernCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ШАПКА: ЧТО ИМЕННО ПРИХОДУЕТСЯ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#DCFCE7" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock Text="📥 ПРИХОД ГОТОВОЙ ПРОДУКЦИИ НА СКЛАД"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#15803D"/>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3">
                            <TextBlock x:Name="ChamberInfoTextBlock"
                                       Text="Камера: —"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#475569"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="LotNameTextBlock"
                               Text="Партия: —"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Подсказка по вводу:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBlock Text="Введите фактический вес в зелёную колонку." FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="Отметьте «Брак?», если головка не приходуется." FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. ОСНОВНАЯ ЧАСТЬ: ТАБЛИЦА + СВОДКА -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Левая карточка: Таблица поштучного взвешивания -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Поштучное взвешивание единиц партии"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Кликните на ячейку «Факт после» для ввода веса"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="ItemsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              BorderBrush="#E2E8F0"
                              BorderThickness="1"
                              RowHeight="36"
                              Background="White"
                              ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                              CellStyle="{StaticResource ModernCellStyle}"
                              CellEditEnding="ItemsDataGrid_CellEditEnding">

                        <!-- Подсветка отбракованной строки -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDiscarded}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- Маркировка головки -->
                            <DataGridTextColumn Header="№ / Маркировка единицы"
                                                Binding="{Binding ItemCode}"
                                                IsReadOnly="True"
                                                Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding ItemCode}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Вес до -->
                            <DataGridTextColumn Header="Вес до (кг)"
                                                Binding="{Binding InitialWeight, StringFormat={}{0:N3}}"
                                                IsReadOnly="True"
                                                Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#64748B"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Факт после (акцентная редактируемая колонка) -->
                            <DataGridTextColumn Header="✎ Факт после (кг)"
                                                Binding="{Binding Weight, StringFormat={}{0:N3}, UpdateSourceTrigger=PropertyChanged}"
                                                Width="135">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernCellStyle}">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                        <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                        <Setter Property="BorderThickness" Value="1,0,1,0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="#15803D"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Усушка -->
                            <DataGridTextColumn Header="Усушка"
                                                Binding="{Binding ShrinkagePercentText}"
                                                IsReadOnly="True"
                                                Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#D97706"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Брак -->
                            <DataGridCheckBoxColumn Header="Брак?"
                                                    Binding="{Binding IsDiscarded, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="68">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <EventSetter Event="Click" Handler="CheckBox_Click"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Правая колонка: Сводка прихода и цена -->
            <StackPanel Grid.Column="2">
                <!-- Карточка итогов -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Итог приходования" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <!-- Главный акцент: Что пойдёт на остатки -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Будет оприходовано (годный вес):" FontSize="11" Foreground="#166534"/>
                                <TextBlock x:Name="TotalWeightTextBlock" Text="0.000 кг" FontSize="24" FontWeight="Bold" Foreground="#15803D" Margin="0,2,0,2"/>
                                <TextBlock x:Name="TotalShrinkageTextBlock" Text="Усушка: —" FontSize="11" FontWeight="SemiBold" Foreground="#D97706"/>
                            </StackPanel>
                        </Border>

                        <!-- Строки деталей -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Годных единиц:" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="TotalUnitsTextBlock" Text="0 шт" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Начальный вес (до):" FontSize="12" Foreground="#64748B"/>
                            <TextBlock x:Name="InitialTotalWeightTextBlock" Text="0.000 кг" FontSize="13" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Background="#F1F5F9" Margin="0,6,0,8"/>

                        <Grid>
                            <TextBlock Text="Себестоимость (1 кг):" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CalculatedCostTextBlock" Text="$ 0.00" FontSize="16" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Карточка параметров продажи и печати -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Параметры выпуска" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <TextBlock Text="Цена продажи за 1 кг ($):" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="UnitPriceTextBox"
                                 FontSize="15"
                                 FontWeight="SemiBold"
                                 Padding="8,6"
                                 BorderBrush="#CBD5E1"
                                 Margin="0,0,0,12"/>

                        <CheckBox x:Name="AutoPrintCheckBox"
                                  Content="Печать этикетки на каждую единицу"
                                  IsChecked="True"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Foreground="#334155"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 3. ПОДВАЛ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="После подтверждения партия переместится из камеры на склад готовой продукции."
                           FontSize="12"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Click="Cancel_Click"
                            Width="110"
                            Height="34"
                            Margin="0,0,10,0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#475569" TextBlock.FontWeight="SemiBold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="✔ Подтвердить и Оприходовать"
                            Click="Confirm_Click"
                            Width="220"
                            Height="34"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#16A34A" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White" TextBlock.FontWeight="Bold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>