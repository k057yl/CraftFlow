<Window x:Class="CraftFlow.Wpf.Pages.WriteOffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Списание / Забраковка лота" 
        Height="380" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="LotTitleTextBlock" 
                       FontWeight="Bold" 
                       FontSize="15" 
                       Foreground="#0F172A" 
                       TextWrapping="Wrap" 
                       LineHeight="20"/>

            <TextBlock x:Name="CurrentQuantityTextBlock" 
                       FontSize="12" 
                       Foreground="#0EA5E9" 
                       FontWeight="SemiBold" 
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Вес -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Списываемый вес (кг):" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="QuantityTextBox" Padding="8,6" FontSize="13"/>
                </StackPanel>

                <!-- Штуки (ДОБАВЛЕН x:Name) -->
                <StackPanel x:Name="UnitsStackPanel" Grid.Column="1">
                    <TextBlock Text="Списать штук:" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="UnitsTextBox" Text="0" Padding="8,6" FontSize="13"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="* Если списывается усушка или чистка (без убавления головок) — укажите 0 штук." 
                       FontSize="10" Foreground="#64748B" FontStyle="Italic" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <TextBlock Text="Причина списания / комментарий:" FontSize="11" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="ReasonTextBox" Padding="8,6" FontSize="12" Text="Промывка / Технические потери"/>
        </StackPanel>

        <Grid Grid.Row="2"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Width="90" Height="32" Margin="0,0,10,0" Background="#E2E8F0" BorderThickness="0" FontWeight="SemiBold"/>
            <Button Content="Списать" Click="Confirm_Click" Width="100" Height="32" Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>