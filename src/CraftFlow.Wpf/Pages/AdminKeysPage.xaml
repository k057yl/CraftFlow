<PageFunction
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
    x:Class="CraftFlow.Wpf.Pages.AdminKeysPage"
    x:TypeArguments="sys:String"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CraftFlow.Wpf.Pages"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800"
    Title="AdminKeysPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc ADMIN_KEYS_HEADER}" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,15"
                   Foreground="{DynamicResource AppForegroundBrush}"/>

        <!-- Форма генерации и отправки OTP -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{loc:Loc ISSUE_NEW_KEY_TITLE}" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource AppForegroundBrush}"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{loc:Loc TENANT_EMAIL_LABEL}" 
                                   Foreground="{DynamicResource AppForegroundBrush}"
                                   FontSize="11" 
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="TargetEmailTextBox" 
                                 Height="30" 
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="{loc:Loc DEVICE_NAME_LABEL}" 
                                   Foreground="{DynamicResource AppForegroundBrush}"
                                   FontSize="11" 
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="KeyNameTextBox" 
                                 Height="30" 
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" 
                            Content="{loc:Loc BUTTON_SEND_OTP}" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Click="SendOtpToTenant_Click" 
                            Height="30" 
                            VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Таблица всех активных ключей в системе -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" 
                       Text="{loc:Loc ALL_SYSTEM_KEYS_TITLE}" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource AppForegroundBrush}"
                       Margin="0,0,0,8"/>
            <DataGrid x:Name="AllKeysDataGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc HEADER_TENANT_EMAIL}" Binding="{Binding TenantEmail}" Width="150"/>
                    <DataGridTextColumn Header="{loc:Loc HEADER_KEY_NAME}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Loc HEADER_KEY_MASK}" Binding="{Binding MaskedKey}" Width="120"/>
                    <DataGridTextColumn Header="{loc:Loc HEADER_STATUS}" Binding="{Binding Status}" Width="100"/>
                    <DataGridTemplateColumn Header="{loc:Loc HEADER_ACTIONS}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{loc:Loc BUTTON_REVOKE}" 
                                        Click="AdminRevokeKey_Click" 
                                        Tag="{Binding Id}" 
                                        Background="#EF4444" 
                                        Foreground="White"
                                        Height="22"
                                        FontSize="10"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</PageFunction>