<Page x:Class="CraftFlow.Wpf.Pages.Production.ProductionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:controls="clr-namespace:CraftFlow.Wpf.Pages.Production.Controls"
      Title="{loc:Loc Key=TITLE_PRODUCTION}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Key=PRODUCTION_HEADER}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1" x:Name="ProductionTabControl">

            <!-- Вкладка 1: Варочный цех -->
            <TabItem Header="{loc:Loc Key=TAB_BREWHOUSE}">
                <controls:BrewhouseControl x:Name="BrewhouseView"/>
            </TabItem>

            <!-- Вкладка 2: Созревание и Аффинаж -->
            <TabItem Header="{loc:Loc Key=TAB_AGING}">
                <controls:AgingControl x:Name="AgingView"/>
            </TabItem>

            <!-- Вкладка 3: Брак варки и Акт списания -->
            <TabItem Header="{loc:Loc Key=TAB_DISCARD_ACTS}">
                <controls:DiscardActsControl x:Name="DiscardView"/>
            </TabItem>

        </TabControl>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Text="{loc:Loc Key=STATUS_READY}" Foreground="Blue" FontWeight="Bold" Margin="0,10,0,0"/>
    </Grid>
</Page>