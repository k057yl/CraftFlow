<UserControl x:Class="CraftFlow.Wpf.Pages.Production.Controls.DiscardActsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization">
    <Border Padding="8">
        <Grid>
            <!-- Разделение по горизонтали: 30% слева, 70% справа -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- 1. ЛЕВАЯ СЕКЦИЯ (30%): Браковка варки в котле -->
            <!-- ========================================== -->
            <GroupBox Grid.Column="0" Header="{loc:Loc Key=GROUP_DISCARD_IN_KETTLE}" Margin="0,0,6,0" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Выбор партии -->
                        <TextBlock Text="{loc:Loc Key=LABEL_SELECT_ACTIVE_BATCH}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <ComboBox x:Name="DiscardBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="28" Padding="5,4" Margin="0,0,0,10"/>

                        <!-- Причина списания -->
                        <TextBlock Text="{loc:Loc Key=LABEL_DISCARD_REASON}" Margin="0,0,0,3" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <TextBox x:Name="DiscardReasonTextBox" Padding="5,4" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                        <!-- Кнопка списания -->
                        <Button Content="{loc:Loc Key=BTN_DISCARD_BATCH_SUBMIT}" 
                                Click="DiscardBatch_Click" 
                                Height="32" 
                                HorizontalAlignment="Left"
                                Padding="15,0"
                                Background="#DC2626" 
                                Foreground="White" 
                                FontWeight="Bold"
                                Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- ========================================== -->
            <!-- 2. ПРАВАЯ СЕКЦИЯ (70%): Браковка лотов на созревании -->
            <!-- ========================================== -->
            <GroupBox Grid.Column="1" Header="{loc:Loc Key=GROUP_DISCARD_AGING_LOTS}" Margin="6,0,0,0" Padding="10">
                <DataGrid x:Name="DiscardAgingLotsDataGrid" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          GridLinesVisibility="Horizontal" 
                          HeadersVisibility="Column"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_LOT_BATCH}" Binding="{Binding BatchNumber}" Width="1.5*"/>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_CHAMBER}" Binding="{Binding ChamberName}" Width="1.2*"/>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_CURRENT_STOCK}" Binding="{Binding InitialQuantity, StringFormat={}{0:N2}}" Width="1*"/>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_UNITS_COUNT}" Binding="{Binding UnitsCount}" Width="0.8*"/>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_DAYS_IN_AGING}" Binding="{Binding DaysInChamber}" Width="1*"/>
                        <DataGridTemplateColumn Header="{loc:Loc Key=COLUMN_ACTION}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{loc:Loc Key=BTN_DISCARD_ROW}" 
                                            Click="DiscardAgingLotRow_Click" 
                                            Tag="{Binding LotId}" 
                                            Background="#FEE2E2" 
                                            Foreground="#991B1B" 
                                            BorderBrush="#FCA5A5" 
                                            FontWeight="Bold" 
                                            Padding="6,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>