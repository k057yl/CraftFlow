<UserControl x:Class="CraftFlow.Wpf.Pages.Production.Controls.AgingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization">
    <Border Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- ВЕРХНЯЯ ЧАСТЬ: 40% / 60%                  -->
            <!-- ========================================== -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Перемещение на созревание (40%, поля в 1 столбец) -->
                <GroupBox Grid.Column="0" Header="{loc:Loc Key=GROUP_TRANSFER_AGING}" Margin="0,0,6,0" Padding="10">
                    <StackPanel>
                        <!-- Завершенная варка -->
                        <TextBlock Text="{loc:Loc Key=LABEL_COMPLETED_BATCH}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <ComboBox x:Name="CompletedBatchesComboBox" 
                                  DisplayMemberPath="Name" 
                                  SelectedValuePath="Id" 
                                  Height="26" 
                                  Margin="0,0,0,8"
                                  SelectionChanged="CompletedBatchesComboBox_SelectionChanged"/>

                        <!-- Климатическая камера -->
                        <TextBlock Text="{loc:Loc Key=LABEL_AGING_CHAMBER}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <ComboBox x:Name="AgingChambersComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" Margin="0,0,0,8"/>

                        <!-- Маркировка лота -->
                        <TextBlock Text="{loc:Loc Key=LABEL_AGING_LOT_NAME}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <TextBox x:Name="AgingLotNameTextBox" Padding="4,2" Height="26" Margin="0,0,0,8"/>

                        <!-- Срок выдержки (дней) -->
                        <TextBlock Text="{loc:Loc Key=LABEL_MIN_AGING_DAYS}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <TextBox x:Name="MinAgingDaysTextBox" Text="30" Padding="4,2" Height="26" Margin="0,0,0,12"/>

                        <!-- Кнопка размещения -->
                        <Button Content="{loc:Loc Key=BTN_TRANSFER_AGING}" 
                                Click="TransferToAging_Click" 
                                Height="28" 
                                HorizontalAlignment="Left"
                                Padding="16,0"
                                Style="{StaticResource SuccessButtonStyle}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. Текущие партии в камерах созревания (60%) -->
                <GroupBox Grid.Column="1" Header="{loc:Loc Key=GROUP_ACTIVE_AGING_LOTS}" Margin="6,0,0,0" Padding="8">
                    <DataGrid x:Name="AgingLotsDataGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionChanged="AgingLotsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_LOT_BATCH}" Binding="{Binding BatchNumber}" Width="1.5*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_CHAMBER}" Binding="{Binding ChamberName}" Width="1*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_CURRENT_STOCK}" Binding="{Binding InitialQuantity, StringFormat={}{0:N2}}" Width="1*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_UNITS_COUNT}" Binding="{Binding UnitsCount}" Width="0.8*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_DAYS_IN_CHAMBER}" Binding="{Binding DaysInChamber}" Width="0.8*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_TARGET_DAYS}" Binding="{Binding TargetDays}" Width="0.8*"/>
                            <DataGridCheckBoxColumn Header="{loc:Loc Key=COLUMN_IS_READY}" Binding="{Binding IsReadyForRelease}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- ========================================== -->
            <!-- 3. НИЖНЯЯ ЧАСТЬ (100%): Извлечение из камеры созревания -->
            <!-- ========================================== -->
            <GroupBox Grid.Row="1" Header="{loc:Loc Key=GROUP_RELEASE_AGING}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc Key=LABEL_ACTIVE_AGING_LOT}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="ActiveAgingLotsComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" SelectionChanged="ActiveAgingLotsComboBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc Key=LABEL_TARGET_WAREHOUSE}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <ComboBox x:Name="TargetWarehousesComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" SelectionChanged="TargetWarehousesComboBox_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Key=LABEL_TARGET_LOCATIONS}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,0,3"/>
                            <ListBox x:Name="TargetStorageLocationsListBox" Height="70" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SelectionMode="Multiple">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBlock Text="{loc:Loc Key=LABEL_FREE_CAPACITY_PREFIX}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                            <TextBlock Text="{Binding FreeCapacityDisplay}" Foreground="#16A34A" FontWeight="Bold"/>
                                            <TextBlock Text="{loc:Loc Key=LABEL_FREE_CAPACITY_SUFFIX}" Foreground="{DynamicResource AppForegroundBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Key=LABEL_RELEASE_LOT_NAME}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                            <TextBox x:Name="ReleaseLotNameTextBox" Padding="4,2" Height="26"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{loc:Loc Key=LABEL_FINAL_WEIGHT}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="ActualFinalQuantityTextBox" TextChanged="ActualFinalQuantityTextBox_TextChanged" Padding="4,2" Height="26"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="{loc:Loc Key=LABEL_UNITS_COUNT}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="ReleaseUnitsCountTextBox" Text="1" Padding="4,2" Height="26"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CalculatedCostLabelTextBlock" Text="{loc:Loc Key=LABEL_UNIT_COST_KG}" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBlock x:Name="CalculatedUnitCostTextBlock" Text="$ 0.00" FontSize="15" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock x:Name="UnitPriceLabelTextBlock" Text="{loc:Loc Key=LABEL_SELLING_PRICE_KG}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="UnitPriceTextBox" Padding="4,2" Height="26"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="{loc:Loc Key=BTN_RELEASE_AGING}" 
                                Click="ReleaseFromAging_Click" 
                                Height="28" 
                                HorizontalAlignment="Left"
                                Padding="16,0"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>