<UserControl x:Class="CraftFlow.Wpf.Pages.Production.Controls.BrewhouseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization">
    <Border Padding="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ЛЕВАЯ ВЕРХНЯЯ СЕКЦИЯ: 1. Параметры запуска варки -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="{loc:Loc Key=GROUP_START_BATCH}" Margin="0,0,6,6" Padding="8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_BATCH_CODE}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                            <TextBox x:Name="BatchNameTextBox" Padding="4,2" Height="26"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Key=LABEL_SELECT_RECIPE}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                            <ComboBox x:Name="BatchRecipeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" SelectionChanged="BatchInputs_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_RAW_WAREHOUSE}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                            <ComboBox x:Name="BatchWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26" SelectionChanged="BatchInputs_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Key=LABEL_DEST_WAREHOUSE}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                            <ComboBox x:Name="DestinationWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Height="26"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_PLANNED_OUTPUT}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                            <TextBox x:Name="BatchQuantityTextBox" Text="10" TextChanged="BatchInputs_Changed" Padding="4,2" Height="26"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="{loc:Loc Key=BTN_CALC_MAX}" 
                                Click="CalculateMaxQuantity_Click" 
                                Margin="0,15,0,0" 
                                Padding="8,0" 
                                Height="26"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_SCHEDULED_DATE}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                            <DatePicker x:Name="ScheduledDatePicker" Height="26" Padding="3,1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Key=LABEL_SCHEDULED_TIME}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                            <TextBox x:Name="ScheduledTimeTextBox" Text="12:00" Padding="4,2" Height="26"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{loc:Loc Key=BTN_START_BATCH}" 
                                Click="StartBatch_Click" 
                                Height="28" 
                                Padding="12,0" 
                                Margin="0,0,6,0" 
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="{loc:Loc Key=BTN_PLAN_BATCH}" 
                                Click="PlanBatch_Click" 
                                Height="28" 
                                Padding="12,0" 
                                Style="{StaticResource SuccessButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ПРАВАЯ ВЕРХНЯЯ СЕКЦИЯ: Расчет потребности в сырье -->
            <GroupBox Grid.Row="0" Grid.Column="1" Header="{loc:Loc Key=GROUP_RAW_REQUIREMENTS}" Margin="6,0,0,6" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" x:Name="RequirementsListBox" DisplayMemberPath="DisplayInfo" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" MinHeight="110"/>

                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=LABEL_ESTIMATED_RAW_COST}" Foreground="{DynamicResource AppForegroundBrush}" Margin="0,0,6,0" FontSize="11"/>
                            <TextBlock x:Name="EstimatedCostTextBlock" Text="$ 0.00" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Content="{loc:Loc Key=BTN_PRINT_CARD}" 
                                Click="PrintRecipeCard_Click" 
                                Padding="10,0" 
                                Height="26"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- ЛЕВАЯ НИЖНЯЯ СЕКЦИЯ: Запланированные варки и Варки в процессе -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,6,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <!-- 2. Запланированные варки -->
                <GroupBox Grid.Row="0" Header="{loc:Loc Key=GROUP_PLANNED_BATCHES}" Margin="0,0,0,6" Padding="6">
                    <DataGrid x:Name="PlannedBatchesDataGrid" 
                              ItemsSource="{Binding PlannedBatchesSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_BATCH_CODE}" Binding="{Binding BatchName}" Width="1.2*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_RECIPE}" Binding="{Binding RecipeName}" Width="1.5*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_VOLUME}" Binding="{Binding PlannedOutputQuantity, StringFormat={}{0:F2}}" Width="0.8*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_SCHEDULED_AT}" Binding="{Binding ScheduledAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="1.2*"/>
                            <DataGridTemplateColumn Header="{loc:Loc Key=COLUMN_COUNTDOWN}" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedCountdown}" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Loc Key=COLUMN_ACTIONS}" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="▶" Click="StartDraftBatch_Click" Tag="{Binding Id}" ToolTip="{loc:Loc Key=TOOLTIP_START}" Margin="0,0,3,0" Padding="4,1" Background="#16A34A" Foreground="White" FontWeight="Bold"/>
                                            <Button Content="✕" Click="DeleteDraftBatch_Click" Tag="{Binding Id}" ToolTip="{loc:Loc Key=TOOLTIP_DELETE}" Padding="4,1" Background="#DC2626" Foreground="White" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- 3. Варки в процессе -->
                <GroupBox Grid.Row="1" Header="{loc:Loc Key=GROUP_ACTIVE_BATCHES}" Margin="0,6,0,0" Padding="6">
                    <DataGrid x:Name="ActiveBatchesDataGrid" 
                              ItemsSource="{Binding ActiveBatchesSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              SelectionMode="Single"
                              SelectionChanged="ActiveBatchesDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_BATCH_NAME}" Binding="{Binding BatchName}" Width="1.2*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_RECIPE}" Binding="{Binding RecipeName}" Width="1.5*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_PLANNED_QTY}" Binding="{Binding PlannedOutputQuantity, StringFormat={}{0:F2}}" Width="0.8*"/>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_STARTED_AT}" Binding="{Binding StartedAt, StringFormat={}{0:HH:mm}}" Width="0.8*"/>
                            <DataGridTemplateColumn Header="{loc:Loc Key=COLUMN_ELAPSED}" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedElapsed}" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#0369A1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdueStatus}" Value="True">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Key=COLUMN_TARGET_DURATION}" Binding="{Binding TargetDurationMinutes}" Width="0.8*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- ПРАВАЯ НИЖНЯЯ СЕКЦИЯ: Завершение варки и Калькуляция -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="6,6,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 4. Форма завершения варки -->
                <GroupBox Grid.Row="0" Header="{loc:Loc Key=GROUP_COMPLETE_BATCH}" Margin="0,0,0,6" Padding="8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=LABEL_ACTIVE_BATCH}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <ComboBox x:Name="ActiveBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,6" Height="26" SelectionChanged="ActiveBatchComboBox_SelectionChanged"/>

                        <TextBlock Text="{loc:Loc Key=LABEL_COMPLETE_BATCH_NAME}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                        <TextBox x:Name="CompleteBatchNameTextBox" Margin="0,0,0,6" Padding="4,2" Height="26"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="{loc:Loc Key=LABEL_ACTUAL_OUTPUT}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="ActualOutputQuantityTextBox" Padding="4,2" Height="26" TextChanged="CostInputs_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="{loc:Loc Key=LABEL_UNITS_COUNT}" Margin="0,0,0,2" FontSize="11" Foreground="{DynamicResource AppForegroundBrush}"/>
                                <TextBox x:Name="ActualUnitsCountTextBox" Text="1" Padding="4,2" Height="26"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="UseOverheadCheckBox" Grid.Column="0" Content="{loc:Loc Key=CHECKBOX_OVERHEAD}" VerticalAlignment="Center" Margin="0,0,6,0" Click="CostInputs_Changed"/>
                            <TextBox x:Name="OverheadPercentageTextBox" Grid.Column="1" Text="15" Padding="4,2" Height="26" IsEnabled="{Binding IsChecked, ElementName=UseOverheadCheckBox}" TextChanged="CostInputs_Changed"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="Bold"/>
                        </Grid>

                        <Button x:Name="CompleteBatchButton" 
                                Content="{loc:Loc Key=BTN_COMPLETE_BATCH}" 
                                Click="CompleteBatch_Click" 
                                Height="28" 
                                HorizontalAlignment="Left"
                                Padding="12,0"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 5. Расчет себестоимости -->
                <GroupBox Grid.Row="1" Header="{loc:Loc Key=GROUP_BATCH_COSTING}" Padding="8">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{loc:Loc Key=LABEL_RAW_COST}" Foreground="{DynamicResource AppForegroundBrush}" FontSize="11"/>
                            <TextBlock x:Name="RawMaterialCostTextBlock" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{loc:Loc Key=LABEL_OVERHEAD_COST}" Foreground="{DynamicResource AppForegroundBrush}" FontSize="11"/>
                            <TextBlock x:Name="OverheadCostTextBlock" Text="+$0.00 (0%)" HorizontalAlignment="Right" Foreground="#D97706" FontWeight="SemiBold"/>
                        </Grid>

                        <Separator Margin="0,2,0,6" Background="{DynamicResource BorderBrush}"/>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{loc:Loc Key=LABEL_TOTAL_COST}" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="Bold" FontSize="11"/>
                            <TextBlock x:Name="TotalBatchCostTextBlock" Text="$0.00" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#059669" FontSize="13"/>
                        </Grid>

                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=LABEL_UNIT_COST}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="UnitCostTextBlock" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </Border>
</UserControl>