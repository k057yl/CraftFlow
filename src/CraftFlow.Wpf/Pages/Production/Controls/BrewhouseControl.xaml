<UserControl x:Class="CraftFlow.Wpf.Pages.Production.Controls.BrewhouseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left" Width="920">

            <!-- 1. Запуск варки -->
            <GroupBox Header="{loc:Loc Key=GROUP_START_BATCH}" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_BATCH_CODE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                            <TextBox x:Name="BatchNameTextBox" Padding="5,4"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Key=LABEL_SELECT_RECIPE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                            <ComboBox x:Name="BatchRecipeComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4" SelectionChanged="BatchInputs_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_RAW_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                            <ComboBox x:Name="BatchWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4" SelectionChanged="BatchInputs_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Key=LABEL_DEST_WAREHOUSE}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                            <ComboBox x:Name="DestinationWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5,4"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Key=LABEL_PLANNED_OUTPUT}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                            <TextBox x:Name="BatchQuantityTextBox" Text="10" TextChanged="BatchInputs_Changed" Padding="5,4"/>
                        </StackPanel>
                        <Button Grid.Column="1" 
                                Content="{loc:Loc Key=BTN_CALC_MAX}" 
                                Click="CalculateMaxQuantity_Click" 
                                Margin="10,18,0,0" 
                                Padding="12,4" 
                                Height="28"
                                Background="#0284C7" 
                                Foreground="White" 
                                FontWeight="SemiBold"/>
                    </Grid>

                    <GroupBox Header="{loc:Loc Key=GROUP_RAW_REQUIREMENTS}" Margin="0,5,0,10" Padding="8" Background="#F8FAFC">
                        <StackPanel>
                            <ListBox x:Name="RequirementsListBox" Height="90" DisplayMemberPath="DisplayInfo" BorderThickness="0" Background="Transparent"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Key=LABEL_ESTIMATED_COST}" Foreground="Gray" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="EstimatedCostTextBlock" Text="$ 0.00" FontWeight="Bold" Foreground="Green"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Content="{loc:Loc Key=BTN_PRINT_CARD}" 
                                        Click="PrintRecipeCard_Click" 
                                        Padding="10,4" 
                                        Background="#475569" 
                                        Foreground="White"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Запланированная дата старта" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                            <DatePicker x:Name="ScheduledDatePicker" Height="28" Padding="3,2"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Время (ЧЧ:ММ)" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                            <TextBox x:Name="ScheduledTimeTextBox" Text="12:00" Padding="5,4"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Key=BTN_START_BATCH}" 
                                Click="StartBatch_Click" 
                                Height="32" 
                                Width="160" 
                                Margin="0,0,10,0" 
                                FontWeight="Bold"/>

                        <Button Content="Запланировать (в Черновик)" 
                                Click="PlanBatch_Click" 
                                Height="32" 
                                Padding="12,0" 
                                Background="#16A34A" 
                                Foreground="White" 
                                FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 2.1 ЗАПЛАНИРОВАННЫЕ ВАРКИ (ЧЕРНОВИКИ) -->
            <GroupBox Header="Запланированные варки" Margin="0,0,0,12" Padding="8">
                <DataGrid x:Name="PlannedBatchesDataGrid" 
              ItemsSource="{Binding PlannedBatchesSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
              AutoGenerateColumns="False" 
              IsReadOnly="True" 
              GridLinesVisibility="Horizontal"
              Background="Transparent"
              MaxHeight="140"
              SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код партии" Binding="{Binding BatchName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Рецептура" Binding="{Binding RecipeName}" Width="2*"/>
                        <DataGridTextColumn Header="Объём" Binding="{Binding PlannedOutputQuantity, StringFormat={}{0:F2}}" Width="1*"/>
                        <DataGridTextColumn Header="Запланировано на" Binding="{Binding ScheduledAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="1.2*"/>
                        <DataGridTemplateColumn Header="До старта" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedCountdown}" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Действия" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="▶" Click="StartDraftBatch_Click" Tag="{Binding Id}" ToolTip="Запустить" Margin="0,0,4,0" Padding="5,1" Background="#16A34A" Foreground="White" FontWeight="Bold"/>
                                        <Button Content="✕" Click="DeleteDraftBatch_Click" Tag="{Binding Id}" ToolTip="Удалить" Padding="5,1" Background="#DC2626" Foreground="White" FontWeight="Bold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- 2.2 ВАРКИ В ПРОЦЕССЕ -->
            <GroupBox Header="{loc:Loc Key=GROUP_ACTIVE_BATCHES}" Margin="0,0,0,12" Padding="8">
                <DataGrid x:Name="ActiveBatchesDataGrid" 
              ItemsSource="{Binding ActiveBatchesSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
              AutoGenerateColumns="False" 
              IsReadOnly="True" 
              GridLinesVisibility="Horizontal"
              Background="Transparent"
              MaxHeight="160"
              SelectionMode="Single"
              SelectionChanged="ActiveBatchesDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_BATCH_NAME}" Binding="{Binding BatchName}" Width="1.5*"/>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_RECIPE}" Binding="{Binding RecipeName}" Width="2*"/>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_PLANNED_QTY}" Binding="{Binding PlannedOutputQuantity, StringFormat={}{0:F2}}" Width="1*"/>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_STARTED_AT}" Binding="{Binding StartedAt, StringFormat={}{0:HH:mm}}" Width="0.8*"/>
                        <DataGridTemplateColumn Header="{loc:Loc Key=COLUMN_ELAPSED}" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedElapsed}" FontWeight="Bold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0369A1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverdueStatus}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Key=COLUMN_TARGET_DURATION}" Binding="{Binding TargetDurationMinutes}" Width="0.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- 3. Завершение варки и Анализ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="{loc:Loc Key=GROUP_COMPLETE_BATCH}" Margin="0,0,10,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=LABEL_ACTIVE_BATCH}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                        <ComboBox x:Name="ActiveBatchComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,8" Padding="5,4" SelectionChanged="ActiveBatchComboBox_SelectionChanged"/>

                        <TextBlock Text="{loc:Loc Key=LABEL_COMPLETE_BATCH_NAME}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                        <TextBox x:Name="CompleteBatchNameTextBox" Margin="0,0,0,8" Padding="5,4"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="{loc:Loc Key=LABEL_ACTUAL_OUTPUT}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="ActualOutputQuantityTextBox" Padding="5,4" TextChanged="CostInputs_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="{loc:Loc Key=LABEL_UNITS_COUNT}" Margin="0,0,0,3" FontSize="11" Foreground="#475569"/>
                                <TextBox x:Name="ActualUnitsCountTextBox" Text="1" Padding="5,4"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="UseOverheadCheckBox" Grid.Column="0" Content="{loc:Loc Key=CHECKBOX_OVERHEAD}" VerticalAlignment="Center" Margin="0,0,8,0" Click="CostInputs_Changed"/>
                            <TextBox x:Name="OverheadPercentageTextBox" Grid.Column="1" Text="15" Padding="5,4" IsEnabled="{Binding IsChecked, ElementName=UseOverheadCheckBox}" TextChanged="CostInputs_Changed"/>
                            <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#475569" FontWeight="Bold"/>
                        </Grid>

                        <Button x:Name="CompleteBatchButton" 
                                Content="{loc:Loc Key=BTN_COMPLETE_BATCH}" 
                                Click="CompleteBatch_Click" 
                                Height="32" 
                                HorizontalAlignment="Left"
                                Padding="15,0"
                                Background="#0284C7" 
                                Foreground="White" 
                                FontWeight="Bold"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="{loc:Loc Key=GROUP_BATCH_COSTING}" Padding="12" Background="#F8FAFC">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{loc:Loc Key=LABEL_RAW_COST}" Foreground="#475569" FontSize="11"/>
                            <TextBlock x:Name="RawMaterialCostTextBlock" Text="$0.00" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{loc:Loc Key=LABEL_OVERHEAD_COST}" Foreground="#475569" FontSize="11"/>
                            <TextBlock x:Name="OverheadCostTextBlock" Text="+$0.00 (0%)" HorizontalAlignment="Right" Foreground="#D97706" FontWeight="SemiBold"/>
                        </Grid>

                        <Separator Margin="0,4,0,8" Background="#CBD5E1"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{loc:Loc Key=LABEL_TOTAL_COST}" Foreground="#1E293B" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="TotalBatchCostTextBlock" Text="$0.00" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#059669" FontSize="14"/>
                        </Grid>

                        <Border Background="#E0F2FE" Padding="8" CornerRadius="4" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=LABEL_UNIT_COST}" Foreground="#0369A1" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="UnitCostTextBlock" Text="$0.00" FontSize="18" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>