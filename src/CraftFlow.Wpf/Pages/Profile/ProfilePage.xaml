<Page x:Class="CraftFlow.Wpf.Pages.Profile.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
      xmlns:auth="clr-namespace:CraftFlow.Wpf.MarkupExtensions"
      Title="{loc:Loc Key=UI_TITLE_PROFILE_PAGE}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource PageRootBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Key=UI_TITLE_PROFILE_PAGE}" Style="{StaticResource PageTitleTextStyle}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.45*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ==================== РЯД 1 ==================== -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Key=UI_HEADER_PROFILE_DATA}" Style="{StaticResource CardTitleTextStyle}"/>

                            <Grid Margin="{StaticResource FieldRowMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Key=UI_LABEL_NAME}" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBlock Grid.Column="1" x:Name="NameTextBlock" Text="-"/>
                            </Grid>

                            <Grid Margin="{StaticResource FieldRowMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Key=UI_LABEL_EMAIL}" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBlock Grid.Column="1" x:Name="EmailTextBlock" Text="-"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Key=UI_LABEL_SYSTEM_ROLE}" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBlock Grid.Column="1" x:Name="RoleTextBlock" Text="-" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="{StaticResource SectionTitleMargin}">
                                <TextBlock Text="{loc:Loc Key=UI_SUB_PROFILE_CARD_TITLE}" Style="{StaticResource CardTitleTextStyle}" Margin="0"/>
                                <Border HorizontalAlignment="Right" Style="{StaticResource PillBadgeBorderStyle}">
                                    <TextBlock x:Name="SubscriptionStatusBadge" Text="FREE" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Grid Margin="{StaticResource FieldRowMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Key=UI_SUB_PROFILE_ACTIVE_PLAN}" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBlock Grid.Column="1" x:Name="CurrentPlanTitleText" Text="{loc:Loc Key=UI_SUB_PROFILE_LOADING}" FontWeight="Bold" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc Key=UI_SUB_PROFILE_EXPIRES_AT}" Style="{StaticResource FieldLabelTextStyle}"/>
                                <TextBlock Grid.Column="1" x:Name="SubscriptionExpiresText" Text="-" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==================== РЯД 2 ==================== -->
                    <Border Grid.Row="1" Grid.Column="0"
                            x:Name="TeamManagementBorder"
                            Style="{StaticResource CardBorderStyle}"
                            Visibility="{auth:HasPermission Permission=USERS_MANAGE}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{loc:Loc Key=UI_HEADER_TEAM_MANAGEMENT}" Style="{StaticResource CardTitleTextStyle}"/>

                            <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,10,5">
                                    <TextBlock Text="{loc:Loc Key=UI_LABEL_FULL_NAME}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <TextBox x:Name="NewUserFullNameTextBox" Width="130"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,5">
                                    <TextBlock Text="{loc:Loc Key=UI_LABEL_EMAIL}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <TextBox x:Name="NewUserEmailTextBox" Width="130"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,5">
                                    <TextBlock Text="{loc:Loc Key=UI_LABEL_PASSWORD}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <PasswordBox x:Name="NewUserPasswordBox" Width="100"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,5">
                                    <TextBlock Text="{loc:Loc Key=UI_LABEL_ROLE}" Style="{StaticResource InputCaptionTextStyle}"/>
                                    <ComboBox x:Name="NewUserRoleComboBox" Width="120"/>
                                </StackPanel>

                                <Button Content="{loc:Loc Key=UI_BTN_ADD_EMPLOYEE}" Click="CreateTeamUser_Click" Style="{StaticResource PrimaryButtonStyle}" Height="{StaticResource ControlHeight}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                            </WrapPanel>

                            <TextBlock Grid.Row="2" Text="{loc:Loc Key=UI_HEADER_EMPLOYEES_LIST}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,2,0,8"/>

                            <DataGrid Grid.Row="3" x:Name="TeamUsersDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_FULL_NAME}" Binding="{Binding FullName}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_EMAIL}" Binding="{Binding Email}" Width="135"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_ROLE}" Binding="{Binding RoleDisplay}" Width="105"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_COL_STATUS}" Binding="{Binding StatusDisplay}" Width="75"/>

                                    <DataGridTemplateColumn Header="{loc:Loc Key=UI_COL_ACTIONS}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ActionButtonText}" 
                                                        Click="ToggleUserStatus_Click" 
                                                        Tag="{Binding Id}"
                                                        IsEnabled="{Binding CanToggle}"
                                                        Height="22" Padding="6,0" FontSize="10" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=UI_SUB_SHOWCASE_TITLE}" Style="{StaticResource CardTitleTextStyle}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Key=UI_SUB_SHOWCASE_SUBTITLE}" Style="{StaticResource CardSubtitleTextStyle}"/>

                            <ItemsControl x:Name="ModuleTabsControl" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="SelectModuleTab_Click"
                                                Tag="{Binding Module}"
                                                Background="{Binding TabBackground}"
                                                BorderBrush="{Binding TabBorder}"
                                                Foreground="{Binding TabForeground}"
                                                BorderThickness="1.5"
                                                Padding="12,6"
                                                Margin="0,0,8,6"
                                                Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{Binding StatusDotBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding ShortTitle}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource SubCardBorderStyle}" Padding="12,8" Margin="0,0,0,14">
                                <Grid>
                                    <TextBlock x:Name="SelectedModuleTitleText" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SelectedModuleStatusText" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="TierCardsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding CardBackground}"
                                                BorderBrush="{Binding CardBorder}"
                                                BorderThickness="1.5"
                                                CornerRadius="{StaticResource CardCornerRadius}"
                                                Padding="{StaticResource CompactCardPadding}"
                                                Margin="3,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid>
                                                        <TextBlock Text="{Binding TierTitle}" FontSize="14" FontWeight="Bold"/>
                                                        <Border Visibility="{Binding CurrentBadgeVisibility}" HorizontalAlignment="Right" Background="#16A34A" CornerRadius="4" Padding="5,1">
                                                            <TextBlock Text="{loc:Loc Key=UI_SUB_BADGE_CURRENT}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding BatchesText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding WarehousesText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding ChambersText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding UsersText}" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding AuditText}" FontSize="11" Margin="0,0,0,8"/>

                                                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,8" Opacity="0.6"/>

                                                    <TextBlock Text="{Binding PdfExportText}" FontSize="11" Foreground="{Binding PdfExportBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding ExcelExportText}" FontSize="11" Foreground="{Binding ExcelExportBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding AnalyticsText}" FontSize="11" Foreground="{Binding AnalyticsBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding MrpText}" FontSize="11" Foreground="{Binding MrpBrush}"/>
                                                </StackPanel>

                                                <Button Grid.Row="2"
                                                        Content="{Binding ActionButtonText}"
                                                        IsEnabled="{Binding IsActionEnabled}"
                                                        Click="TierCardAction_Click"
                                                        Tag="{Binding PlanCode}"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Height="{StaticResource ControlHeight}"
                                                        FontSize="11"
                                                        HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ==================== РЯД 3 ==================== -->
                    <Border Grid.Row="2" Grid.Column="0"
                            x:Name="DangerZoneBorder"
                            Style="{StaticResource DangerCardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{loc:Loc Key=UI_HEADER_DANGER_ZONE}" Style="{StaticResource CardTitleTextStyle}" Foreground="#DC2626" Margin="0,0,0,10"/>
                            <TextBlock Grid.Row="1" Text="{loc:Loc Key=UI_LABEL_EXIT_OPTIONS_INFO}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,6"/>

                            <StackPanel Grid.Row="2" Margin="5,0,0,12">
                                <TextBlock Text="{loc:Loc Key=UI_INFO_DEACTIVATION_OPTION}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="11"/>
                                <TextBlock Text="{loc:Loc Key=UI_INFO_DELETE_OPTION}" Foreground="#DC2626" TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>

                            <Button Grid.Row="3"
                                    Content="{loc:Loc Key=UI_BTN_MANAGE_EXIT}" 
                                    Click="DeleteAccount_Click" 
                                    Style="{StaticResource SolidDangerButtonStyle}"
                                    Height="{StaticResource ButtonHeight}" 
                                    HorizontalAlignment="Left" 
                                    Padding="16,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderLastStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{loc:Loc Key=UI_SUB_PAYMENTS_TITLE}" Style="{StaticResource CardTitleTextStyle}"/>

                            <DataGrid Grid.Row="1" x:Name="PaymentsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="140">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_SUB_PAYMENTS_COL_DATE}" Binding="{Binding CreatedAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_SUB_PAYMENTS_COL_PLAN}" Binding="{Binding PlanCode}" Width="130"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_SUB_PAYMENTS_COL_DAYS}" Binding="{Binding DaysAdded}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc Key=UI_SUB_PAYMENTS_COL_DESC}" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</Page>