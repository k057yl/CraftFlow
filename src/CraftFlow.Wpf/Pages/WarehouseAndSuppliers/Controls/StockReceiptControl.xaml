<UserControl x:Class="CraftFlow.Wpf.Pages.WarehouseAndSuppliers.Controls.StockReceiptControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization">

    <Grid Margin="0,16,0,0">
        <GroupBox Header="{loc:Loc Key=GROUP_CURRENT_STOCK}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель действий -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="{loc:Loc Key=GROUP_RECEIVE_STOCK_LOT}"
                            Click="OpenReceiveStockModal_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="{StaticResource ButtonHeight}"
                            Padding="16,0"/>

                    <Button Grid.Column="2"
                            Content="{loc:Loc Key=BTN_REFRESH}"
                            Click="RefreshStockLots_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="{StaticResource ButtonHeight}"
                            Padding="14,0"/>
                </Grid>

                <!-- Панель фильтров -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Key=LABEL_SUPPLIER_FILTER}" Style="{StaticResource InputCaptionTextStyle}"/>
                        <ComboBox x:Name="FilterSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterStockLots_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Loc Key=LABEL_WAREHOUSE_FILTER}" Style="{StaticResource InputCaptionTextStyle}"/>
                        <ComboBox x:Name="FilterWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="FilterStockLots_Changed"/>
                    </StackPanel>

                    <CheckBox Grid.Column="4"
                              x:Name="FilterExpiringCheckBox"
                              Content="{loc:Loc Key=CHECK_EXPIRING_SOON}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,6"
                              Click="FilterStockLots_Changed"/>
                </Grid>

                <!-- Таблица остатков с действием списания -->
                <DataGrid Grid.Row="2"
                          x:Name="StockLotsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=LABEL_RAW_MATERIAL}" Binding="{Binding ItemName}" Width="180"/>
                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_WAREHOUSE_NAME}" Binding="{Binding WarehouseName}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc Key=LABEL_STORAGE_CONTAINERS}" Binding="{Binding StorageLocationsInfo}" Width="*"/>
                        <DataGridTextColumn Header="{loc:Loc Key=LABEL_SUPPLIER_FILTER}" Binding="{Binding SupplierName}" Width="150"/>
                        <DataGridTextColumn Header="{loc:Loc Key=LABEL_REMAINING_STOCK}" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="110"/>
                        <DataGridTextColumn Header="{loc:Loc Key=UNIT_PRICE}" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="95"/>
                        <DataGridTextColumn Header="{loc:Loc Key=BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="130"/>
                        <DataGridTextColumn Header="Срок годности" Binding="{Binding ExpirationDate, StringFormat={}{0:dd.MM.yyyy}}" Width="115"/>

                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="OpenStockLotMenu_Click" Tag="{Binding}" Style="{StaticResource ActionButtonStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>