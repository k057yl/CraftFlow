<Window x:Class="CraftFlow.Wpf.Windows.ReceiveStockBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
        Title="{loc:Loc Key=GROUP_RECEIVE_STOCK_LOT}"
        Height="640"
        Width="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="860"
        MinHeight="540"
        Background="{DynamicResource CardBackgroundBrush}">

    <Border Padding="{StaticResource CardPadding}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <TextBlock Grid.Row="0"
                       Text="{loc:Loc Key=GROUP_RECEIVE_STOCK_LOT}"
                       Style="{StaticResource CardTitleTextStyle}"
                       Margin="0,0,0,16"/>

            <!-- 1. Шапка накладной -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc Key=LABEL_SELECT_SUPPLIER}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <ComboBox x:Name="StockSupplierComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{loc:Loc Key=SELECT_WAREHOUSE}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <ComboBox x:Name="StockWarehouseComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="StockWarehouseComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="№ Накладной / Партия по умолч." Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="InvoiceNumberTextBox" Text="INV-2026-001" MaxLength="80"/>
                </StackPanel>

                <Button Grid.Column="6"
                        Content="📥 Импорт Excel / PDF"
                        Click="ImportInvoiceFile_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="{StaticResource ControlHeight}"
                        Padding="14,0"
                        VerticalAlignment="Bottom"/>
            </Grid>

            <!-- 2. Блок быстрого ввода позиции -->
            <Border Grid.Row="2" Style="{StaticResource SubCardBorderStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Строка полей ввода -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" MinWidth="180"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Key=SELECT_RAW_MATERIAL}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <ComboBox x:Name="StockRawMaterialComboBox"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Name"
                                      SelectionChanged="StockRawMaterialComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Кол-во / Вес" Style="{StaticResource InputCaptionTextStyle}"/>
                            <TextBox x:Name="StockQuantityTextBox"
                                     FontWeight="Bold"
                                     TextChanged="StockQuantityTextBox_TextChanged"
                                     KeyDown="DraftInput_KeyDown"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{loc:Loc Key=UI_LABEL_UNIT_OF_MEASURE}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <ComboBox x:Name="UnitOfMeasureComboBox" SelectedIndex="0" SelectionChanged="UnitOfMeasureComboBox_SelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_L}" Tag="l"/>
                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_ML}" Tag="ml"/>
                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_KG}" Tag="kg"/>
                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_G}" Tag="g"/>
                                <ComboBoxItem Content="{loc:Loc Key=UI_UOM_PCS}" Tag="pcs"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{loc:Loc Key=UNIT_PRICE}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <TextBox x:Name="StockUnitPriceTextBox" KeyDown="DraftInput_KeyDown"/>
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <TextBlock Text="{loc:Loc Key=BATCH_NUMBER}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <TextBox x:Name="StockBatchTextBox" MaxLength="80" KeyDown="DraftInput_KeyDown"/>
                        </StackPanel>

                        <StackPanel Grid.Column="10">
                            <TextBlock Text="{loc:Loc Key=LABEL_EXPIRATION_DATE}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <DatePicker x:Name="ExpirationDatePicker" Height="{StaticResource ControlHeight}"/>
                        </StackPanel>

                        <Button Grid.Column="12"
                                x:Name="AddDraftLineButton"
                                Content="+ В список"
                                Click="AddDraftLine_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="{StaticResource ControlHeight}"
                                Padding="14,0"
                                VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Распределение по таре -->
                    <Expander Grid.Row="1"
                              Header="Распределить по ёмкостям / таре (опционально)"
                              Margin="0,10,0,0"
                              FontSize="11"
                              Foreground="{DynamicResource AppForegroundBrush}">
                        <StackPanel Margin="0,8,0,0">
                            <DockPanel Margin="0,0,0,6">
                                <Button Content="{loc:Loc Key=BTN_QUICK_NEW_LOCATION}"
                                        Click="QuickCreateLocation_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="11"
                                        HorizontalAlignment="Left"/>
                                <TextBlock x:Name="CapacityWarningTextBlock"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           FontWeight="SemiBold"
                                           FontSize="11"/>
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ListBox Grid.Column="0" x:Name="AvailableLocationsListBox" Height="82">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding FreeCapacity, StringFormat=[{0:N0}}" Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding Capacity, StringFormat= / {0:N0}]}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="+" Click="AddLocationToSelected_Click" Style="{StaticResource PrimaryButtonStyle}" Height="18" Padding="6,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ListBox Grid.Column="2" x:Name="SelectedLocationsListBox" Height="82">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding FreeCapacity, StringFormat=[{0:N0}}" Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding Capacity, StringFormat= / {0:N0}]}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="✕" Click="RemoveLocationFromSelected_Click" Style="{StaticResource DangerButtonStyle}" Width="18" Height="18" Padding="0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <!-- 3. Буферная таблица позиций накладной -->
            <Grid Grid.Row="3">
                <DataGrid x:Name="ReceiptDraftDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CellEditEnding="ReceiptDraftDataGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=LABEL_RAW_MATERIAL}" Binding="{Binding ItemName}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.####}}" Width="90"/>
                        <DataGridTextColumn Header="ЕИ" Binding="{Binding UnitOfMeasureDisplay}" IsReadOnly="True" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc Key=UNIT_PRICE}" Binding="{Binding UnitPrice, StringFormat={}{0:0.##}}" Width="90"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat={}{0:C2}}" IsReadOnly="True" Width="105"/>
                        <DataGridTextColumn Header="{loc:Loc Key=BATCH_NUMBER}" Binding="{Binding BatchNumber}" Width="125"/>
                        <DataGridTextColumn Header="Срок годности" Binding="{Binding ExpirationDate, StringFormat={}{0:dd.MM.yyyy}}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="Тара" Binding="{Binding StorageLocationsDisplay}" IsReadOnly="True" Width="*"/>
                        <DataGridTemplateColumn Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕"
                                            Click="RemoveDraftLine_Click"
                                            Tag="{Binding}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Width="22"
                                            Height="22"
                                            Padding="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Список прихода пуст — выберите сырьё, введите количество и нажмите «+ В список» (или Enter)"
                           FontSize="12"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,24,0,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=ReceiptDraftDataGrid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- 4. Итоги и отправка накладной -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="DraftSummaryTextBlock"
                           Text="Позиций в накладной: 0 | Итого: $0.00"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="13"
                           Foreground="{DynamicResource AppForegroundBrush}"/>

                <Button Grid.Column="1"
                        Content="Очистить список"
                        Click="ClearDraftLines_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="{StaticResource ButtonHeight}"
                        Padding="14,0"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="2"
                        Content="{loc:Loc Key=UI_BTN_CANCEL}"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="{StaticResource ButtonHeight}"
                        Padding="14,0"
                        Margin="0,0,8,0"/>

                <Button Grid.Column="3"
                        x:Name="SubmitReceiptBatchButton"
                        Content="✔ Оприходовать накладную"
                        Click="SubmitReceiptBatch_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="{StaticResource ButtonHeight}"
                        Padding="18,0"
                        IsEnabled="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>