<UserControl x:Class="CraftFlow.Wpf.Pages.WarehouseAndSuppliers.Controls.SuppliersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
             xmlns:converters="clr-namespace:CraftFlow.Wpf.Services.Converters"
             xmlns:auth="clr-namespace:CraftFlow.Wpf.MarkupExtensions">

    <UserControl.Resources>
        <converters:SupplierStatusTextConverter x:Key="SupplierStatusTextConverter"/>
        <converters:SupplierStatusStyleConverter x:Key="SupplierStatusStyleConverter"/>
    </UserControl.Resources>

    <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="{StaticResource ColumnGap}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- СЕКЦИЯ A: ФОРМА -->
        <GroupBox Grid.Column="0" x:Name="SupplierFormGroupBox" Header="{loc:Loc Key=HEADER_SUPPLIERS}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=SUPPLIER_NAME}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="NameTextBox" Margin="{StaticResource FieldRowMargin}"/>

                    <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_LEGAL_NAME}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="LegalNameTextBox" Margin="{StaticResource FieldRowMargin}"/>

                    <Grid Margin="{StaticResource FieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_TAX_ID}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <TextBox x:Name="TaxIdTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc Key=SUPPLIER_PHONE}" Style="{StaticResource InputCaptionTextStyle}"/>
                            <TextBox x:Name="PhoneTextBox"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Loc Key=SUPPLIER_EMAIL}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="EmailTextBox" Margin="{StaticResource FieldRowMargin}"/>

                    <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_ADDRESS}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="AddressTextBox" Margin="{StaticResource FieldRowMargin}"/>

                    <TextBlock Text="{loc:Loc Key=UI_SUPPLIER_NOTES}" Style="{StaticResource InputCaptionTextStyle}"/>
                    <TextBox x:Name="NotesTextBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveSupplierButton" 
                                Content="{loc:Loc Key=CREATE_SUPPLIER}" 
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="{StaticResource ButtonHeight}"
                                Padding="16,0"
                                Click="SaveSupplier_Click"/>

                        <Button x:Name="ResetFormButton" 
                                Content="{loc:Loc Key=UI_BTN_RESET}" 
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="{StaticResource ButtonHeight}"
                                Margin="8,0,0,0"
                                Padding="12,0"
                                Click="ResetSupplierForm_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- СЕКЦИЯ B: ТАБЛИЦА С ПОСТАВЩИКАМИ -->
        <GroupBox Grid.Column="2" Header="{loc:Loc Key=UI_HEADER_SUPPLIERS_REGISTRY}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <CheckBox Grid.Row="0"
                          x:Name="ShowInactiveSuppliersCheckBox" 
                          Content="{loc:Loc Key=UI_CHECK_SHOW_INACTIVE_SUPPLIERS}" 
                          Visibility="{auth:HasPermission Permission=SUPPLIERS_MANAGE}"
                          Margin="{StaticResource FieldRowMargin}" 
                          Click="ShowInactiveSuppliers_Click"/>

                <DataGrid Grid.Row="1"
                          x:Name="SuppliersDataGrid" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          CanUserAddRows="False"
                          MouseDoubleClick="SuppliersDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_NAME}" Binding="{Binding Name}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_LEGAL_NAME}" Binding="{Binding LegalName}" Width="120"/>
                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_TAX_ID}" Binding="{Binding TaxId}" Width="90"/>
                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_PHONE}" Binding="{Binding Phone}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_EMAIL}" Binding="{Binding Email}" Width="120"/>
                        <DataGridTextColumn Header="{loc:Loc Key=UI_COL_ADDRESS}" Binding="{Binding Address}" Width="*"/>

                        <DataGridTemplateColumn x:Name="SupplierActionsColumn" Header="{loc:Loc Key=LABEL_ACTION}" Width="170" Visibility="{auth:HasPermission Permission=SUPPLIERS_MANAGE}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✏️" 
                                                ToolTip="{loc:Loc Key=UI_TOOLTIP_EDIT}"
                                                Click="EditSupplierRow_Click" 
                                                Tag="{Binding}" 
                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                Height="24" Width="28" Padding="0" Margin="0,0,5,0"/>

                                        <Button Content="{Binding IsActive, Converter={StaticResource SupplierStatusTextConverter}}" 
                                                Click="ToggleSupplierActive_Click" 
                                                Tag="{Binding}" 
                                                Style="{Binding IsActive, Converter={StaticResource SupplierStatusStyleConverter}}" 
                                                Height="24" Padding="8,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>