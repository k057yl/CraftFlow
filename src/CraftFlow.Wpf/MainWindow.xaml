<Window x:Class="CraftFlow.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CraftFlow Management Console" Height="800" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation Menu -->
        <Border Grid.Column="0" Background="#1E293B" Padding="10">
            <StackPanel>
                <TextBlock Text="CRAFTFLOW" Foreground="White" FontSize="20" FontWeight="Bold" Margin="10,10,10,25" HorizontalAlignment="Center"/>

                <Button Content="📊 DASHBOARD" Click="NavDashboard_Click" Height="40" Margin="0,0,0,5" Background="#334155" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0,0,0"/>
                <Button Content="📦 CATALOG" Click="NavCatalog_Click" Height="40" Margin="0,0,0,5" Background="#334155" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0,0,0"/>
                <Button Content="🏭 INVENTORY" Click="NavInventory_Click" Height="40" Margin="0,0,0,5" Background="#334155" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0,0,0"/>
                <Button Content="🧀 PRODUCTION" Click="NavProduction_Click" Height="40" Margin="0,0,0,5" Background="#334155" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0,0,0"/>
                <Button Content="💰 SALES &amp; ORDERS" Click="NavSales_Click" Height="40" Margin="0,0,0,5" Background="#334155" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0,0,0"/>
                <Button Content="🔐 AUTH (JWT)" Click="NavAuth_Click" Height="40" Margin="0,20,0,5" Background="#475569" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0,0,0"/>
                <Button Content="📜 AUDIT LOGS" Click="NavAudit_Click" Height="40" Margin="0,0,0,5" Background="#334155" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="15,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Viewport -->
        <Grid Grid.Column="1" Background="#F1F5F9">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>