<Window x:Class="CraftFlow.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
        Title="CRAFTFLOW" Height="760" Width="1280" 
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CRAFTFLOW" Foreground="{DynamicResource AppForegroundBrush}" FontSize="20" FontWeight="Bold" Margin="0,10,0,25" HorizontalAlignment="Center"/>

                        <!-- ОСНОВНОЕ МЕНЮ СТРОГО ПО ЦЕПОЧКЕ ПРОЦЕССА -->
                        <StackPanel x:Name="MainMenuPanel" Visibility="Collapsed">
                            <Button x:Name="NavDashboardButton" Content="{loc:Loc Key=NAV_DASHBOARD}" Click="NavDashboard_Click" Style="{StaticResource NavButtonStyle}"/>
                            <Button x:Name="NavProductionSettingsButton" Content="{loc:Loc Key=NAV_PRODUCTION_SETTINGS}" Click="NavProductionSettings_Click" Style="{StaticResource NavButtonStyle}"/>
                            <Button x:Name="NavWarehouseAndSuppliersButton" Content="{loc:Loc Key=NAV_WAREHOUSE_AND_SUPPLIERS}" Click="NavWarehouseAndSuppliers_Click" Style="{StaticResource NavButtonStyle}"/>
                            <Button x:Name="NavMrpButton" Content="{loc:Loc Key=NAV_MRP}" Click="NavMrp_Click" Style="{StaticResource NavButtonStyle}"/>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,6,0,6" Opacity="0.6"/>

                            <!-- Цеха (активные + витрина неподключённых) -->
                            <Button x:Name="NavCheeseMakingButton" Click="NavCheeseMaking_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <TextBlock Text="{loc:Loc Key=NAV_CHEESE_MAKING}" VerticalAlignment="Center"/>
                                    <Border x:Name="BadgeCheese" Visibility="Collapsed" HorizontalAlignment="Right" Background="#E2E8F0" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Key=UI_SUB_BADGE_MODULE}" FontSize="9" Foreground="#475569" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Button x:Name="NavBreweryButton" Click="NavBrewery_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <TextBlock Text="{loc:Loc Key=NAV_BREWERY}" VerticalAlignment="Center"/>
                                    <Border x:Name="BadgeBrewery" Visibility="Collapsed" HorizontalAlignment="Right" Background="#E2E8F0" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Key=UI_SUB_BADGE_MODULE}" FontSize="9" Foreground="#475569" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Button x:Name="NavMeatProcessingButton" Click="NavMeatProcessing_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <TextBlock Text="{loc:Loc Key=NAV_MEAT_PROCESSING}" VerticalAlignment="Center"/>
                                    <Border x:Name="BadgeMeat" Visibility="Collapsed" HorizontalAlignment="Right" Background="#E2E8F0" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Key=UI_SUB_BADGE_MODULE}" FontSize="9" Foreground="#475569" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Button x:Name="NavFermentationButton" Click="NavFermentation_Click" Style="{StaticResource NavButtonStyle}" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <TextBlock Text="{loc:Loc Key=NAV_FERMENTATION}" VerticalAlignment="Center"/>
                                    <Border x:Name="BadgeFermentation" Visibility="Collapsed" HorizontalAlignment="Right" Background="#E2E8F0" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Key=UI_SUB_BADGE_MODULE}" FontSize="9" Foreground="#475569" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Button>

                            <Separator Background="{DynamicResource BorderBrush}" Margin="0,6,0,6" Opacity="0.6"/>

                            <Button x:Name="NavSalesButton" Content="{loc:Loc Key=NAV_SALES}" Click="NavSales_Click" Style="{StaticResource NavButtonStyle}"/>
                            <Button x:Name="NavTraceabilityButton" Content="{loc:Loc Key=NAV_TRACEABILITY}" Click="NavTraceability_Click" Style="{StaticResource NavButtonStyle}"/>
                            <Button x:Name="NavAuditButton" Content="{loc:Loc Key=NAV_AUDIT}" Click="NavAudit_Click" Style="{StaticResource NavButtonStyle}"/>
                        </StackPanel>

                        <Button x:Name="NavAdminButton" Content="{loc:Loc Key=NAV_ADMIN_KEYS}" Click="NavAdmin_Click" Style="{StaticResource NavButtonStyle}" Visibility="Collapsed" Margin="0,10,0,10"/>
                        <Button x:Name="NavAuthButton" Content="{loc:Loc Key=NAV_AUTH}" Click="NavAuth_Click" Style="{StaticResource NavButtonStyle}" Visibility="Visible"/>
                        <Button x:Name="NavProfileButton" Content="{loc:Loc Key=NAV_PROFILE}" Click="NavProfile_Click" Style="{StaticResource NavButtonStyle}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Плашка тарифа + Профиль пользователя -->
                <StackPanel Grid.Row="1" Margin="0,8,0,10">
                    <!-- Компактная карточка активного тарифа -->
                    <Border x:Name="SidebarPlanBorder"
                            Visibility="Collapsed"
                            Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,10"
                            Cursor="Hand"
                            MouseLeftButtonUp="SidebarPlan_Click"
                            ToolTip="{loc:Loc Key=UI_SUB_SIDEBAR_TOOLTIP}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{loc:Loc Key=UI_SUB_SIDEBAR_HEADER}" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="SidebarPlanBadgeText" Text="FREE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="SidebarPlanTitleText"
                                       Text="{loc:Loc Key=UI_SUB_PROFILE_LOADING}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppForegroundBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,2"/>
                            <TextBlock x:Name="SidebarPlanDetailsText"
                                       Text="{loc:Loc Key=UI_SUB_SIDEBAR_CLICK_HINT}"
                                       FontSize="10"
                                       Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

                    <StackPanel x:Name="UserProfilePanel" Visibility="Collapsed">
                        <TextBlock x:Name="UserNameTextBlock" Text="User" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="UserRoleTextBlock" Text="Role" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,8"/>
                        <Button Content="{loc:Loc Key=BTN_LOGOUT}" Click="Logout_Click" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel x:Name="GuestPanel" Visibility="Visible">
                        <TextBlock Text="{loc:Loc Key=GUEST_USER}" Foreground="{DynamicResource AppForegroundBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Переключатели темы и языка -->
                <StackPanel Grid.Row="2">
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_LANGUAGE}" Foreground="{DynamicResource AppForegroundBrush}" FontSize="10" Margin="0,0,0,3"/>
                            <ComboBox x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged" Height="26"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_THEME}" Foreground="{DynamicResource AppForegroundBrush}" FontSize="10" Margin="0,0,0,3"/>
                            <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" Height="26"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Рабочая область -->
        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>