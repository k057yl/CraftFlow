<Window x:Class="CraftFlow.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CraftFlow Catalog Control Panel" Height="700" Width="650">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <!-- 1. Единицы измерения -->
            <GroupBox Header="1. Единицы Измерения" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Название:"/>
                            <TextBox x:Name="UomNameTextBox" Text="Литр"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Код:"/>
                            <TextBox x:Name="UomCodeTextBox" Text="l"/>
                        </StackPanel>
                    </Grid>
                    <Button Content="Создать ЕИ" Click="CreateUom_Click" Margin="0,8,0,0" Height="25"/>
                </StackPanel>
            </GroupBox>

            <!-- 2. Сырье -->
            <GroupBox Header="2. Сырье" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="Название Сырья:"/>
                    <TextBox x:Name="RawMaterialNameTextBox" Text="Молоко фермерское 3.6%" Margin="0,0,0,5"/>
                    <TextBlock Text="Единица Измерения:"/>
                    <ComboBox x:Name="RawUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <Button Content="Создать Сырье" Click="CreateRawMaterial_Click" Height="25"/>
                </StackPanel>
            </GroupBox>

            <!-- 3. Продукция -->
            <GroupBox Header="3. Готовая Продукция" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="Название Продукта:"/>
                    <TextBox x:Name="ProductNameTextBox" Text="Сыр Гауда 45%" Margin="0,0,0,5"/>
                    <TextBlock Text="Единица Измерения:"/>
                    <ComboBox x:Name="ProductUomComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <Button Content="Создать Продукт" Click="CreateProduct_Click" Height="25"/>
                </StackPanel>
            </GroupBox>

            <!-- 4. Рецепт -->
            <GroupBox Header="4. Создать Рецепт" Margin="0,0,0,10" Padding="8">
                <StackPanel>
                    <TextBlock Text="Название Рецепта:"/>
                    <TextBox x:Name="RecipeNameTextBox" Text="Рецепт классической Гауды" Margin="0,0,0,5"/>
                    <TextBlock Text="Для какого продукта:"/>
                    <ComboBox x:Name="RecipeProductComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                    <TextBlock Text="Выход готового продукта (кол-во):"/>
                    <TextBox x:Name="RecipeOutputQuantityTextBox" Text="10" Margin="0,0,0,5"/>

                    <Border BorderBrush="Gray" BorderThickness="1" Padding="5" Margin="0,5,0,5">
                        <StackPanel>
                            <TextBlock Text="Ингредиент:" FontWeight="Bold"/>
                            <TextBlock Text="Сырье:"/>
                            <ComboBox x:Name="RecipeRawMaterialComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,5"/>
                            <TextBlock Text="Количество:"/>
                            <TextBox x:Name="RecipeIngredientQuantityTextBox" Text="100" Margin="0,0,0,5"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Создать Рецепт" Click="CreateRecipe_Click" Height="25"/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="StatusTextBlock" Text="Готов к работе." Foreground="Blue" FontWeight="Bold" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>