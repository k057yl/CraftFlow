<Window x:Class="CraftFlow.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CraftFlow.Wpf.Localization"
        Title="CRAFTFLOW" Height="760" Width="1280" 
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CRAFTFLOW" Foreground="{DynamicResource AppForegroundBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center"/>

                        <Button Content="{loc:Loc Key=NAV_DIRECTORY}" Click="NavDirectory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{loc:Loc Key=NAV_INVENTORY}" Click="NavInventory_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{loc:Loc Key=NAV_PROCUREMENT}" Click="NavProcurement_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{loc:Loc Key=NAV_PRODUCTION}" Click="NavProduction_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{loc:Loc Key=NAV_SALES}" Click="NavSales_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{loc:Loc Key=NAV_TRACEABILITY}" Click="NavTraceability_Click" Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="{loc:Loc Key=NAV_MRP}" Click="NavMrp_Click" Style="{StaticResource NavButtonStyle}"/>
                        
                        <Button x:Name="NavAdminKeysButton" Content="{loc:Loc Key=NAV_ADMIN_KEYS}" Click="NavAdminKeys_Click" Style="{StaticResource NavButtonStyle}" Visibility="Collapsed" Margin="0,0,0,20"/>

                        <!-- Динамические кнопки Авторизация / Профиль -->
                        <Button x:Name="NavAuthButton" Content="{loc:Loc Key=NAV_AUTH}" Click="NavAuth_Click" Style="{StaticResource NavButtonStyle}" Visibility="Visible"/>
                        <Button x:Name="NavProfileButton" Content="Профиль и Аккаунт" Click="NavProfile_Click" Style="{StaticResource NavButtonStyle}" Visibility="Collapsed"/>

                        <Button Content="{loc:Loc Key=NAV_AUDIT}" Click="NavAudit_Click" Style="{StaticResource NavButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Левый нижний блок сайдбара -->
                <StackPanel Grid.Row="1" Margin="0,10,0,10">
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>

                    <StackPanel x:Name="UserProfilePanel" Visibility="Collapsed">
                        <TextBlock x:Name="UserNameTextBlock" Text="User" Foreground="{DynamicResource AppForegroundBrush}" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="UserRoleTextBlock" Text="Role" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,6"/>
                        <Button Content="Выйти" Click="Logout_Click" Height="24" FontSize="10"/>
                    </StackPanel>

                    <StackPanel x:Name="GuestPanel" Visibility="Visible">
                        <TextBlock Text="Гость (не авторизован)" Foreground="{DynamicResource AppForegroundBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Настройки темы и языка -->
                <StackPanel Grid.Row="2" Margin="0,0,0,0">
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_LANGUAGE}" Foreground="{DynamicResource AppForegroundBrush}" FontSize="10" Margin="0,0,0,3"/>
                            <ComboBox x:Name="LanguageComboBox" SelectionChanged="LanguageComboBox_SelectionChanged" Height="26"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="{loc:Loc Key=LABEL_THEME}" Foreground="{DynamicResource AppForegroundBrush}" FontSize="10" Margin="0,0,0,3"/>
                            <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged" Height="26"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>