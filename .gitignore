*.dyn

# Environment & Local Secrets (Локальные конфигурации и пароли)
appsettings.Secrets.json
appsettings.Local.json
appsettings.Development.json
.env
.env.*
!.env.example

# Windows & OS system temp files (Мусор ОС)
